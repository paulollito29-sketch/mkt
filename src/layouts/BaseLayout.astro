---
import '../styles/global.css';
import MindFixChatbot from '../components/MindFixChatbot.astro';
import SignupModal from '../components/SignupModal.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string[];
  articleDate?: Date;
  author?: string;
  image?: string;
}

const {
  title,
  description,
  keywords = [],
  articleDate,
  author = "MindFix",
  image = "/images/hero-valeria-mindfix.webp",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://mindfix-edtech.vercel.app");
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | MindFix Blog</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleDate ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="MindFix" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Lora:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD for SEO & GEO -->
    {articleDate && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "EducationalArticle",
        "headline": title,
        "description": description,
        "author": {
          "@type": "Organization",
          "name": author,
          "url": "https://mindfix-edtech.vercel.app"
        },
        "publisher": {
          "@type": "Organization",
          "name": "MindFix",
          "logo": {
            "@type": "ImageObject",
            "url": "https://mindfix-edtech.vercel.app/favicon.svg"
          }
        },
        "datePublished": articleDate.toISOString(),
        "dateModified": new Date().toISOString(),
        "mainEntityOfPage": canonicalURL.toString(),
        "keywords": keywords.join(", ")
      })} />
    )}

    <style is:global>
      :root {
        --color-bg: #F8FAFC;
        --color-surface: #FFFFFF;
        --color-surface-hover: #F1F5F9;
        --color-border: #E2E8F0;
        --color-text-main: #1E293B;
        --color-text-heading: #0B2545;
        --color-text-muted: #64748B;
        --color-primary: #0077FE;
        --color-primary-hover: #00A3FF;
        --color-accent: #0077FE;
        --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        --font-serif: 'Lora', Georgia, serif;
      }

      @layer base {
        * {
          box-sizing: border-box;
          margin: 0;
          padding: 0;
        }
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--color-bg);
        color: var(--color-text-main);
        line-height: 1.75;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: var(--color-accent);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      .container {
        max-width: 920px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      header.site-header {
        border-bottom: 1px solid var(--color-border);
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(12px);
        position: sticky;
        top: 0;
        z-index: 50;
      }

      .nav-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 76px;
      }

      .brand {
        display: flex;
        flex-direction: column;
        text-decoration: none;
      }

      .brand-wordmark {
        font-weight: 800;
        font-size: 1.5rem;
        line-height: 1;
        letter-spacing: -0.02em;
      }

      .brand-slogan {
        font-size: 0.68rem;
        font-weight: 600;
        color: #64748B;
        margin-top: 0.15rem;
      }

      .brand:hover {
        text-decoration: none;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .nav-link {
        color: #0B2545;
        font-size: 0.95rem;
        font-weight: 600;
        transition: color 0.2s;
      }

      .nav-link:hover {
        color: #0077FE;
        text-decoration: none;
      }

      .btn-header {
        background: linear-gradient(90deg, #0077FE 0%, #00C2FF 100%);
        color: #fff !important;
        font-size: 0.88rem;
        font-weight: 700;
        padding: 0.6rem 1.25rem;
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0, 119, 254, 0.28);
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .btn-header:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 24px rgba(0, 194, 255, 0.45);
        text-decoration: none;
      }

      footer.site-footer {
        border-top: 1px solid var(--color-border);
        padding: 3rem 0;
        margin-top: 5rem;
        background: #FFFFFF;
        text-align: center;
        color: var(--color-text-muted);
        font-size: 0.9rem;
      }

      /* Prose / Article styling (Light Mode) */
      .prose {
        color: #334155;
        font-size: 1.12rem;
        line-height: 1.85;
      }

      .prose h1, .prose h2, .prose h3, .prose h4 {
        color: #0B2545;
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-top: 2.5rem;
        margin-bottom: 1rem;
      }

      .prose h2 {
        font-size: 1.75rem;
        border-bottom: 2px solid #E2E8F0;
        padding-bottom: 0.5rem;
      }

      .prose h3 {
        font-size: 1.35rem;
        color: #0077FE;
      }

      .prose p {
        margin-bottom: 1.4rem;
      }

      .prose strong {
        color: #0B2545;
        font-weight: 700;
      }

      .prose img {
        max-width: 100%;
        height: auto;
        border-radius: 16px;
        margin: 2rem 0;
        border: 1px solid #E2E8F0;
        box-shadow: 0 12px 32px -8px rgba(11, 37, 69, 0.12);
      }

      .prose blockquote {
        border-left: 4px solid #0077FE;
        background: #F1F5F9;
        padding: 1.25rem 1.5rem;
        border-radius: 0 14px 14px 0;
        margin: 2rem 0;
        color: #0B2545;
        font-style: italic;
      }

      .prose ul, .prose ol {
        margin: 1.2rem 0 1.5rem 1.5rem;
      }

      .prose li {
        margin-bottom: 0.5rem;
        color: #334155;
      }

      .prose table {
        width: 100%;
        border-collapse: collapse;
        margin: 2rem 0;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #E2E8F0;
        background: #FFFFFF;
        box-shadow: 0 4px 16px rgba(11, 37, 69, 0.05);
      }

      .prose th, .prose td {
        padding: 1rem 1.2rem;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
        color: #334155;
      }

      .prose th {
        background: #F1F5F9;
        color: #0B2545;
        font-weight: 800;
      }

      .prose tr:hover td {
        background: #F8FAFC;
      }

      .prose pre {
        background: #0B2545;
        border: 1px solid #1E293B;
        padding: 1.25rem;
        border-radius: 14px;
        overflow-x: auto;
        margin: 1.8rem 0;
        font-size: 0.95rem;
        color: #F8FAFC;
      }

      .prose code {
        background: rgba(0, 119, 254, 0.1);
        color: #0077FE;
        padding: 0.2rem 0.45rem;
        border-radius: 6px;
        font-size: 0.92em;
        font-weight: 600;
      }

      .prose pre code {
        background: none;
        padding: 0;
        color: #38BDF8;
      }

      .prose hr {
        border: none;
        border-top: 1px solid #E2E8F0;
        margin: 3rem 0;
      }

      .checklist-card {
        background: #FFFFFF;
        border: 1px solid #E2E8F0;
        border-radius: 16px;
        padding: 1.75rem;
        margin: 2rem 0;
        box-shadow: 0 10px 25px -5px rgba(11, 37, 69, 0.06);
      }

      .checklist-item {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #F1F5F9;
      }

      .checklist-item:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
      }

      .checklist-checkbox {
        margin-top: 0.35rem;
        width: 18px;
        height: 18px;
        accent-color: #0077FE;
        flex-shrink: 0;
      }

      .cta-container {
        margin: 3.5rem 0 2rem;
        padding: 2.75rem 2rem;
        background: linear-gradient(135deg, #0B2545 0%, #0E1B2E 100%);
        border: 1px solid rgba(0, 194, 255, 0.3);
        border-radius: 22px;
        text-align: center;
        color: #FFFFFF;
        box-shadow: 0 18px 40px -10px rgba(11, 37, 69, 0.25);
      }

      .cta-title {
        color: #FFFFFF !important;
        font-size: 1.8rem;
        font-weight: 800;
        margin-top: 0 !important;
        margin-bottom: 0.75rem !important;
      }

      .cta-desc {
        color: #E2E8F0 !important;
        max-width: 600px;
        margin: 0 auto 1.5rem !important;
      }

      .cta-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: linear-gradient(90deg, #0077FE 0%, #00C2FF 100%);
        color: #FFFFFF !important;
        font-weight: 800;
        padding: 0.95rem 2rem;
        border-radius: 14px;
        box-shadow: 0 10px 25px rgba(0, 119, 254, 0.4);
        text-decoration: none !important;
      }

      .cta-guarantee {
        color: #94A3B8 !important;
        font-size: 0.85rem;
        margin-top: 1rem !important;
        margin-bottom: 0 !important;
      }

      .article-hashtags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-top: 2.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #E2E8F0;
      }

      .hashtag-pill {
        background: rgba(0, 119, 254, 0.08);
        border: 1px solid rgba(0, 119, 254, 0.2);
        color: #0077FE;
        padding: 0.35rem 0.8rem;
        border-radius: 9999px;
        font-size: 0.85rem;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-bar">
        <a href="/" class="brand">
          <div class="brand-wordmark">
            <span style="color: #0B2545;">MIND</span><span style="color: #0077FE;">FIX</span>
          </div>
          <span class="brand-slogan">Estudia mejor, llega más lejos</span>
        </a>
        <nav class="nav-links">
          <a href="/" class="nav-link">Inicio</a>
          <a href="/blog" class="nav-link">Blog & Neurociencia</a>
          <a href="/test-diagnostico" class="btn-header">Realizar Test Gratuito</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p style="color: #0B2545;"><strong>MindFix EdTech</strong> — Estudia mejor, llega más lejos.</p>
        <p style="margin-top: 0.4rem; font-size: 0.82rem; color: #64748B;">
          Ecosistema educativo P2P con Inteligencia Artificial para universitarios.
        </p>
      </div>
    </footer>

    <SignupModal />
    <MindFixChatbot context="blog" />
  </body>
</html>
