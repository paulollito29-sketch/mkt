---
interface Props {
  content?: {
    title?: string;
    description?: string;
    pubDate?: Date | string;
    author?: string;
    keywords?: string | string[];
    primaryKeyword?: string;
    secondaryKeywords?: string[];
    heroImage?: string;
    readTime?: string;
    readingTime?: string;
    category?: string;
    tags?: string[];
  };
}

const { content } = Astro.props;

const title = content?.title || "¿Saqué 08 y no sé en qué fallé?: Guía práctica para auditar tus errores de examen y no repetirlos";
const description = content?.description || "Aprende a auditar tus exámenes universitarios paso a paso. Descubre cómo identificar vacíos de conocimiento, clasificar errores conceptuales vs. de procedimiento y recuperar el control académico.";

const rawDate = content?.pubDate || new Date("2026-10-31");
const pubDateStr = rawDate instanceof Date ? rawDate.toISOString().split('T')[0] : String(rawDate);
const displayDate = rawDate instanceof Date ? rawDate.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }) : "Octubre 2026";

const author = content?.author || "Equipo Pedagógico & Mentoría MindFix";
const readTime = content?.readingTime || content?.readTime || "9 min de lectura";
const category = content?.category || "Metodología de Aprendizaje & Rendimiento";

// Format keywords
let formattedKeywords = "retroalimentacion de examenes universitarios, cómo saber en qué me equivoqué en un examen, qué hacer si desaprobé y el profesor no da feedback, cómo identificar vacíos de conocimiento tras un examen";
if (content?.keywords) {
  formattedKeywords = Array.isArray(content.keywords) ? content.keywords.join(', ') : content.keywords;
} else if (content?.primaryKeyword) {
  formattedKeywords = [content.primaryKeyword, ...(content.secondaryKeywords || [])].join(', ');
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || "https://mindfix-edtech.vercel.app").href;

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "datePublished": pubDateStr,
      "dateModified": pubDateStr,
      "author": {
        "@type": "Organization",
        "name": author,
        "url": "https://mindfix-edtech.vercel.app"
      },
      "publisher": {
        "@type": "Organization",
        "name": "MindFix",
        "logo": {
          "@type": "ImageObject",
          "url": "https://mindfix-edtech.vercel.app/logo.png"
        }
      },
      "keywords": formattedKeywords,
      "inLanguage": "es-PE",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonicalUrl
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Por qué un 08 en un examen universitario no refleja tu inteligencia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Una calificación numérica es un indicador sumativo unidimensional que mide un desempeño puntual bajo presión de tiempo, no tu capacidad intelectual. No discrimina si fallaste por un vacío conceptual de base, un error de procedimiento operativo o falta de gestión del tiempo."
          }
        },
        {
          "@type": "Question",
          "name": "¿Qué hacer si desaprobé y el profesor no da feedback detallado?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Aplica una auditoría post-examen autónoma: solicita la pauta o rúbrica de resolución, transcribe cada pregunta fallida, clasifica el error en los 4 cuadrantes (conceptual, procedimental, atencional o de transferencia) y reconstruye tu árbol de prerrequisitos antes de volver a repasar."
          }
        },
        {
          "@type": "Question",
          "name": "¿Cómo saber en qué me equivoqué en un examen?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Contrasta tu hoja de respuestas contra el solucionario oficial descomponiendo el desarrollo en tres fases: interpretación de la premisa, selección de la fórmula o teoría, y ejecución mecánica. El punto exacto donde divergió tu respuesta revela el tipo de brecha."
          }
        }
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | MindFix Blog</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={formattedKeywords} />
  <meta name="author" content={author} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="MindFix - Diagnóstico Inteligente de Aprendizaje" />
  <meta property="article:published_time" content={pubDateStr} />
  <meta property="article:section" content={category} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Structured Data JSON-LD (SEO & GEO) -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style is:global>
    :root {
      --font-heading: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;

      --color-primary: #4F46E5;
      --color-primary-light: #6366F1;
      --color-accent: #06B6D4;
      --color-accent-warm: #F59E0B;
      --color-success: #10B981;

      --bg-page: #0B0F19;
      --bg-surface: #111827;
      --bg-surface-elevated: #1F2937;

      --border-subtle: #1F2937;
      --border-card: rgba(255, 255, 255, 0.08);

      --text-main: #F3F4F6;
      --text-muted: #9CA3AF;
      --text-heading: #FFFFFF;
      --text-soft: #D1D5DB;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: var(--font-body);
      font-size: 1.125rem;
      line-height: 1.8;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    .bg-glow {
      position: fixed;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 100vw;
      height: 600px;
      background: radial-gradient(circle 800px at 50% -100px, rgba(79, 70, 229, 0.18), rgba(6, 182, 212, 0.05), transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    .site-nav {
      position: sticky;
      top: 0;
      background: rgba(11, 15, 25, 0.85);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
      z-index: 50;
      padding: 1rem 1.5rem;
    }

    .nav-container {
      max-width: 900px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: #fff;
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 1.25rem;
      letter-spacing: -0.02em;
    }

    .brand-badge {
      background: linear-gradient(135deg, #4F46E5, #06B6D4);
      color: white;
      padding: 0.25rem 0.5rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .nav-cta-btn {
      background: linear-gradient(135deg, #4F46E5, #6366F1);
      color: #ffffff;
      padding: 0.55rem 1.1rem;
      border-radius: 8px;
      text-decoration: none;
      font-size: 0.875rem;
      font-weight: 600;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(79, 70, 229, 0.3);
    }

    .nav-cta-btn:hover {
      background: linear-gradient(135deg, #4338CA, #4F46E5);
      transform: translateY(-1px);
    }

    .article-wrapper {
      position: relative;
      z-index: 1;
      max-width: 820px;
      margin: 2.5rem auto 5rem;
      padding: 0 1.5rem;
    }

    .breadcrumbs {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-bottom: 1.5rem;
    }

    .breadcrumbs a {
      color: var(--color-accent);
      text-decoration: none;
    }

    .breadcrumbs a:hover {
      text-decoration: underline;
    }

    .article-header {
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--border-card);
      padding-bottom: 2rem;
    }

    .article-category-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.35rem 0.85rem;
      background: rgba(99, 102, 241, 0.12);
      border: 1px solid rgba(99, 102, 241, 0.3);
      color: #A5B4FC;
      border-radius: 9999px;
      font-size: 0.8125rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 1.25rem;
    }

    .article-title {
      font-family: var(--font-heading);
      font-size: clamp(2rem, 4vw, 2.75rem);
      font-weight: 800;
      line-height: 1.2;
      color: var(--text-heading);
      letter-spacing: -0.03em;
      margin-bottom: 1.25rem;
    }

    .article-subtitle {
      font-size: 1.25rem;
      line-height: 1.6;
      color: var(--text-soft);
      margin-bottom: 1.75rem;
    }

    .article-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.25rem;
      font-size: 0.875rem;
      color: var(--text-muted);
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .meta-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, #4F46E5, #06B6D4);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 0.875rem;
    }

    /* Image styling in Prose */
    .prose img {
      width: 100%;
      height: auto;
      border-radius: 14px;
      margin: 2.25rem 0 1rem;
      border: 1px solid var(--border-card);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
      display: block;
    }

    .prose figure {
      margin: 2.5rem 0;
    }

    .prose figure figcaption {
      text-align: center;
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-top: 0.75rem;
      font-style: italic;
    }

    /* Content Typography */
    .prose {
      color: var(--text-main);
      font-size: 1.125rem;
      line-height: 1.85;
    }

    .prose p {
      margin-bottom: 1.6rem;
    }

    .prose h2 {
      font-family: var(--font-heading);
      font-size: 1.85rem;
      font-weight: 700;
      color: var(--text-heading);
      letter-spacing: -0.02em;
      margin-top: 3rem;
      margin-bottom: 1.25rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    }

    .prose h3 {
      font-family: var(--font-heading);
      font-size: 1.4rem;
      font-weight: 600;
      color: #E0E7FF;
      letter-spacing: -0.01em;
      margin-top: 2.25rem;
      margin-bottom: 1rem;
    }

    .prose strong {
      color: #FFFFFF;
      font-weight: 600;
    }

    .prose ul, .prose ol {
      margin-bottom: 1.75rem;
      padding-left: 1.6rem;
    }

    .prose li {
      margin-bottom: 0.65rem;
      color: var(--text-soft);
    }

    .prose blockquote {
      border-left: 4px solid var(--color-primary-light);
      background: rgba(31, 41, 55, 0.4);
      padding: 1.25rem 1.5rem;
      border-radius: 0 12px 12px 0;
      margin: 2rem 0;
      color: #E2E8F0;
      font-style: italic;
    }

    .prose blockquote p:last-child {
      margin-bottom: 0;
    }

    .prose table {
      width: 100%;
      border-collapse: collapse;
      margin: 2rem 0;
      background: var(--bg-surface);
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--border-card);
      font-size: 1rem;
    }

    .prose th {
      background: rgba(79, 70, 229, 0.15);
      color: #E0E7FF;
      font-family: var(--font-heading);
      font-weight: 700;
      text-align: left;
      padding: 1rem 1.25rem;
      border-bottom: 2px solid rgba(79, 70, 229, 0.3);
    }

    .prose td {
      padding: 0.9rem 1.25rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      color: var(--text-soft);
      vertical-align: top;
    }

    .prose tr:last-child td {
      border-bottom: none;
    }

    .prose tr:hover td {
      background: rgba(255, 255, 255, 0.02);
    }

    .prose pre {
      background: #030712;
      border: 1px solid #1F2937;
      padding: 1.25rem;
      border-radius: 12px;
      overflow-x: auto;
      margin: 1.75rem 0;
      font-family: var(--font-mono);
      font-size: 0.95rem;
      color: #38BDF8;
    }

    .prose code {
      background: rgba(99, 102, 241, 0.15);
      color: #A5B4FC;
      padding: 0.2rem 0.4rem;
      border-radius: 4px;
      font-size: 0.92em;
      font-family: var(--font-mono);
    }

    .prose pre code {
      background: none;
      padding: 0;
      color: inherit;
    }

    .checklist-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-card);
      border-radius: 14px;
      padding: 1.75rem;
      margin: 2rem 0;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
    }

    .checklist-item {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }

    .checklist-item:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }

    .checklist-checkbox {
      margin-top: 0.35rem;
      width: 18px;
      height: 18px;
      accent-color: var(--color-primary);
      flex-shrink: 0;
    }

    .cta-container {
      margin: 3.5rem 0 2rem;
      padding: 2.75rem 2rem;
      background: linear-gradient(145deg, rgba(31, 41, 55, 0.9), rgba(17, 24, 39, 0.95));
      border: 1px solid rgba(99, 102, 241, 0.35);
      border-radius: 20px;
      text-align: center;
      position: relative;
      overflow: hidden;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35), 0 0 40px rgba(79, 70, 229, 0.15);
    }

    .cta-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #4F46E5, #06B6D4, #10B981);
    }

    .cta-title {
      font-family: var(--font-heading);
      font-size: 1.85rem;
      font-weight: 800;
      color: #FFFFFF;
      margin-bottom: 1rem;
      letter-spacing: -0.02em;
    }

    .cta-desc {
      font-size: 1.125rem;
      color: #D1D5DB;
      max-width: 600px;
      margin: 0 auto 1.75rem;
      line-height: 1.6;
    }

    .cta-btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
      color: #FFFFFF;
      padding: 1rem 2.25rem;
      border-radius: 12px;
      font-size: 1.05rem;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.25s ease;
      box-shadow: 0 8px 24px rgba(79, 70, 229, 0.4);
    }

    .cta-btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(6, 182, 212, 0.5);
    }

    .cta-guarantee {
      margin-top: 1rem;
      font-size: 0.85rem;
      color: var(--text-muted);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
    }

    .article-hashtags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--border-card);
    }

    .hashtag-pill {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: #A5B4FC;
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      font-size: 0.85rem;
      font-weight: 500;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .author-card {
      display: flex;
      gap: 1.25rem;
      align-items: center;
      background: var(--bg-surface);
      border: 1px solid var(--border-card);
      border-radius: 14px;
      padding: 1.5rem;
      margin: 3rem 0;
    }

    .author-card-avatar {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: linear-gradient(135deg, #4F46E5, #06B6D4);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #FFFFFF;
      font-weight: 800;
      font-size: 1.35rem;
      flex-shrink: 0;
    }

    .author-card-info h4 {
      font-family: var(--font-heading);
      color: #FFFFFF;
      font-size: 1.05rem;
      margin-bottom: 0.25rem;
    }

    .author-card-info p {
      font-size: 0.875rem;
      color: var(--text-muted);
      margin-bottom: 0;
      line-height: 1.5;
    }

    .site-footer {
      border-top: 1px solid var(--border-subtle);
      background: rgba(11, 15, 25, 0.95);
      padding: 3rem 1.5rem;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    .footer-links {
      display: flex;
      justify-content: center;
      gap: 1.5rem;
      margin-bottom: 1rem;
    }

    .footer-links a {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s ease;
    }

    .footer-links a:hover {
      color: #FFFFFF;
    }
  </style>
</head>
<body>
  <div class="bg-glow"></div>

  <nav class="site-nav">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <span>MindFix</span>
        <span class="brand-badge">EdTech AI</span>
      </a>
      <a href="https://mindfix.app" target="_blank" rel="noopener noreferrer" class="nav-cta-btn">
        Hacer Test Diagnóstico Gratuito →
      </a>
    </div>
  </nav>

  <main class="article-wrapper">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Inicio</a>
      <span>/</span>
      <a href="/blog">Blog</a>
      <span>/</span>
      <span>Auditoría de Exámenes</span>
    </nav>

    <header class="article-header">
      <span class="article-category-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        {category}
      </span>
      <h1 class="article-title">{title}</h1>
      <p class="article-subtitle">{description}</p>

      <div class="article-meta">
        <div class="meta-item">
          <div class="meta-avatar">M</div>
          <span><strong>{author}</strong></span>
        </div>
        <div class="meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <span>{readTime}</span>
        </div>
        <div class="meta-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>{displayDate}</span>
        </div>
      </div>
    </header>

    <article class="prose">
      <slot />
    </article>

    <div class="author-card">
      <div class="author-card-avatar">MF</div>
      <div class="author-card-info">
        <h4>Equipo de Mentoría Pedagógica MindFix</h4>
        <p>Acompañamos a estudiantes universitarios de alto rendimiento y en recuperación académica mediante algoritmos diagnósticos de IA que transforman notas opacas en rutas de estudio personalizadas y sin estrés.</p>
      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="footer-links">
      <a href="/">Inicio</a>
      <a href="/blog">Blog</a>
      <a href="https://mindfix.app">Plataforma Oficial</a>
      <a href="https://mindfix.app/test-diagnostico">Test Diagnóstico</a>
    </div>
    <p>© 2026 MindFix EdTech. Transformando la retroalimentación universitaria con Inteligencia Artificial.</p>
  </footer>
</body>
</html>
