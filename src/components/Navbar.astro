---
interface Props {
  active?: string;
}
const { active = '' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Inicio', id: 'inicio' },
  { href: '/blog', label: 'Blog', id: 'blog' },
  { href: '/guia-gratuita', label: 'Lead Magnet', id: 'guia' },
  { href: '/webinar', label: 'Webinar', id: 'webinar' },
  { href: '/test-diagnostico', label: 'Test IA', id: 'test' },
  { href: '/ugc', label: 'UGC', id: 'ugc' },
  { href: '/planes', label: 'Planes', id: 'planes' },
  { href: '/planes-app', label: '📱 Landing App', id: 'planes-app' },
  { href: '/upgrade', label: 'Upgrade -50%', id: 'upgrade' },
  { href: '/prueba-gratuita', label: 'Prueba Gratis', id: 'trial' },
];
---

<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-xl border-b border-slate-200/80 shadow-xs">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 h-16 flex items-center justify-between gap-3">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2 shrink-0 group">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-[#0077FE] to-[#6D4AFF] text-white flex items-center justify-center shadow-sm">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5C9.5 4.5 7.5 6.3 7.2 8.7C5.4 9.2 4 10.9 4 13c0 2.3 1.7 4.2 3.9 4.5.5 1.7 2.1 3 4.1 3V4.5z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5c2.5 0 4.5 1.8 4.8 4.2 1.8.5 3.2 2.2 3.2 4.3 0 2.3-1.7 4.2-3.9 4.5-.5 1.7-2.1 3-4.1 3V4.5z" />
        </svg>
      </div>
      <span class="text-base sm:text-lg font-black tracking-tight text-[#0B2545]">
        MIND<span class="text-[#0077FE]">FIX</span>
      </span>
    </a>

    <!-- All Pages Navigation Bar (Visible for Exposition) -->
    <nav class="flex items-center gap-1 overflow-x-auto py-1 scrollbar-none" aria-label="Navegación principal">
      {navLinks.map((link) => {
        const isActive = active === link.id;
        return (
          <a
            href={link.href}
            class={`whitespace-nowrap px-2.5 py-1.5 rounded-lg text-[11px] sm:text-xs font-bold transition-all ${
              isActive
                ? 'bg-[#0077FE] text-white shadow-sm'
                : link.id === 'planes-app'
                  ? 'text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200'
                  : link.id === 'upgrade'
                    ? 'text-[#6D4AFF] bg-purple-50 hover:bg-purple-100 border border-purple-200'
                    : link.id === 'trial'
                      ? 'text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200'
                      : 'text-slate-600 hover:text-[#0B2545] hover:bg-slate-100'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Login / App CTA -->
    <div class="flex items-center gap-2 shrink-0">
      <a
        href="/app"
        class={`whitespace-nowrap px-3.5 py-1.5 rounded-full text-xs font-extrabold transition-all ${
          active === 'login' || active === 'app'
            ? 'bg-[#0B2545] text-white'
            : 'bg-gradient-to-r from-[#0077FE] to-[#6D4AFF] text-white hover:opacity-95 shadow-sm'
        }`}
      >
        Mi Dashboard App
      </a>
    </div>
  </div>
</header>
