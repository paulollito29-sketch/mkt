---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

const title = "Prueba Gratuita 14 Días | Plan Premium MindFix";
const description = "Activa tu prueba gratuita de 14 días del Plan Premium de MindFix y explora todas las funcionalidades para potenciar tu rendimiento universitario.";

const premiumFeatures = [
  { icon: "🧠", title: "Diagnóstico IA Ilimitado", desc: "Analiza todos tus cursos y detecta micro-vacíos conceptuales antes de cada evaluación." },
  { icon: "🤝", title: "Mentores Pares P2P Ilimitados", desc: "Conecta con estudiantes de ciclos superiores que ya sacaron +18 en tu materia." },
  { icon: "📝", title: "Banco de Exámenes Pasados", desc: "Resolución paso a paso de parciales y finales reales de tu universidad." },
  { icon: "🔍", title: "Auditoría Forense de Notas", desc: "Matriz automática de 4 cuadrantes para saber exactamente en qué fallaste." },
  { icon: "🌙", title: "Planificador Sin Amanecidas", desc: "Bloques de estudio 50/10 optimizados para proteger tu sueño REM." },
  { icon: "🏆", title: "Ruta al Tercio Superior", desc: "Seguimiento semanal de tu promedio ponderado y metas por ciclo." },
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>

  <body class="bg-[#F8FAFC] text-[#0B2545] min-h-screen flex flex-col font-sans antialiased">
    <Navbar active="trial" />

    <main class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14 w-full flex-1">
      <!-- Indicador de Pasos de la Exposición -->
      <div class="flex flex-wrap items-center justify-center gap-2 mb-10 text-xs font-bold">
        <button type="button" onclick="showTrialStage(1)" id="pill-stage-1" class="px-3.5 py-1.5 rounded-full bg-[#0B2545] text-white cursor-pointer">
          1. Inicio Prueba
        </button>
        <span class="text-slate-300">→</span>
        <button type="button" onclick="showTrialStage(2)" id="pill-stage-2" class="px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-500 cursor-pointer">
          2. Confirmar Prueba
        </button>
        <span class="text-slate-300">→</span>
        <button type="button" onclick="showTrialStage(3)" id="pill-stage-3" class="px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-500 cursor-pointer">
          3. Premium Activo (14 días)
        </button>
        <span class="text-slate-300">→</span>
        <button type="button" onclick="showTrialStage(4)" id="pill-stage-4" class="px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-500 cursor-pointer">
          4. Fin de Prueba & Planes
        </button>
      </div>

      <!-- ==================== ETAPA 1: BOTÓN "INICIAR PRUEBA GRATUITA" ==================== -->
      <section id="trial-stage-1" class="bg-white rounded-3xl border border-slate-200 shadow-xl p-8 sm:p-14 text-center max-w-3xl mx-auto">
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-extrabold uppercase tracking-wider mb-5">
          🎁 Acceso Completo Sin Costo
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-[#0B2545] tracking-tight mb-4">
          Prueba MindFix Premium gratis durante 14 días
        </h1>
        <p class="text-base sm:text-lg text-slate-600 max-w-xl mx-auto mb-8">
          Explora todas las herramientas de diagnóstico IA, mentorías entre pares y simulacros antes de elegir un plan.
        </p>

        <button
          type="button"
          onclick="showTrialStage(2)"
          class="inline-flex items-center justify-center gap-3 px-9 py-4 rounded-2xl bg-gradient-to-r from-[#0077FE] to-[#00C2FF] text-white font-black text-base sm:text-lg shadow-xl shadow-[#0077FE]/30 hover:scale-[1.03] active:scale-[0.98] transition-all cursor-pointer"
        >
          <span>Iniciar prueba gratuita</span>
          <span aria-hidden="true">→</span>
        </button>

        <p class="text-xs text-slate-400 mt-4 font-semibold">
          ✓ Sin compromiso · 14 días completos de Plan Premium
        </p>
      </section>

      <!-- ==================== ETAPA 2: BOTÓN "INICIAR LA PRUEBA" ==================== -->
      <section id="trial-stage-2" class="hidden bg-gradient-to-br from-[#0B2545] to-[#1E1B4B] text-white rounded-3xl border border-[#00C2FF]/30 shadow-2xl p-8 sm:p-14 text-center max-w-3xl mx-auto">
        <div class="w-16 h-16 rounded-2xl bg-white/10 border border-white/15 flex items-center justify-center text-3xl mx-auto mb-5">
          🚀
        </div>
        <h2 class="text-2xl sm:text-4xl font-black tracking-tight mb-3">
          ¿Listo para activar tus 14 días de Plan Premium?
        </h2>
        <p class="text-sm sm:text-base text-slate-300 max-w-lg mx-auto mb-8">
          Al presionar el botón se habilitarán todas las funcionalidades avanzadas en tu cuenta durante 14 días calendario.
        </p>

        <button
          type="button"
          onclick="showTrialStage(3)"
          class="inline-flex items-center justify-center gap-3 px-10 py-4 rounded-2xl bg-gradient-to-r from-emerald-500 to-teal-400 text-[#070D18] font-black text-base sm:text-lg shadow-xl shadow-emerald-500/30 hover:scale-[1.03] active:scale-[0.98] transition-all cursor-pointer"
        >
          <span>Iniciar la prueba</span>
          <span aria-hidden="true">✓</span>
        </button>
      </section>

      <!-- ==================== ETAPA 3: PLAN PREMIUM ACTIVO POR 14 DÍAS + FUNCIONALIDADES + FINALIZAR ==================== -->
      <section id="trial-stage-3" class="hidden space-y-8">
        <!-- Banner Estado Activo -->
        <div class="bg-gradient-to-r from-emerald-600 via-teal-600 to-[#0077FE] text-white rounded-3xl p-7 sm:p-10 shadow-xl flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/20 text-white text-xs font-black uppercase tracking-wider mb-3">
              <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
              <span>Estado de Suscripción</span>
            </div>
            <h2 class="text-2xl sm:text-4xl font-black tracking-tight">
              Plan Premium activo por 14 días
            </h2>
            <p class="text-sm text-emerald-50 mt-1.5">
              Tienes desbloqueado el 100% de las herramientas de MindFix hasta completar tus 14 días de prueba.
            </p>
          </div>

          <div class="bg-white/15 backdrop-blur-md border border-white/25 rounded-2xl px-6 py-4 text-center shrink-0">
            <span class="block text-3xl font-black">14 días</span>
            <span class="text-xs font-bold uppercase tracking-wider text-emerald-100">restantes</span>
          </div>
        </div>

        <!-- Todas las Funcionalidades del Plan Premium -->
        <div class="bg-white rounded-3xl border border-slate-200 p-7 sm:p-10 shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-8">
            <div>
              <span class="text-xs font-extrabold uppercase tracking-wider text-[#0077FE]">Ecosistema Completo Desbloqueado</span>
              <h3 class="text-2xl font-black text-[#0B2545] mt-1">
                Todas las funcionalidades de tu Plan Premium
              </h3>
            </div>
            <span class="px-3.5 py-1.5 rounded-full bg-emerald-100 text-emerald-800 text-xs font-black">
              6 / 6 Módulos Activos ✓
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {premiumFeatures.map((feat) => (
              <div class="p-5 rounded-2xl bg-[#F8FAFC] border border-slate-200/80 hover:border-[#0077FE] transition-colors">
                <div class="text-2xl mb-3">{feat.icon}</div>
                <h4 class="text-base font-extrabold text-[#0B2545] mb-1.5">{feat.title}</h4>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{feat.desc}</p>
              </div>
            ))}
          </div>

          <!-- Botón para finalizar los 14 días -->
          <div class="mt-10 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p class="text-xs sm:text-sm text-slate-500">
              Cuando terminen los 14 días de prueba, podrás elegir un plan para continuar con tu progreso.
            </p>
            <button
              type="button"
              onclick="showTrialStage(4)"
              class="shrink-0 px-7 py-3.5 rounded-2xl bg-[#0B2545] hover:bg-rose-600 text-white font-extrabold text-sm shadow-md transition-colors cursor-pointer"
            >
              Finalizar prueba gratuita →
            </button>
          </div>
        </div>
      </section>

      <!-- ==================== ETAPA 4: PRUEBA FINALIZADA + PLANES PARA SEGUIR ==================== -->
      <section id="trial-stage-4" class="hidden space-y-8">
        <div class="bg-white rounded-3xl border-2 border-amber-300 shadow-xl p-8 sm:p-10 text-center">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-100 text-amber-800 text-xs font-extrabold uppercase tracking-wider mb-4">
            ⏳ Periodo de Prueba Completado
          </span>
          <h2 class="text-2xl sm:text-4xl font-black text-[#0B2545] tracking-tight mb-3">
            Tus 14 días de prueba gratuita han finalizado
          </h2>
          <p class="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto">
            Tu historial de diagnósticos, apuntes y rutas de estudio sigue guardado. Elige uno de nuestros planes para seguir disfrutando de MindFix Premium sin interrupciones:
          </p>
        </div>

        <!-- Planes para poder seguir (Sin medios de pago, según indicación) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Plan Mensual -->
          <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <span class="text-xs font-extrabold uppercase tracking-wider text-slate-400">Continuidad Flexible</span>
              <h3 class="text-2xl font-black text-[#0B2545] mt-1">Plan Mensual</h3>
              <div class="my-4 flex items-baseline gap-1.5">
                <span class="text-4xl font-black text-[#0B2545]">S/ 39.00</span>
                <span class="text-xs font-semibold text-slate-400">/ mes</span>
              </div>
              <ul class="space-y-2.5 text-sm text-slate-600">
                <li>✓ Todas las funcionalidades Premium activas</li>
                <li>✓ Cancela cuando terminen tus parciales</li>
              </ul>
            </div>
            <a href="/planes" class="mt-7 block w-full py-3.5 rounded-2xl border-2 border-[#0B2545] text-[#0B2545] hover:bg-[#0B2545] hover:text-white text-center font-extrabold text-sm transition-colors">
              Continuar con Plan Mensual
            </a>
          </div>

          <!-- Plan Anual (-50% / -45%) -->
          <div class="bg-gradient-to-br from-[#0B2545] to-[#1E1B4B] text-white rounded-3xl p-8 border-2 border-[#00C2FF] shadow-2xl flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-xs font-extrabold uppercase tracking-wider text-[#00C2FF]">Mejor Opción</span>
                <span class="px-2.5 py-1 rounded-full bg-emerald-400 text-[#070D18] text-[10px] font-black uppercase">50% OFF Post-Prueba</span>
              </div>
              <h3 class="text-2xl font-black mt-1">Plan Anual Premium</h3>
              <div class="my-4 flex items-baseline gap-2">
                <span class="text-base text-slate-400 line-through">S/ 39.00</span>
                <span class="text-4xl font-black">S/ 19.50</span>
                <span class="text-xs font-semibold text-slate-300">/ mes</span>
              </div>
              <ul class="space-y-2.5 text-sm text-slate-200">
                <li>✓ Acceso completo durante todo tu año universitario</li>
                <li>✓ Mentores pares P2P y simulacros ilimitados</li>
              </ul>
            </div>
            <a href="/upgrade" class="mt-7 block w-full py-3.5 rounded-2xl bg-gradient-to-r from-[#0077FE] to-[#00C2FF] text-white text-center font-extrabold text-sm shadow-lg hover:scale-[1.02] transition-all">
              Seguir con Plan Anual (-50%) →
            </a>
          </div>
        </div>
      </section>
    </main>

    <script is:inline>
      function showTrialStage(stage) {
        [1, 2, 3, 4].forEach((n) => {
          document.getElementById(`trial-stage-${n}`).classList.toggle('hidden', n !== stage);
          const pill = document.getElementById(`pill-stage-${n}`);
          if (n === stage) {
            pill.className = 'px-3.5 py-1.5 rounded-full bg-[#0B2545] text-white cursor-pointer';
          } else {
            pill.className = 'px-3.5 py-1.5 rounded-full bg-white border border-slate-200 text-slate-500 hover:text-[#0B2545] cursor-pointer';
          }
        });
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    </script>
  </body>
</html>
