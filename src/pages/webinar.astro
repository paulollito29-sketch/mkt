---
import '../styles/global.css';

const title = "Webinar Gratuito: Hábitos y organización para estudiar mejor | MindFix";
const description = "Estrategias prácticas para mejorar tu productividad, reducir el estrés y rendir más en la universidad. Sábado 29 de nov. a las 7:00 p.m. vía Zoom.";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Webinar Gratuito MindFix: Hábitos y organización para estudiar mejor" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero-valeria-mindfix.webp" />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#FFFFFF] text-[#1E1B4B] antialiased selection:bg-[#6D4AFF] selection:text-white min-h-screen flex flex-col font-sans">
    <!-- ==================== NAVBAR ==================== -->
    <header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-purple-100">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 h-18 flex items-center justify-between py-3">
        <!-- Logo MindFix Morado -->
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-[#6D4AFF] to-[#4C28C9] text-white flex items-center justify-center shadow-md shadow-purple-500/20">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5C9.5 4.5 7.5 6.3 7.2 8.7C5.4 9.2 4 10.9 4 13c0 2.3 1.7 4.2 3.9 4.5.5 1.7 2.1 3 4.1 3V4.5z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5c2.5 0 4.5 1.8 4.8 4.2 1.8.5 3.2 2.2 3.2 4.3 0 2.3-1.7 4.2-3.9 4.5-.5 1.7-2.1 3-4.1 3V4.5z" />
            </svg>
          </div>
          <span class="text-xl font-black tracking-tight text-[#1E1B4B]">
            MIND <span class="text-[#6D4AFF]">FIX</span>
          </span>
        </a>

        <!-- Links centrales (todas las páginas para exposición) -->
        <nav class="hidden lg:flex items-center gap-1.5 text-xs font-bold text-slate-600">
          <a href="/" class="px-2.5 py-1.5 rounded-lg hover:text-[#6D4AFF] hover:bg-purple-50">Inicio</a>
          <a href="/blog" class="px-2.5 py-1.5 rounded-lg hover:text-[#6D4AFF] hover:bg-purple-50">Blog</a>
          <a href="/guia-gratuita" class="px-2.5 py-1.5 rounded-lg hover:text-[#6D4AFF] hover:bg-purple-50">Lead Magnet</a>
          <a href="/webinar" class="px-2.5 py-1.5 rounded-lg bg-[#6D4AFF] text-white">Webinar</a>
          <a href="/test-diagnostico" class="px-2.5 py-1.5 rounded-lg hover:text-[#6D4AFF] hover:bg-purple-50">Test IA</a>
          <a href="/ugc" class="px-2.5 py-1.5 rounded-lg hover:text-[#6D4AFF] hover:bg-purple-50">UGC</a>
          <a href="/planes" class="px-2.5 py-1.5 rounded-lg hover:text-[#6D4AFF] hover:bg-purple-50">Planes</a>
          <a href="/upgrade" class="px-2.5 py-1.5 rounded-lg text-[#6D4AFF] bg-purple-50">Upgrade -50%</a>
          <a href="/prueba-gratuita" class="px-2.5 py-1.5 rounded-lg text-emerald-700 bg-emerald-50">Prueba Gratis</a>
        </nav>

        <!-- Botón Registrarme -->
        <a
          href="#registro-webinar"
          class="px-5 py-2.5 rounded-full bg-gradient-to-r from-[#6D4AFF] to-[#5633E0] text-white text-sm font-extrabold shadow-md shadow-purple-500/25 hover:scale-105 active:scale-95 transition-all"
        >
          Registrarme
        </a>
      </div>
    </header>

    <main class="flex-1">
      <!-- ==================== HERO WEBINAR ==================== -->
      <section class="relative overflow-hidden bg-gradient-to-b from-[#F4F1FF] via-[#F8F6FF] to-white pt-10 pb-14 sm:pt-14 sm:pb-16">
        <!-- Decoración sutil -->
        <div class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 rounded-full bg-[#7C3AED]/10 blur-3xl"></div>
        <div class="pointer-events-none absolute top-20 -left-24 w-80 h-80 rounded-full bg-[#6D4AFF]/10 blur-3xl"></div>

        <div class="max-w-5xl mx-auto px-4 sm:px-6 relative">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <!-- Columna Izquierda -->
            <div class="lg:col-span-7 text-left">
              <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#6D4AFF] text-white text-xs font-extrabold uppercase tracking-wider shadow-sm mb-5">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
                <span>WEBINAR GRATUITO</span>
              </div>

              <h1 class="text-3xl sm:text-4xl lg:text-[2.85rem] font-black text-[#1E1B4B] tracking-tight leading-[1.12] mb-5">
                Hábitos y organización para estudiar mejor
              </h1>

              <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-xl mb-4">
                Estrategias prácticas para mejorar tu productividad, reducir el estrés y rendir más en la universidad.
              </p>
            </div>

            <!-- Columna Derecha: Imagen estudiante + detalles visuales -->
            <div class="lg:col-span-5 relative flex justify-center">
              <div class="relative w-full max-w-sm">
                <!-- Rayitos morados decorativos estilo ilustración -->
                <div class="hidden sm:block absolute -top-3 left-4 text-[#6D4AFF] font-black text-xl select-none">╲ │ ╱</div>
                <div class="hidden sm:block absolute -top-3 right-4 text-[#6D4AFF] font-black text-xl select-none">╲ │ ╱</div>

                <!-- Círculo morado de fondo -->
                <div class="relative rounded-3xl overflow-hidden bg-gradient-to-tr from-[#6D4AFF]/20 to-[#A78BFA]/20 p-3 border border-purple-200 shadow-xl">
                  <img
                    src="/images/hero-valeria-mindfix.webp"
                    alt="Estudiante universitaria feliz estudiando con laptop y audífonos"
                    class="w-full h-64 sm:h-72 object-cover rounded-2xl"
                    loading="eager"
                  />
                  <!-- Sticker MindFix sobre la esquina -->
                  <div class="absolute bottom-6 right-6 bg-white/95 backdrop-blur-md px-3.5 py-2 rounded-xl shadow-lg border border-purple-100 flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#6D4AFF] animate-ping"></span>
                    <span class="text-xs font-extrabold text-[#1E1B4B]">En vivo • Vía Zoom</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- ==================== BARRA DE 4 DATOS DEL EVENTO ==================== -->
          <div class="mt-8 bg-white rounded-3xl border border-purple-100 shadow-xl shadow-purple-900/5 p-5 sm:p-6">
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-5 divide-y lg:divide-y-0 lg:divide-x divide-purple-100">
              <!-- Fecha -->
              <div class="flex flex-col items-center text-center pt-2 lg:pt-0">
                <div class="w-11 h-11 rounded-2xl bg-[#F4F1FF] text-[#6D4AFF] flex items-center justify-center mb-2.5">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                </div>
                <p class="text-sm sm:text-base font-extrabold text-[#1E1B4B]">Sábado<br/>29 de nov.</p>
              </div>

              <!-- Hora -->
              <div class="flex flex-col items-center text-center pt-2 lg:pt-0">
                <div class="w-11 h-11 rounded-2xl bg-[#F4F1FF] text-[#6D4AFF] flex items-center justify-center mb-2.5">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                </div>
                <p class="text-sm sm:text-base font-extrabold text-[#1E1B4B]">7:00 p.m.<br/><span class="text-xs font-semibold text-slate-500">(GMT -5)</span></p>
              </div>

              <!-- Modalidad -->
              <div class="flex flex-col items-center text-center pt-4 lg:pt-0">
                <div class="w-11 h-11 rounded-2xl bg-[#F4F1FF] text-[#6D4AFF] flex items-center justify-center mb-2.5">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polygon points="23 7 16 12 23 17 23 7"></polygon>
                    <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                  </svg>
                </div>
                <p class="text-sm sm:text-base font-extrabold text-[#1E1B4B]">Vía<br/>Zoom</p>
              </div>

              <!-- Beneficios -->
              <div class="flex flex-col items-center text-center pt-4 lg:pt-0">
                <div class="w-11 h-11 rounded-2xl bg-[#F4F1FF] text-[#6D4AFF] flex items-center justify-center mb-2.5">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <polyline points="20 12 20 22 4 22 4 12"></polyline>
                    <rect x="2" y="7" width="20" height="5"></rect>
                    <line x1="12" y1="22" x2="12" y2="7"></line>
                    <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                    <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                  </svg>
                </div>
                <p class="text-sm sm:text-base font-extrabold text-[#1E1B4B]">Sorteos y<br/>beneficios Premium</p>
              </div>
            </div>
          </div>

          <!-- Botón CTA Principal -->
          <div class="mt-8 text-center">
            <a
              href="#registro-webinar"
              class="inline-flex items-center justify-center gap-3 px-9 py-4 rounded-full bg-gradient-to-r from-[#6D4AFF] to-[#4C28C9] text-white text-base sm:text-lg font-extrabold shadow-xl shadow-purple-600/30 hover:scale-[1.03] active:scale-[0.98] transition-all"
            >
              <span>¡Reserva tu lugar GRATIS!</span>
              <span aria-hidden="true" class="text-xl leading-none">›</span>
            </a>
          </div>
        </div>
      </section>

      <!-- ==================== SECCIÓN: ¿QUÉ APRENDERÁS EN EL WEBINAR? ==================== -->
      <section class="py-14 sm:py-16 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
          <h2 class="text-2xl sm:text-3xl font-black text-center text-[#1E1B4B] tracking-tight mb-10">
            ¿Qué aprenderás en el webinar?
          </h2>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
            <!-- Card 1 -->
            <div class="bg-[#FAF9FF] hover:bg-white rounded-3xl p-6 border border-purple-100 shadow-xs hover:shadow-lg transition-all text-center flex flex-col items-center">
              <div class="w-14 h-14 rounded-2xl bg-[#EDE9FE] text-[#6D4AFF] flex items-center justify-center mb-4">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"></circle>
                  <circle cx="12" cy="12" r="6"></circle>
                  <circle cx="12" cy="12" r="2"></circle>
                </svg>
              </div>
              <h3 class="text-sm sm:text-base font-extrabold text-[#1E1B4B] leading-snug">
                Organización del estudio
              </h3>
            </div>

            <!-- Card 2 -->
            <div class="bg-[#FAF9FF] hover:bg-white rounded-3xl p-6 border border-purple-100 shadow-xs hover:shadow-lg transition-all text-center flex flex-col items-center">
              <div class="w-14 h-14 rounded-2xl bg-[#EDE9FE] text-[#6D4AFF] flex items-center justify-center mb-4">
                <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
                </svg>
              </div>
              <h3 class="text-sm sm:text-base font-extrabold text-[#1E1B4B] leading-snug">
                Técnicas de concentración (Pomodoro)
              </h3>
            </div>

            <!-- Card 3 -->
            <div class="bg-[#FAF9FF] hover:bg-white rounded-3xl p-6 border border-purple-100 shadow-xs hover:shadow-lg transition-all text-center flex flex-col items-center">
              <div class="w-14 h-14 rounded-2xl bg-[#EDE9FE] text-[#6D4AFF] flex items-center justify-center mb-4">
                <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
                  <rect x="4" y="13" width="4" height="7" rx="1"></rect>
                  <rect x="10" y="9" width="4" height="11" rx="1"></rect>
                  <rect x="16" y="4" width="4" height="16" rx="1"></rect>
                </svg>
              </div>
              <h3 class="text-sm sm:text-base font-extrabold text-[#1E1B4B] leading-snug">
                Hábitos productivos
              </h3>
            </div>

            <!-- Card 4 -->
            <div class="bg-[#FAF9FF] hover:bg-white rounded-3xl p-6 border border-purple-100 shadow-xs hover:shadow-lg transition-all text-center flex flex-col items-center">
              <div class="w-14 h-14 rounded-2xl bg-[#EDE9FE] text-[#6D4AFF] flex items-center justify-center mb-4">
                <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                </svg>
              </div>
              <h3 class="text-sm sm:text-base font-extrabold text-[#1E1B4B] leading-snug">
                Manejo del estrés y bienestar
              </h3>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================== SECCIÓN: ¿POR QUÉ ASISTIR? ==================== -->
      <section class="py-8 sm:py-12 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6">
          <div class="bg-[#F4F1FF] rounded-3xl p-8 sm:p-10 border border-purple-100 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
            <!-- Checklist -->
            <div class="md:col-span-7">
              <h2 class="text-2xl sm:text-3xl font-black text-[#1E1B4B] mb-6">
                ¿Por qué asistir?
              </h2>
              <ul class="space-y-4">
                <li class="flex items-center gap-3.5 text-base sm:text-lg font-semibold text-[#1E1B4B]">
                  <span class="w-7 h-7 rounded-full bg-[#7C3AED] text-white flex items-center justify-center text-xs font-black shrink-0">✓</span>
                  <span>Contenido práctico y aplicable.</span>
                </li>
                <li class="flex items-center gap-3.5 text-base sm:text-lg font-semibold text-[#1E1B4B]">
                  <span class="w-7 h-7 rounded-full bg-[#7C3AED] text-white flex items-center justify-center text-xs font-black shrink-0">✓</span>
                  <span>Tips de estudiantes reales.</span>
                </li>
                <li class="flex items-center gap-3.5 text-base sm:text-lg font-semibold text-[#1E1B4B]">
                  <span class="w-7 h-7 rounded-full bg-[#7C3AED] text-white flex items-center justify-center text-xs font-black shrink-0">✓</span>
                  <span>Sorteos y acceso a beneficios Premium.</span>
                </li>
              </ul>
            </div>

            <!-- Mockup Laptop con Logo MindFix -->
            <div class="md:col-span-5 flex justify-center">
              <div class="relative bg-white rounded-2xl p-6 shadow-xl border border-purple-100 w-full max-w-[260px] text-center">
                <!-- Birrete flotante -->
                <div class="absolute -top-4 -right-3 text-3xl select-none" aria-hidden="true">🎓</div>
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#6D4AFF] to-[#4C28C9] text-white flex items-center justify-center mx-auto mb-3 shadow-lg">
                  <svg class="w-9 h-9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5C9.5 4.5 7.5 6.3 7.2 8.7C5.4 9.2 4 10.9 4 13c0 2.3 1.7 4.2 3.9 4.5.5 1.7 2.1 3 4.1 3V4.5z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5c2.5 0 4.5 1.8 4.8 4.2 1.8.5 3.2 2.2 3.2 4.3 0 2.3-1.7 4.2-3.9 4.5-.5 1.7-2.1 3-4.1 3V4.5z" />
                  </svg>
                </div>
                <p class="text-lg font-black tracking-tight text-[#1E1B4B]">MIND FIX</p>
                <p class="text-xs font-semibold text-slate-500 mt-1">Comunidad Universitaria P2P</p>
                <div class="mt-4 pt-3 border-t border-purple-50 flex items-center justify-center gap-2 text-xs font-bold text-[#6D4AFF]">
                  <span>📚</span>
                  <span>+2,400 estudiantes inscritos</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================== FORMULARIO DE REGISTRO AL WEBINAR ==================== -->
      <section id="registro-webinar" class="py-12 sm:py-16 bg-white">
        <div class="max-w-2xl mx-auto px-4 sm:px-6">
          <div class="bg-[#FAF9FF] rounded-3xl p-7 sm:p-10 border-2 border-[#6D4AFF]/20 shadow-xl">
            <div class="text-center mb-6">
              <span class="inline-block px-3.5 py-1 rounded-full bg-[#EDE9FE] text-[#6D4AFF] text-xs font-extrabold uppercase tracking-wider mb-3">
                Cupos limitados por Zoom
              </span>
              <h2 class="text-2xl sm:text-3xl font-black text-[#1E1B4B]">
                Reserva tu lugar gratis ahora
              </h2>
              <p class="text-sm text-slate-600 mt-1.5">
                Te enviaremos el link de acceso a Zoom y el acceso a los sorteos Premium directamente a tu correo.
              </p>
            </div>

            <form id="webinar-form" class="space-y-4" onsubmit="event.preventDefault(); registerWebinar();">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="wb-name" class="block text-xs font-bold text-slate-700 mb-1.5">Nombre completo</label>
                  <input
                    id="wb-name"
                    type="text"
                    required
                    placeholder="Ej. Valeria Rojas"
                    class="w-full px-4 py-3 rounded-xl border border-purple-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#6D4AFF]"
                  />
                </div>
                <div>
                  <label for="wb-career" class="block text-xs font-bold text-slate-700 mb-1.5">Carrera / Facultad</label>
                  <input
                    id="wb-career"
                    type="text"
                    placeholder="Ej. Ingeniería Industrial"
                    class="w-full px-4 py-3 rounded-xl border border-purple-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#6D4AFF]"
                  />
                </div>
              </div>

              <div>
                <label for="wb-email" class="block text-xs font-bold text-slate-700 mb-1.5">Correo electrónico</label>
                <input
                  id="wb-email"
                  type="email"
                  required
                  placeholder="tucorreo@universidad.edu.pe"
                  class="w-full px-4 py-3 rounded-xl border border-purple-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[#6D4AFF]"
                />
              </div>

              <button
                type="submit"
                class="w-full py-4 px-6 rounded-full bg-gradient-to-r from-[#6D4AFF] to-[#4C28C9] text-white font-extrabold text-base shadow-lg shadow-purple-600/30 hover:scale-[1.01] active:scale-[0.99] transition-all cursor-pointer"
              >
                ¡Confirmar mi lugar GRATIS! ›
              </button>
            </form>

            <!-- Confirmación -->
            <div id="webinar-success" class="hidden text-center py-6">
              <div class="w-14 h-14 rounded-full bg-emerald-500 text-white flex items-center justify-center mx-auto mb-3 text-2xl font-black">
                ✓
              </div>
              <h3 class="text-xl font-black text-[#1E1B4B] mb-2">
                ¡Tu lugar está reservado!
              </h3>
              <p class="text-sm text-slate-600 mb-5">
                Enviamos el enlace de Zoom a <strong id="wb-email-confirmed" class="text-[#6D4AFF]"></strong>. Mientras llega el sábado, descubre tus vacíos conceptuales ahora:
              </p>
              <a
                href="/test-diagnostico"
                class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[#6D4AFF] text-white font-bold text-sm hover:bg-[#5633E0] transition-colors"
              >
                Hacer Test Diagnóstico Gratis →
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- ==================== BANNER / FOOTER MORADO OSCURO ==================== -->
    <footer class="bg-[#24145E] text-white py-8 px-4 sm:px-6 mt-auto">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-2xl bg-white/10 border border-white/15 flex items-center justify-center">
            <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
