      function registerWebinar() {
        const email = document.getElementById('wb-email')?.value || '';
        const form = document.getElementById('webinar-form');
        const success = document.getElementById('webinar-success');
        const confirmed = document.getElementById('wb-email-confirmed');
        if (confirmed) confirmed.textContent = email;
