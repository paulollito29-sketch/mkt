---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

const title = "Planes Premium MindFix | App Móvil & Web";
const description = "Acompaña tu estudio, hábitos de alto rendimiento y el ingreso al Tercio Superior con Fixi IA y tutorías P2P. Prueba 14 días gratis.";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>

  <body class="bg-[#F6FAF6] text-[#0B2545] min-h-screen flex flex-col font-sans antialiased selection:bg-[#0077FE] selection:text-white">
    <!-- Navbar global unificada para exposición -->
    <Navbar active="planes-app" />

    <!-- Top Announcement Bar -->
    <div class="bg-gradient-to-r from-[#10B981] via-[#0077FE] to-[#7928CA] text-white py-2 px-4 text-center text-xs font-bold shadow-xs">
      <div class="max-w-6xl mx-auto flex items-center justify-center gap-2">
        <span class="px-2 py-0.5 rounded-full bg-white/20 text-[10px] uppercase tracking-wider">Nuevo Lanzamiento</span>
        <span>¡Prueba Premium activa por 14 días sin costo! Accede a Fixi IA y simulacros de parciales.</span>
      </div>
    </div>

    <!-- MAIN CONTAINER -->
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12 w-full flex-1">
      
      <!-- HERO HEADER: Estilo idéntico a NutriMind adaptado a MindFix -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm mb-12 relative overflow-hidden">
        <!-- Decoraciones de fondo -->
        <div class="absolute -top-16 -right-16 w-64 h-64 bg-emerald-50 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-16 -left-16 w-64 h-64 bg-blue-50 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <!-- Columna Izquierda: Foto de Valeria sonriendo estudiando con laptop/apuntes -->
          <div class="lg:col-span-5 flex justify-center">
            <div class="relative w-full max-w-sm">
              <div class="aspect-4/3 sm:aspect-square rounded-3xl overflow-hidden shadow-xl border-4 border-white bg-slate-100">
                <img
                  src="/images/hero-valeria-mindfix.webp"
                  alt="Estudiante universitaria con MindFix"
                  class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-500"
                />
              </div>
              <!-- Badge flotante de Tercio Superior -->
              <div class="absolute -bottom-3 -right-2 bg-white px-4 py-2 rounded-2xl shadow-lg border border-slate-100 flex items-center gap-2">
                <span class="text-xl">🏆</span>
                <div>
                  <div class="text-[10px] font-black uppercase text-emerald-600 tracking-wider">Meta Alcanzada</div>
                  <div class="text-xs font-extrabold text-[#0B2545]">Tercio Superior 2026</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Columna Derecha: Mascota Fixi IA, Título y 4 Pilares -->
          <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
            <div class="flex items-center gap-3 mb-3">
              <!-- Mascota Fixi IA -->
              <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-400 via-teal-400 to-[#0077FE] p-0.5 shadow-md flex items-center justify-center animate-bounce-slow">
                <div class="w-full h-full bg-white rounded-[14px] flex items-center justify-center text-2xl">
                  🤖
                </div>
              </div>
              <div class="text-left">
                <span class="text-xs font-extrabold text-emerald-600 uppercase tracking-wider block">¡Hola! Soy Fixi IA</span>
                <span class="text-[11px] text-slate-500 font-semibold">Tu tutor y copiloto de estudio 24/7</span>
              </div>
            </div>

            <h1 class="text-3xl sm:text-5xl font-black text-[#0B2545] tracking-tight mb-3">
              Planes Premium <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-[#0077FE] to-purple-600">MindFix</span>
            </h1>

            <p class="text-base sm:text-lg text-slate-600 font-medium max-w-xl mb-6">
              Acompaña tu estudio, los hábitos de alto rendimiento y el ingreso al <strong>Tercio Superior</strong> con inteligencia artificial y tutorías entre pares.
            </p>

            <!-- 4 Pills de Beneficios Clave (Idéntico al diseño de NutriMind) -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 w-full max-w-xl">
              <div class="bg-emerald-50/80 border border-emerald-200/80 rounded-2xl p-2.5 text-center flex flex-col items-center justify-center">
                <span class="text-xl mb-1">🎓</span>
                <span class="text-[11px] font-black text-emerald-800 leading-tight">Tutoría P2P</span>
              </div>
              <div class="bg-blue-50/80 border border-blue-200/80 rounded-2xl p-2.5 text-center flex flex-col items-center justify-center">
                <span class="text-xl mb-1">🧠</span>
                <span class="text-[11px] font-black text-blue-800 leading-tight">Hábitos de Estudio</span>
              </div>
              <div class="bg-purple-50/80 border border-purple-200/80 rounded-2xl p-2.5 text-center flex flex-col items-center justify-center">
                <span class="text-xl mb-1">⚡</span>
                <span class="text-[11px] font-black text-purple-800 leading-tight">Diagnóstico IA</span>
              </div>
              <div class="bg-pink-50/80 border border-pink-200/80 rounded-2xl p-2.5 text-center flex flex-col items-center justify-center">
                <span class="text-xl mb-1">📈</span>
                <span class="text-[11px] font-black text-pink-800 leading-tight">Tercio Superior</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- PRICING TITLE & SWITCHER: Elige el plan ideal para tu familia/ciclo -->
      <section class="text-center max-w-3xl mx-auto mb-10">
        <div class="flex items-center justify-center gap-2 mb-2">
          <span class="text-amber-400 text-lg">✨</span>
          <h2 class="text-2xl sm:text-4xl font-black text-[#0B2545] tracking-tight">
            Elige el plan ideal para tu ciclo universitario
          </h2>
          <span class="text-amber-400 text-lg">✨</span>
        </div>
        <p class="text-sm text-slate-500 mb-6 font-medium">Invierte en tu tranquilidad, tus notas y tu futuro profesional.</p>

        <!-- Toggle Pills: Pago Mensual / Pago Anual Ahorra hasta 35% -->
        <div class="inline-flex items-center bg-white p-1 rounded-full border border-slate-200 shadow-md">
          <button
            id="toggle-monthly"
            type="button"
            onclick="switchPricing('monthly')"
            class="px-6 py-2 rounded-full bg-[#E11D48] text-white text-xs sm:text-sm font-black transition-all cursor-pointer shadow-xs"
          >
            Pago Mensual
          </button>
          <button
            id="toggle-annual"
            type="button"
            onclick="switchPricing('annual')"
            class="px-6 py-2 rounded-full text-slate-600 hover:text-[#0B2545] text-xs sm:text-sm font-extrabold transition-all cursor-pointer flex items-center gap-2"
          >
            <span>Pago Anual</span>
            <span class="px-2 py-0.5 rounded-full bg-emerald-500 text-white text-[10px] font-black uppercase">Ahorra hasta 35%</span>
          </button>
        </div>
      </section>

      <!-- 3 PRICING CARDS: SMART, PRO, ELITE (Fieles al diseño referencial) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-7 items-stretch mb-12">
        
        <!-- CARD 1: Plan SMART (Rosa/Fucsia) -->
        <div class="bg-white rounded-3xl p-6 sm:p-7 border-2 border-pink-200 shadow-lg hover:shadow-xl transition-all flex flex-col justify-between relative overflow-hidden group">
          <div class="text-center">
            <!-- Header Pill -->
            <div class="inline-flex items-center gap-1.5 px-5 py-2 rounded-full bg-gradient-to-r from-pink-500 to-rose-500 text-white font-black text-xs uppercase tracking-wider shadow-sm mb-3">
              <span>⭐</span> Plan SMART
            </div>
            <p class="text-xs text-slate-600 font-semibold mb-4 leading-relaxed px-2">
              Conecta, descubre y accede a soluciones de estudio efectivas y apuntes validados
            </p>

            <!-- Price -->
            <div class="my-4 pb-4 border-b border-pink-100 flex items-baseline justify-center gap-1">
              <span class="text-4xl sm:text-5xl font-black text-rose-500" id="card-price-smart">S/ 19.90</span>
              <span class="text-xs font-bold text-slate-400" id="card-period-smart">/mes</span>
            </div>

            <!-- Features -->
            <ul class="text-left space-y-3 text-xs sm:text-sm text-slate-700">
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Marketplace MindPartners:</strong> Soluciones y resúmenes de parciales</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Soluciones y recursos validados:</strong> Banco de preguntas de ciclos previos</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Comunidad universitaria activa:</strong> Foros por materia y carrera</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Certificación MindPartners:</strong> Apuntes calificados y ordenados</span>
              </li>
            </ul>
          </div>

          <div class="mt-8">
            <a
              href="/login?plan=smart"
              class="block w-full py-3 rounded-full border-2 border-rose-500 text-rose-500 hover:bg-rose-500 hover:text-white font-black text-xs uppercase tracking-wider text-center transition-colors shadow-xs"
            >
              Elegir Plan SMART
            </a>
          </div>
        </div>

        <!-- CARD 2: Plan PRO (Verde Esmeralda - Más Elegido) -->
        <div class="bg-white rounded-3xl p-6 sm:p-7 border-2 border-emerald-500 shadow-xl hover:shadow-2xl transition-all flex flex-col justify-between relative overflow-hidden lg:-translate-y-2">
          <!-- Tag Más Elegido -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 bg-amber-400 text-[#0B2545] font-black text-[10px] uppercase tracking-wider px-4 py-1 rounded-b-xl shadow-xs">
            Más elegido
          </div>

          <div class="text-center pt-3">
            <!-- Header Pill -->
            <div class="inline-flex items-center gap-1.5 px-5 py-2 rounded-full bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-black text-xs uppercase tracking-wider shadow-sm mb-3">
              <span>👑</span> Plan PRO
            </div>
            <p class="text-xs text-slate-600 font-semibold mb-4 leading-relaxed px-2">
              Organiza y mejora tus hábitos de estudio y asegura tus parciales universitarios
            </p>

            <!-- Price -->
            <div class="my-4 pb-4 border-b border-emerald-100 flex items-baseline justify-center gap-1">
              <span class="text-4xl sm:text-5xl font-black text-emerald-600" id="card-price-pro">S/ 9.90</span>
              <span class="text-xs font-bold text-slate-400" id="card-period-pro">/mes</span>
            </div>

            <!-- Features -->
            <ul class="text-left space-y-3 text-xs sm:text-sm text-slate-700">
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Acompañamiento inteligente:</strong> Monitoreo de hábitos de estudio universitarios</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Historial y diagnóstico forense:</strong> Detección de vacíos conceptuales</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Planificador inteligente semanal:</strong> Rutinas de 50 min Pomodoro</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Replanificación automática:</strong> Ajuste según tus avances y horas de sueño</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Simulacros de examen pasados:</strong> Soluciones paso a paso</span>
              </li>
            </ul>
          </div>

          <div class="mt-8">
            <a
              href="/prueba-gratuita?plan=pro"
              class="block w-full py-3.5 rounded-full bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-black text-xs uppercase tracking-wider text-center transition-all shadow-md shadow-emerald-500/20"
            >
              Elegir Plan PRO
            </a>
          </div>
        </div>

        <!-- CARD 3: Plan ELITE (Púrpura / Violeta) -->
        <div class="bg-white rounded-3xl p-6 sm:p-7 border-2 border-purple-200 shadow-lg hover:shadow-xl transition-all flex flex-col justify-between relative overflow-hidden group">
          <div class="text-center">
            <!-- Header Pill -->
            <div class="inline-flex items-center gap-1.5 px-5 py-2 rounded-full bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-black text-xs uppercase tracking-wider shadow-sm mb-3">
              <span>💎</span> Plan ELITE
            </div>
            <p class="text-xs text-slate-600 font-semibold mb-4 leading-relaxed px-2">
              La experiencia más completa con IA predictiva, tutorías 1 a 1 y gamificación total
            </p>

            <!-- Price -->
            <div class="my-4 pb-4 border-b border-purple-100 flex items-baseline justify-center gap-1">
              <span class="text-4xl sm:text-5xl font-black text-purple-700" id="card-price-elite">S/ 39.90</span>
              <span class="text-xs font-bold text-slate-400" id="card-period-elite">/mes</span>
            </div>

            <!-- Features -->
            <ul class="text-left space-y-3 text-xs sm:text-sm text-slate-700">
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>IA predictiva de exámenes:</strong> Preguntas clave con probabilidad de parcial</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Gamificación con microretos:</strong> Rankings por facultad y medallas</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Copiloto de gestión de estrés:</strong> Manejo de ansiedad y rutinas de descanso</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Tutorías 1-on-1 semanales:</strong> Con estudiantes del Tercio Superior</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 font-black text-base shrink-0">✔</span>
                <span><strong>Integración de plataformas:</strong> Canvas, Google Calendar y Notion</span>
              </li>
            </ul>
          </div>

          <div class="mt-8">
            <a
              href="/upgrade?plan=elite"
              class="block w-full py-3 rounded-full bg-purple-700 hover:bg-purple-800 text-white font-black text-xs uppercase tracking-wider text-center transition-colors shadow-sm"
            >
              Elegir Plan ELITE
            </a>
          </div>
        </div>
      </div>

      <!-- TRUST BADGES STRIP (4 columnas: Prueba GRATIS 14 días, Cancela cuando quieras, Soporte personalizado, Pago 100% seguro) -->
      <section class="bg-white rounded-3xl p-5 sm:p-7 border border-slate-200 shadow-sm mb-14">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 items-center">
          <div class="flex items-center gap-3 justify-center sm:justify-start">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
              📅
            </div>
            <div>
              <div class="text-xs font-black text-[#0B2545]">Prueba GRATIS</div>
              <div class="text-[11px] text-emerald-600 font-bold">14 días completos</div>
            </div>
          </div>

          <div class="flex items-center gap-3 justify-center sm:justify-start">
            <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl shrink-0">
              ♾️
            </div>
            <div>
              <div class="text-xs font-black text-[#0B2545]">Cancela</div>
              <div class="text-[11px] text-slate-500 font-semibold">cuando quieras</div>
            </div>
          </div>

          <div class="flex items-center gap-3 justify-center sm:justify-start">
            <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl shrink-0">
              🎧
            </div>
            <div>
              <div class="text-xs font-black text-[#0B2545]">Soporte</div>
              <div class="text-[11px] text-slate-500 font-semibold">personalizado</div>
            </div>
          </div>

          <div class="flex items-center gap-3 justify-center sm:justify-start">
            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl shrink-0">
              🛡️
            </div>
            <div>
              <div class="text-xs font-black text-[#0B2545]">Pago 100%</div>
              <div class="text-[11px] text-slate-500 font-semibold">seguro</div>
            </div>
          </div>
        </div>
      </section>

      <!-- FEATURE SHOWCASE: MOCKUP INTERACTIVO POR CADA PLAN (SMART, PRO, ELITE) -->
      <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-sm mb-12">
        <div class="text-center max-w-2xl mx-auto mb-8">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 text-[#0077FE] font-black text-xs uppercase tracking-wider mb-2">
            📱 Mockup Interactivo de la App
          </span>
          <h3 class="text-2xl sm:text-4xl font-black text-[#0B2545] tracking-tight">
            Descubre cómo cambia la app en cada plan
          </h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">
            Selecciona un plan para ver en tiempo real qué funciones se activan, se amplían o se desbloquean en tu interfaz universitaria.
          </p>

          <!-- TABS INTERACTIVAS: SMART / PRO / ELITE -->
          <div class="inline-flex flex-wrap items-center justify-center gap-2 mt-6 p-1.5 bg-slate-100 rounded-2xl border border-slate-200">
            <button
              id="tab-btn-smart"
              type="button"
              onclick="showPlanMockup('smart')"
              class="px-4 sm:px-6 py-2.5 rounded-xl font-black text-xs transition-all cursor-pointer text-slate-600 hover:text-rose-600 flex items-center gap-1.5"
            >
              <span>⭐</span> Plan SMART
            </button>
            <button
              id="tab-btn-pro"
              type="button"
              onclick="showPlanMockup('pro')"
              class="px-4 sm:px-6 py-2.5 rounded-xl font-black text-xs transition-all cursor-pointer bg-emerald-600 text-white shadow-md flex items-center gap-1.5"
            >
              <span>👑</span> Plan PRO <span class="text-[9px] bg-white/20 px-1.5 py-0.5 rounded-md uppercase">Popular</span>
            </button>
            <button
              id="tab-btn-elite"
              type="button"
              onclick="showPlanMockup('elite')"
              class="px-4 sm:px-6 py-2.5 rounded-xl font-black text-xs transition-all cursor-pointer text-slate-600 hover:text-purple-600 flex items-center gap-1.5"
            >
              <span>💎</span> Plan ELITE
            </button>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center max-w-5xl mx-auto">
          
          <!-- LADO IZQUIERDO: EL SMARTPHONE MOCKUP DINÁMICO -->
          <div class="lg:col-span-6 flex justify-center">
            <div class="w-72 sm:w-80 bg-slate-900 rounded-[44px] p-3 shadow-2xl border-4 border-slate-800 text-slate-800 relative">
              <!-- Notch / Dynamic Island -->
              <div class="w-24 h-4 bg-black rounded-full mx-auto mb-2 flex items-center justify-end px-2">
                <div class="w-2 h-2 rounded-full bg-slate-800"></div>
              </div>
              
              <!-- PANTALLA INTERNA DEL TELÉFONO -->
              <div class="bg-white rounded-[32px] p-3.5 space-y-2.5 text-[10px] overflow-hidden min-h-[510px] flex flex-col justify-between" id="phone-screen-container">
                
                <!-- TOP BAR MOCKUP -->
                <div>
                  <div class="flex items-center justify-between border-b border-slate-100 pb-2 mb-2">
                    <div class="flex items-center gap-1.5">
                      <div class="w-5 h-5 rounded-md bg-[#0077FE] text-white flex items-center justify-center font-black text-[9px]">MF</div>
                      <span class="font-black text-[#0B2545] text-xs">MINDFIX</span>
                    </div>
                    <!-- Badge Dinámico del Plan -->
                    <span id="mockup-plan-badge" class="bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-full text-[9px] font-black tracking-wide">
                      👑 Plan PRO
                    </span>
                  </div>

                  <!-- GREETING & MASCOT -->
                  <div id="mockup-greeting-box" class="p-2.5 rounded-2xl flex items-center gap-2.5 transition-colors bg-emerald-50/80 border border-emerald-100">
                    <div class="w-8 h-8 rounded-xl bg-white shadow-xs flex items-center justify-center text-lg shrink-0">
                      🤖
                    </div>
                    <div class="flex-1">
                      <div class="font-black text-[#0B2545] text-xs">¡Hola, Valeria!</div>
                      <div id="mockup-mascot-status" class="text-[9px] text-emerald-800 font-bold">Fixi IA: "Semana 8 de parciales activada"</div>
                    </div>
                  </div>

                  <!-- CONTENIDO DINÁMICO DE CARDS SEGÚN EL PLAN -->
                  <div id="mockup-dynamic-content" class="mt-2.5 space-y-2">
                    <!-- Se inyecta dinámicamente con JavaScript -->
                  </div>
                </div>

                <!-- BOTTOM NAVIGATION BAR DEL MOCKUP -->
                <div class="border-t border-slate-100 pt-2 flex justify-around items-center text-[9px] text-slate-400 font-bold">
                  <div class="flex flex-col items-center text-emerald-600">
                    <span>🏠</span>
                    <span class="text-[8px]">Inicio</span>
