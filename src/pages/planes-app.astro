          infoBadgeClass: 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black uppercase tracking-wider mb-3 bg-purple-100 text-purple-800',
          infoTitle: 'IA Predictiva + Tutoría 1 a 1 con alumnos del Tercio Superior',
          infoDesc: 'Diseñado para alumnos que apuntan a becas, primeros puestos o requieren acompañamiento personalizado intensivo para asegurar las notas más altas.',
          infoFeatures: [
            { included: true, text: '<strong>Todo lo de SMART y PRO incluido:</strong> Apuntes, planificador y comunidad' },
            { included: true, text: '<strong>IA predictiva de exámenes:</strong> Banco predictivo por docente y cátedra' },
            { included: true, text: '<strong>Tutorías 1-on-1 semanales:</strong> Con mentores del Tercio Superior' },
            { included: true, text: '<strong>Copiloto de gestión de estrés:</strong> Monitoreo de sueño REM' },
            { included: true, text: '<strong>Integración de plataformas:</strong> Canvas, Notion y Google Calendar' }
          ],
          ctaText: 'Elegir Plan ELITE con Garantía',
          ctaHref: '/upgrade?plan=elite',
          ctaClass: 'block w-full py-3.5 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-700 text-white font-black text-xs sm:text-sm uppercase tracking-wider text-center shadow-lg shadow-purple-500/25 hover:scale-[1.02] transition-all'
        }
      };

      function showPlanMockup(plan) {
        const data = planData[plan];
        if (!data) return;

        // Reset tabs style
        ['smart', 'pro', 'elite'].forEach((p) => {
          const tab = document.getElementById(`tab-btn-${p}`);
          if (p === plan) {
            tab.className = data.tabClass;
          } else {
            tab.className = 'px-4 sm:px-6 py-2.5 rounded-xl font-black text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] flex items-center gap-1.5';
          }
        });

        // Update Phone Mockup Screen
        const badgeEl = document.getElementById('mockup-plan-badge');
        badgeEl.textContent = data.badgeText;
        badgeEl.className = data.badgeClass;

        const greetingBox = document.getElementById('mockup-greeting-box');
        greetingBox.className = data.greetingBoxClass;

        const mascotStatus = document.getElementById('mockup-mascot-status');
        mascotStatus.textContent = data.mascotText;

        const dynamicContent = document.getElementById('mockup-dynamic-content');
        dynamicContent.innerHTML = data.mockupHtml;

        // Update Info Side Card
        const infoBadge = document.getElementById('info-badge');
        infoBadge.textContent = data.infoBadge;
        infoBadge.className = data.infoBadgeClass;

        document.getElementById('info-title').textContent = data.infoTitle;
        document.getElementById('info-desc').textContent = data.infoDesc;

        const featuresContainer = document.getElementById('info-features-list');
        featuresContainer.innerHTML = data.infoFeatures.map(item => `
          <div class="flex items-start gap-2.5 text-xs text-slate-700">
            <span class="${item.included ? 'text-emerald-500' : 'text-slate-300'} font-black text-sm shrink-0">
              ${item.included ? '✔' : '✖'}
            </span>
            <span>${item.text}</span>
          </div>
        `).join('');

        const ctaBtn = document.getElementById('info-cta-btn');
        ctaBtn.textContent = data.ctaText;
        ctaBtn.href = data.ctaHref;
        ctaBtn.className = data.ctaClass;
      }

      // Inicializar en Plan PRO
      showPlanMockup('pro');

      function switchPricing(mode) {
        const btnMonthly = document.getElementById('toggle-monthly');
        const btnAnnual = document.getElementById('toggle-annual');

        const priceSmart = document.getElementById('card-price-smart');
        const periodSmart = document.getElementById('card-period-smart');

        const pricePro = document.getElementById('card-price-pro');
        const periodPro = document.getElementById('card-period-pro');

        const priceElite = document.getElementById('card-price-elite');
        const periodElite = document.getElementById('card-period-elite');

        if (mode === 'annual') {
          btnAnnual.className = 'px-6 py-2 rounded-full bg-[#E11D48] text-white text-xs sm:text-sm font-black transition-all cursor-pointer shadow-xs flex items-center gap-2';
          btnMonthly.className = 'px-6 py-2 rounded-full text-slate-600 hover:text-[#0B2545] text-xs sm:text-sm font-extrabold transition-all cursor-pointer';

          priceSmart.textContent = 'S/ 14.90';
          periodSmart.textContent = '/mes (anual)';

          pricePro.textContent = 'S/ 7.90';
          periodPro.textContent = '/mes (anual)';

          priceElite.textContent = 'S/ 29.90';
          periodElite.textContent = '/mes (anual)';
        } else {
          btnMonthly.className = 'px-6 py-2 rounded-full bg-[#E11D48] text-white text-xs sm:text-sm font-black transition-all cursor-pointer shadow-xs';
          btnAnnual.className = 'px-6 py-2 rounded-full text-slate-600 hover:text-[#0B2545] text-xs sm:text-sm font-extrabold transition-all cursor-pointer flex items-center gap-2';

          priceSmart.textContent = 'S/ 19.90';
          periodSmart.textContent = '/mes';

          pricePro.textContent = 'S/ 9.90';
          periodPro.textContent = '/mes';

          priceElite.textContent = 'S/ 39.90';
          periodElite.textContent = '/mes';
        }
      }
    </script>
  </body>
</html>
