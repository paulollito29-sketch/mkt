      function dismissDownloadReminder() {
        const reminder = document.getElementById('floating-download-reminder');
        if (reminder) {
          reminder.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
          localStorage.setItem('mindfix_download_dismissed', 'true');
        }
      }

      window.addEventListener('DOMContentLoaded', () => {
        // Mostrar recordatorio tras 6 segundos si no se ha cerrado antes
        setTimeout(() => {
          const isDismissed = localStorage.getItem('mindfix_download_dismissed');
          const reminder = document.getElementById('floating-download-reminder');
          if (reminder && !isDismissed) {
            reminder.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
          }
        }, 6000);
      });
    </script>


