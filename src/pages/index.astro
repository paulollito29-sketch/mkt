    <!-- ==================== MODAL DE INICIAR SESIÓN ==================== -->
    <div
      id="login-modal"
      class="fixed inset-0 z-50 hidden items-center justify-center bg-[#0B2545]/70 backdrop-blur-xs p-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="login-modal-title"
    >
      <div class="bg-white rounded-3xl max-w-md w-full p-8 shadow-2xl border border-slate-100 relative animate-float">
        <button
          type="button"
          id="close-login-modal"
          class="absolute top-5 right-5 w-9 h-9 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center cursor-pointer"
          aria-label="Cerrar ventana de inicio de sesión"
        >
          ✕
        </button>

        <div class="text-center mb-6">
          <span class="inline-block px-3 py-1 rounded-full bg-[#0077FE]/10 text-[#0077FE] text-xs font-extrabold mb-2">
            Portal Universitario MindFix
          </span>
          <h2 id="login-modal-title" class="text-2xl font-extrabold text-[#0B2545]">
            Bienvenida de vuelta
          </h2>
          <p class="text-sm text-slate-500 mt-1">
            Ingresa con tu correo institucional para ver tu mapa de progreso.
          </p>
        </div>

        <form action="/test-diagnostico" method="get" class="space-y-4">
          <input type="hidden" name="utm_source" value="landing" />
          <input type="hidden" name="utm_medium" value="login_modal" />
          <div>
            <label for="student-email" class="block text-xs font-bold uppercase text-[#0B2545] mb-1.5">
              Correo Universitario
            </label>
            <input
              id="student-email"
              type="email"
              required
              placeholder="valeria.rojas@universidad.edu.pe"
              class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm text-[#0B2545] focus:outline-none focus:border-[#0077FE] focus:ring-2 focus:ring-[#0077FE]/20"
            />
          </div>
          <div>
            <label for="student-pass" class="block text-xs font-bold uppercase text-[#0B2545] mb-1.5">
              Contraseña
            </label>
            <input
              id="student-pass"
              type="password"
              required
              placeholder="••••••••"
              class="w-full px-4 py-3 rounded-xl border border-slate-300 text-sm text-[#0B2545] focus:outline-none focus:border-[#0077FE] focus:ring-2 focus:ring-[#0077FE]/20"
            />
          </div>
          <button
            type="submit"
            class="cta-shimmer w-full py-3.5 rounded-xl font-extrabold text-white bg-gradient-to-r from-[#0077FE] to-[#00C2FF] shadow-md hover:opacity-95 transition-opacity cursor-pointer"
          >
            Ingresar a mi Campus IA
          </button>
        </form>

        <div class="mt-6 pt-5 border-t border-slate-100 text-center">
          <p class="text-xs text-slate-500">
            ¿Aún no tienes tu diagnóstico inicial?{" "}
            <a href={heroCtaUrl} class="font-extrabold text-[#0077FE] hover:underline">
              Realizar Test Gratuito →
            </a>
          </p>
        </div>
      </div>
    </div>

    <!-- ==================== MOTOR DE ANIMACIONES & INTERACTIVIDAD ==================== -->
    <script is:inline>
      // 1. Menú móvil y Modal
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileLinks = document.querySelectorAll('.mobile-nav-link');

      if (mobileBtn && mobileMenu) {
        mobileBtn.addEventListener('click', () => {
          const isHidden = mobileMenu.classList.contains('hidden');
          mobileMenu.classList.toggle('hidden', !isHidden);
          mobileBtn.setAttribute('aria-expanded', String(isHidden));
        });

        mobileLinks.forEach((link) => {
          link.addEventListener('click', () => {
            mobileMenu.classList.add('hidden');
            mobileBtn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      const openLoginBtn = document.getElementById('open-login-modal');
      const closeLoginBtn = document.getElementById('close-login-modal');
      const loginModal = document.getElementById('login-modal');

      if (openLoginBtn && closeLoginBtn && loginModal) {
        openLoginBtn.addEventListener('click', () => {
          loginModal.classList.remove('hidden');
          loginModal.classList.add('flex');
        });
        closeLoginBtn.addEventListener('click', () => {
          loginModal.classList.add('hidden');
          loginModal.classList.remove('flex');
        });
        loginModal.addEventListener('click', (e) => {
          if (e.target === loginModal) {
            loginModal.classList.add('hidden');
            loginModal.classList.remove('flex');
          }
        });
      }

      // 2. Barra de progreso de lectura superior + sombra dinámica en Navbar
      const scrollProgress = document.getElementById('scroll-progress');
      const navbar = document.getElementById('main-navbar');

      window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        if (scrollProgress) {
          scrollProgress.style.width = `${progress}%`;
        }
        if (navbar) {
          navbar.classList.toggle('shadow-md', scrollTop > 20);
        }
      }, { passive: true });

      // 3. IntersectionObserver para Scroll Reveal, Contadores Numéricos y Barras de Progreso
      const animateCounter = (el) => {
        const target = parseInt(el.getAttribute('data-target') || '0', 10);
        const duration = 1600;
        const startTime = performance.now();

        const step = (now) => {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const easeOut = 1 - Math.pow(1 - progress, 3);
          const current = Math.floor(easeOut * target);
          el.textContent = current.toLocaleString('es-PE');
          if (progress < 1) {
            requestAnimationFrame(step);
          } else {
            el.textContent = target.toLocaleString('es-PE');
          }
        };
        requestAnimationFrame(step);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('reveal-visible');

              // Si contiene barras de progreso, animarlas
              const bars = entry.target.querySelectorAll('.progress-fill');
              bars.forEach((bar) => {
                const targetWidth = bar.getAttribute('data-width') || '100%';
                setTimeout(() => {
                  bar.style.width = targetWidth;
                }, 200);
              });

              // Si contiene contadores numéricos, animarlos
              const counters = entry.target.querySelectorAll('.counter');
              counters.forEach((counter) => {
                if (!counter.dataset.animated) {
                  counter.dataset.animated = 'true';
                  animateCounter(counter);
                }
              });
            }
          });
        },
        { threshold: 0.14 }
      );

      document
        .querySelectorAll('.reveal-up, .reveal-left, .reveal-right')
        .forEach((el) => observer.observe(el));

      // 4. Efecto Spotlight Radial en Tarjetas Interactivas
      document.querySelectorAll('.interactive-card').forEach((card) => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });
      });
    </script>
  </body>
</html>
