---
import '../styles/global.css';

const heroCtaUrl = "/test-diagnostico?utm_source=landing&utm_medium=cta_hero&utm_campaign=mindfix_cro";
const finalCtaUrl = "/test-diagnostico?utm_source=landing&utm_medium=cta_footer&utm_campaign=mindfix_cro";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MindFix — Estudia mejor, llega más lejos | Diagnóstico IA y Mentoría P2P Universitaria</title>
    <meta
      name="description"
      content="Ecosistema educativo P2P potenciado por Inteligencia Artificial que diagnostica tus vacíos de aprendizaje en minutos y te conecta con mentores pares y rutas personalizadas."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="MindFix — Estudia mejor, llega más lejos" />
    <meta
      property="og:description"
      content="¿Estudias horas y tus notas no suben? Identifica tus vacíos de aprendizaje en minutos con IA y mentores pares."
    />
    <meta property="og:image" content="/images/hero-valeria-mindfix.webp" />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#FFFFFF] text-[#0B2545] antialiased selection:bg-[#0077FE] selection:text-white overflow-x-hidden">
    <!-- Barra de Progreso de Lectura Superior -->
    <div class="fixed top-0 left-0 right-0 h-1 z-[60] bg-transparent pointer-events-none">
      <div
        id="scroll-progress"
        class="h-full w-0 bg-gradient-to-r from-[#0077FE] via-[#00A3FF] to-[#00C2FF] shadow-[0_0_12px_rgba(0,194,255,0.8)] transition-[width] duration-100"
      ></div>
    </div>

    <!-- ==================== NAVBAR ==================== -->
    <header
      id="main-navbar"
      class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-xl border-b border-slate-200/80 transition-all duration-300"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <!-- Brand Wordmark (Sin ícono de logo) -->
        <a
          href="/"
          class="group flex flex-col focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077FE] rounded-xl p-1"
          aria-label="MindFix - Ir al inicio"
        >
          <div class="text-2xl font-extrabold tracking-tight leading-none">
            <span class="text-[#0B2545]">MIND</span><span class="text-[#0077FE] group-hover:text-[#00A3FF] transition-colors">FIX</span>
          </div>
          <span class="text-[11px] font-semibold text-slate-500 tracking-tight mt-0.5">
            Estudia mejor, llega más lejos
          </span>
        </a>

        <!-- Desktop Navigation Links con indicador inferior animado -->
        <nav class="hidden md:flex items-center gap-6 lg:gap-7" aria-label="Navegación principal">
          <a
            href="#como-funciona"
            class="relative py-1 text-sm font-semibold text-[#0B2545]/80 hover:text-[#0077FE] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#0077FE] after:transition-all after:duration-300 hover:after:w-full"
          >
            Cómo funciona
          </a>
          <a
            href="#que-lograras"
            class="relative py-1 text-sm font-semibold text-[#0B2545]/80 hover:text-[#0077FE] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#0077FE] after:transition-all after:duration-300 hover:after:w-full"
          >
            Qué lograrás
          </a>
          <a
            href="#diagnostico-ia"
            class="relative py-1 text-sm font-semibold text-[#0B2545]/80 hover:text-[#0077FE] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#0077FE] after:transition-all after:duration-300 hover:after:w-full"
          >
            Diagnóstico IA
          </a>
          <a
            href="#comunidad-p2p"
            class="relative py-1 text-sm font-semibold text-[#0B2545]/80 hover:text-[#0077FE] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#0077FE] after:transition-all after:duration-300 hover:after:w-full"
          >
            Comunidad P2P
          </a>
          <a
            href="#testimonios"
            class="relative py-1 text-sm font-semibold text-[#0B2545]/80 hover:text-[#0077FE] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#0077FE] after:transition-all after:duration-300 hover:after:w-full"
          >
            Testimonios
          </a>
          <a
            href="/blog"
            class="relative py-1 text-sm font-semibold text-[#0B2545]/70 hover:text-[#0077FE] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#0077FE] after:transition-all after:duration-300 hover:after:w-full"
          >
            Blog
          </a>
        </nav>

        <!-- Secondary Action Button + Mobile Menu Trigger -->
        <div class="flex items-center gap-3">
          <button
            type="button"
            id="open-login-modal"
            class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-bold text-[#0B2545] bg-white border-2 border-[#0B2545]/15 rounded-xl hover:border-[#0077FE] hover:text-[#0077FE] hover:bg-[#F8FAFC] hover:-translate-y-0.5 hover:shadow-md transition-all duration-200 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077FE]"
          >
            Iniciar Sesión
          </button>

          <button
            type="button"
            id="mobile-menu-btn"
            class="md:hidden inline-flex items-center justify-center p-2.5 rounded-xl text-[#0B2545] hover:bg-[#F1F5F9] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077FE]"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Abrir menú de navegación"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div
        id="mobile-menu"
        class="hidden md:hidden bg-white border-b border-slate-200 px-4 pt-3 pb-6 space-y-3 shadow-lg"
      >
        <a
          href="#como-funciona"
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-[#0B2545] hover:bg-[#F1F5F9] hover:text-[#0077FE]"
        >
          Cómo funciona
        </a>
        <a
          href="#que-lograras"
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-[#0B2545] hover:bg-[#F1F5F9] hover:text-[#0077FE]"
        >
          Qué lograrás
        </a>
        <a
          href="#diagnostico-ia"
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-[#0B2545] hover:bg-[#F1F5F9] hover:text-[#0077FE]"
        >
          Diagnóstico IA
        </a>
        <a
          href="#comunidad-p2p"
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-[#0B2545] hover:bg-[#F1F5F9] hover:text-[#0077FE]"
        >
          Comunidad P2P
        </a>
        <a
          href="#testimonios"
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-[#0B2545] hover:bg-[#F1F5F9] hover:text-[#0077FE]"
        >
          Testimonios
        </a>
        <a
          href="/blog"
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-[#0B2545] hover:bg-[#F1F5F9] hover:text-[#0077FE]"
        >
          Blog Académico
        </a>
        <div class="pt-2">
          <a
            href={heroCtaUrl}
            class="cta-shimmer w-full inline-flex items-center justify-center px-6 py-3.5 text-base font-bold text-white rounded-xl bg-gradient-to-r from-[#0077FE] to-[#00C2FF] shadow-md"
          >
            Realizar Test Gratuito
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- ==================== SECCIÓN HERO ==================== -->
      <section class="relative overflow-hidden bg-[#FFFFFF] pt-8 pb-16 sm:pt-14 sm:pb-24 lg:pt-16 lg:pb-28">
        <!-- Esferas de luz animadas de fondo -->
        <div
          class="animate-blob pointer-events-none absolute -top-20 right-10 w-[480px] h-[480px] rounded-full bg-gradient-to-br from-[#0077FE]/15 via-[#00C2FF]/12 to-transparent blur-3xl"
          aria-hidden="true"
        ></div>
        <div
          class="animate-blob-delayed pointer-events-none absolute bottom-0 -left-16 w-[420px] h-[420px] rounded-full bg-gradient-to-tr from-[#0B2545]/8 via-[#0077FE]/10 to-transparent blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
            <!-- Columna Izquierda: Copy Persuasivo & CTA Principal -->
            <div class="lg:col-span-6 text-left reveal-left">
              <!-- Badge Superior con indicador vivo -->
              <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-[#F1F5F9] border border-[#0077FE]/25 text-[#0B2545] text-xs sm:text-sm font-bold mb-6 shadow-xs hover:border-[#0077FE] transition-colors">
                <span class="relative flex h-2.5 w-2.5">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#0077FE] opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-[#0077FE]"></span>
                </span>
                <span>🚀 Nueva forma de aprender en la universidad con IA</span>
              </div>

              <!-- Título H1 Persuasivo con Gradiente en Movimiento -->
              <h1 class="text-3xl sm:text-4xl lg:text-[2.75rem] xl:text-5xl font-extrabold text-[#0B2545] tracking-tight leading-[1.14] mb-6">
                ¿Estudias horas y tus notas no suben?{" "}
                <span class="animate-gradient-text text-transparent bg-clip-text bg-gradient-to-r from-[#0077FE] via-[#00C2FF] to-[#0077FE]">
                  Identifica tus vacíos de aprendizaje en minutos
                </span>
              </h1>

              <!-- Subtítulo -->
              <p class="text-base sm:text-lg lg:text-xl text-slate-600 leading-relaxed mb-8 max-w-2xl">
                MindFix analiza tus evaluaciones, detecta los conceptos exactos que necesitas reforzar y te conecta con estudiantes destacados que ya dominan tu carrera. <strong class="font-semibold text-[#0B2545]">Deja de memorizar a ciegas.</strong>
              </p>

              <!-- Botón CTA Hero con pulso y destello + Microtexto de Confianza -->
              <div class="flex flex-col sm:items-start gap-3.5">
                <a
                  href={heroCtaUrl}
                  class="cta-shimmer animate-cta-pulse group relative inline-flex items-center justify-center gap-3 w-full sm:w-auto px-8 py-4 sm:px-10 sm:py-5 text-base sm:text-lg font-extrabold text-white rounded-2xl bg-gradient-to-r from-[#0077FE] to-[#00C2FF] hover:scale-[1.03] active:scale-[0.99] transition-all duration-300 focus:outline-none focus-visible:ring-4 focus-visible:ring-[#0077FE]/40"
                >
                  <span>Realizar Test Gratuito</span>
                  <svg
                    class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1.5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </a>

                <p class="text-xs sm:text-sm font-semibold text-slate-600 flex flex-wrap items-center gap-x-2 gap-y-1 pl-1">
                  <span class="text-[#0077FE] font-bold">✓ 100% gratuito</span>
                  <span aria-hidden="true">·</span>
                  <span>Resultados en 3 minutos</span>
                  <span aria-hidden="true">·</span>
                  <span>Sin tarjeta de crédito</span>
                </p>
              </div>

              <!-- Mini Social Proof Universitaria con Contador Animado -->
              <div class="mt-9 pt-7 border-t border-slate-100 flex flex-wrap items-center gap-6">
                <div class="flex -space-x-2.5 overflow-hidden">
                  <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#0B2545] text-white text-xs font-bold ring-2 ring-white hover:-translate-y-1 transition-transform">VR</span>
                  <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#0077FE] text-white text-xs font-bold ring-2 ring-white hover:-translate-y-1 transition-transform">DM</span>
                  <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#0E1B2E] text-white text-xs font-bold ring-2 ring-white hover:-translate-y-1 transition-transform">CP</span>
                  <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#00A3FF] text-white text-xs font-bold ring-2 ring-white">+2k</span>
                </div>
                <div class="text-xs sm:text-sm text-slate-600">
                  <span class="font-extrabold text-[#0B2545]">+<span class="counter" data-target="2400">0</span> universitarios</span> ya subieron al tercio superior sin amanecidas.
                </div>
              </div>
            </div>

            <!-- Columna Derecha: Imagen 1 (Valeria) con Levitación y Escaneo IA -->
            <div class="lg:col-span-6 relative reveal-right">
              <div class="relative mx-auto max-w-xl lg:max-w-none group">
                <!-- Halo luminoso animado detrás de la imagen -->
                <div
                  class="animate-blob absolute -inset-3 rounded-3xl bg-gradient-to-tr from-[#0B2545]/15 via-[#0077FE]/25 to-[#00C2FF]/25 blur-xl opacity-85 group-hover:opacity-100 transition-opacity"
                  aria-hidden="true"
                ></div>

                <div class="relative rounded-3xl overflow-hidden border border-slate-200/90 bg-[#0E1B2E] shadow-2xl">
                  <!-- Línea sutil de escaneo IA -->
                  <div
                    class="scan-beam pointer-events-none absolute left-0 right-0 h-12 bg-gradient-to-b from-transparent via-[#00C2FF]/20 to-transparent z-10"
                    aria-hidden="true"
                  ></div>

                  <img
                    src="/images/hero-valeria-mindfix.webp"
                    alt="Valeria Rojas, estudiante universitaria latinoamericana de 20 años en su escritorio sosteniendo una tableta con gráficos de progreso académico de MindFix y expresión de confianza"
                    width="1200"
                    height="800"
                    loading="eager"
                    fetchpriority="high"
                    class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
                  />

                  <div class="absolute inset-0 bg-gradient-to-t from-[#0B2545]/50 via-transparent to-transparent pointer-events-none"></div>
                </div>

                <!-- Badge Flotante Superior Animado: Diagnóstico IA -->
                <div class="animate-float hidden sm:flex items-center gap-3 absolute -top-6 -left-6 z-20 bg-white/95 backdrop-blur-md px-4 py-3.5 rounded-2xl shadow-xl border border-[#0077FE]/20">
                  <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#0077FE] to-[#00C2FF] text-white flex items-center justify-center shrink-0 shadow-md">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                  <div>
                    <div class="flex items-center gap-1.5">
                      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
                      <p class="text-[11px] font-bold uppercase tracking-wider text-[#0077FE]">Diagnóstico IA Activo</p>
                    </div>
                    <p class="text-xs font-extrabold text-[#0B2545]">3 vacíos detectados en Cálculo II</p>
                  </div>
                </div>

                <!-- Badge Flotante Inferior Animado: Progreso Tercio Superior -->
                <div class="animate-float-delayed flex items-center gap-3.5 sm:absolute -bottom-6 -right-5 z-20 mt-4 sm:mt-0 bg-[#0B2545] text-white px-5 py-4 rounded-2xl shadow-2xl border border-[#00A3FF]/40">
                  <div class="w-11 h-11 rounded-xl bg-[#00A3FF]/20 text-[#00C2FF] flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                  </div>
                  <div class="min-w-[190px]">
                    <div class="flex items-center justify-between text-[11px] font-semibold text-[#00C2FF] mb-1">
                      <span>Progreso de Valeria</span>
                      <span>Tercio Superior</span>
                    </div>
                    <p class="text-xs sm:text-sm font-extrabold text-white mb-1.5">Promedio: 11.4 → 16.2</p>
                    <div class="w-full h-1.5 bg-white/15 rounded-full overflow-hidden">
                      <div class="progress-fill h-full bg-gradient-to-r from-[#0077FE] to-[#00C2FF] rounded-full" data-width="84%"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ==================== SECCIÓN DE PROBLEMÁTICA (DOLORES DE VALERIA) ==================== -->
      <section id="problematica" class="bg-[#F8FAFC] py-20 sm:py-24 border-y border-slate-200/70">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl mx-auto text-center mb-14 sm:mb-16 reveal-up">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-[#0B2545]/8 text-[#0B2545] mb-4">
              El verdadero obstáculo académico
            </span>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0B2545] tracking-tight leading-tight mb-4">
              El problema no es tu capacidad, es estudiar sin una brújula conceptual
            </h2>
            <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
              Miles de universitarios autoexigentes invierten decenas de horas repasando temas que ya saben, mientras el verdadero vacío base sigue oculto hasta el día del parcial.
            </p>
          </div>

          <!-- Grid de 3 Tarjetas Interactivas con Efecto Spotlight y Movimiento -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Tarjeta 1 -->
            <article
              class="interactive-card reveal-up group bg-white rounded-3xl p-8 border border-slate-200/80 shadow-xs hover:shadow-2xl hover:border-[#0077FE]/50 hover:-translate-y-2 flex flex-col justify-between"
              style="transition-delay: 80ms;"
            >
              <div class="relative z-10">
                <div class="w-14 h-14 rounded-2xl bg-[#0B2545] text-[#00C2FF] flex items-center justify-center mb-6 shadow-md group-hover:bg-gradient-to-br group-hover:from-[#0077FE] group-hover:to-[#00C2FF] group-hover:text-white group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-extrabold text-[#0B2545] mb-3 group-hover:text-[#0077FE] transition-colors">
                  El examen no te dice en qué fallaste
                </h3>
                <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
                  Notas numéricas que no explican tus vacíos. Recibir un <span class="font-bold text-rose-600 bg-rose-50 px-1.5 py-0.5 rounded">08/20</span> no te revela si fallaste en el planteamiento físico, en una derivada previa o en el concepto base.
                </p>
              </div>
              <div class="relative z-10 mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-slate-400">
                <span>Feedback tradicional</span>
                <span class="text-rose-500 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span> 0% Diagnóstico
                </span>
              </div>
            </article>

            <!-- Tarjeta 2 -->
            <article
              class="interactive-card reveal-up group bg-white rounded-3xl p-8 border border-slate-200/80 shadow-xs hover:shadow-2xl hover:border-[#0077FE]/50 hover:-translate-y-2 flex flex-col justify-between"
              style="transition-delay: 180ms;"
            >
              <div class="relative z-10">
                <div class="w-14 h-14 rounded-2xl bg-[#0B2545] text-[#00C2FF] flex items-center justify-center mb-6 shadow-md group-hover:bg-gradient-to-br group-hover:from-[#0077FE] group-hover:to-[#00C2FF] group-hover:text-white group-hover:scale-110 group-hover:-rotate-3 transition-all duration-300">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-extrabold text-[#0B2545] mb-3 group-hover:text-[#0077FE] transition-colors">
                  Amanecidas que sabotean tu memoria
                </h3>
                <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
                  Horas de estudio que solo generan fatiga cognitiva. Estudiar de madrugada sin foco bloquea tu corteza prefrontal y provoca que te quedes en blanco frente al examen.
                </p>
              </div>
              <div class="relative z-10 mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-slate-400">
                <span>Retención sin dormir</span>
                <span class="text-amber-600 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span> Fatiga Crítica
                </span>
              </div>
            </article>

            <!-- Tarjeta 3 -->
            <article
