---
import '../styles/global.css';

const heroCtaUrl = "/test-diagnostico?utm_source=landing&utm_medium=cta_hero&utm_campaign=mindfix_cro";
const finalCtaUrl = "/test-diagnostico?utm_source=landing&utm_medium=cta_footer&utm_campaign=mindfix_cro";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MindFix — Estudia mejor, llega más lejos | Diagnóstico IA y Mentoría P2P Universitaria</title>
    <meta
      name="description"
      content="Ecosistema educativo P2P potenciado por Inteligencia Artificial que diagnostica tus vacíos de aprendizaje en minutos y te conecta con mentores pares y rutas personalizadas."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="MindFix — Estudia mejor, llega más lejos" />
    <meta
      property="og:description"
      content="¿Estudias horas y tus notas no suben? Identifica tus vacíos de aprendizaje en minutos con IA y mentores pares."
    />
    <meta property="og:image" content="/images/hero-valeria-mindfix.webp" />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="bg-[#FFFFFF] text-[#0B2545] antialiased selection:bg-[#0077FE] selection:text-white overflow-x-hidden">
    <!-- Barra de Progreso de Lectura Superior -->
    <div class="fixed top-0 left-0 right-0 h-1 z-[60] bg-transparent pointer-events-none">
      <div
        id="scroll-progress"
        class="h-full w-0 bg-gradient-to-r from-[#0077FE] via-[#00A3FF] to-[#00C2FF] shadow-[0_0_12px_rgba(0,194,255,0.8)] transition-[width] duration-100"
      ></div>
    </div>

    <!-- ==================== NAVBAR ==================== -->
    <header
      id="main-navbar"
      class="sticky top-0 z-50 w-full bg-white/90 backdrop-blur-xl border-b border-slate-200/80 transition-all duration-300"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <!-- Brand Wordmark (Sin ícono de logo) -->
        <a
          href="/"
          class="group flex flex-col focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077FE] rounded-xl p-1"
          aria-label="MindFix - Ir al inicio"
        >
          <div class="text-2xl font-extrabold tracking-tight leading-none">
            <span class="text-[#0B2545]">MIND</span><span class="text-[#0077FE] group-hover:text-[#00A3FF] transition-colors">FIX</span>
          </div>
          <span class="text-[11px] font-semibold text-slate-500 tracking-tight mt-0.5">
            Estudia mejor, llega más lejos
          </span>
        </a>

        <!-- Desktop Navigation Links con indicador inferior animado -->
        <nav class="hidden md:flex items-center gap-6 lg:gap-7" aria-label="Navegación principal">
          <a
            href="#como-funciona"
            class="relative py-1 text-sm font-semibold text-[#0B2545]/80 hover:text-[#0077FE] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#0077FE] after:transition-all after:duration-300 hover:after:w-full"
          >
            Cómo funciona
          </a>
          <a
            href="#que-lograras"
            class="relative py-1 text-sm font-semibold text-[#0B2545]/80 hover:text-[#0077FE] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#0077FE] after:transition-all after:duration-300 hover:after:w-full"
          >
            Qué lograrás
          </a>
          <a
            href="#diagnostico-ia"
            class="relative py-1 text-sm font-semibold text-[#0B2545]/80 hover:text-[#0077FE] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#0077FE] after:transition-all after:duration-300 hover:after:w-full"
          >
            Diagnóstico IA
          </a>
          <a
            href="#comunidad-p2p"
            class="relative py-1 text-sm font-semibold text-[#0B2545]/80 hover:text-[#0077FE] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#0077FE] after:transition-all after:duration-300 hover:after:w-full"
          >
            Comunidad P2P
          </a>
          <a
            href="#testimonios"
            class="relative py-1 text-sm font-semibold text-[#0B2545]/80 hover:text-[#0077FE] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#0077FE] after:transition-all after:duration-300 hover:after:w-full"
          >
            Testimonios
          </a>
          <a
            href="/blog"
            class="relative py-1 text-sm font-semibold text-[#0B2545]/70 hover:text-[#0077FE] transition-colors after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-[#0077FE] after:transition-all after:duration-300 hover:after:w-full"
          >
            Blog
          </a>
        </nav>

        <!-- Secondary Action Button + Mobile Menu Trigger -->
        <div class="flex items-center gap-3">
          <button
            type="button"
            id="open-login-modal"
            class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-bold text-[#0B2545] bg-white border-2 border-[#0B2545]/15 rounded-xl hover:border-[#0077FE] hover:text-[#0077FE] hover:bg-[#F8FAFC] hover:-translate-y-0.5 hover:shadow-md transition-all duration-200 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077FE]"
          >
            Iniciar Sesión
          </button>

          <button
            type="button"
            id="mobile-menu-btn"
            class="md:hidden inline-flex items-center justify-center p-2.5 rounded-xl text-[#0B2545] hover:bg-[#F1F5F9] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0077FE]"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Abrir menú de navegación"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div
        id="mobile-menu"
        class="hidden md:hidden bg-white border-b border-slate-200 px-4 pt-3 pb-6 space-y-3 shadow-lg"
      >
        <a
          href="#como-funciona"
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-[#0B2545] hover:bg-[#F1F5F9] hover:text-[#0077FE]"
        >
          Cómo funciona
        </a>
        <a
          href="#que-lograras"
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-[#0B2545] hover:bg-[#F1F5F9] hover:text-[#0077FE]"
        >
          Qué lograrás
        </a>
        <a
          href="#diagnostico-ia"
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-[#0B2545] hover:bg-[#F1F5F9] hover:text-[#0077FE]"
        >
          Diagnóstico IA
        </a>
        <a
          href="#comunidad-p2p"
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-[#0B2545] hover:bg-[#F1F5F9] hover:text-[#0077FE]"
        >
          Comunidad P2P
        </a>
        <a
          href="#testimonios"
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-[#0B2545] hover:bg-[#F1F5F9] hover:text-[#0077FE]"
        >
          Testimonios
        </a>
        <a
          href="/blog"
          class="mobile-nav-link block px-3 py-2.5 rounded-lg text-base font-semibold text-[#0B2545] hover:bg-[#F1F5F9] hover:text-[#0077FE]"
        >
          Blog Académico
        </a>
        <div class="pt-2">
          <a
            href={heroCtaUrl}
            class="cta-shimmer w-full inline-flex items-center justify-center px-6 py-3.5 text-base font-bold text-white rounded-xl bg-gradient-to-r from-[#0077FE] to-[#00C2FF] shadow-md"
          >
            Realizar Test Gratuito
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- ==================== SECCIÓN HERO (EDITORIAL 100% FULL-VIEWPORT + BOTÓN DE TEST) ==================== -->
      <section class="relative min-h-[calc(100vh-5rem)] flex flex-col justify-between bg-[#0B1528] text-white overflow-hidden border-b border-slate-800">
        
        <!-- Imagen de fondo a pantalla completa: Chica abrumada estudiando de madrugada -->
        <div class="absolute inset-0 z-0">
          <img
            src="/images/blog/hero-trampa-6-horas.jpg"
            alt="Estudiante universitaria saturada y agotada frente a montones de libros y apuntes en su escritorio de noche"
            class="w-full h-full object-cover object-center scale-105 filter brightness-[0.42] contrast-[1.12]"
            loading="eager"
            fetchpriority="high"
          />
          <!-- Gradientes cinematográficos para lectura impecable y atmósfera editorial -->
          <div class="absolute inset-0 bg-gradient-to-r from-[#070D18]/95 via-[#070D18]/80 to-[#070D18]/45"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-[#070D18] via-transparent to-black/30"></div>
          
          <!-- Luces de acento dinámicas -->
          <div class="pointer-events-none absolute -top-24 left-1/4 w-[500px] h-[500px] rounded-full bg-[#0077FE]/15 blur-3xl"></div>
          <div class="pointer-events-none absolute bottom-10 right-10 w-[450px] h-[450px] rounded-full bg-[#00C2FF]/10 blur-3xl"></div>
        </div>

        <!-- Contenedor Principal (100% ancho y centrado vertical) -->
        <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12 pb-8 flex-1 flex flex-col justify-center">
          
          <!-- Top Badge Editorial -->
          <div class="flex flex-wrap items-center gap-3 mb-6">
            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs font-bold uppercase tracking-wider text-[#00C2FF]">
              <span class="w-2 h-2 rounded-full bg-[#00C2FF] animate-ping"></span>
              Crónica de Portada • Metodología & Neurociencia
            </span>
            <span class="text-xs text-slate-300 font-medium hidden sm:inline">
              Tiempo de lectura: 7 min
            </span>
          </div>

          <!-- Título Principal Tipo Revista/Blog Editorial -->
          <div class="max-w-3xl">
            <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.4rem] font-extrabold tracking-tight leading-[1.12] mb-6 text-white">
              La trampa de las 6 horas:{" "}
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#00C2FF] to-white">
                Por qué estudiar más tiempo no está subiendo tus notas
              </span>
            </h1>

            <p class="text-lg sm:text-xl text-slate-200 font-serif leading-relaxed mb-6 italic max-w-2xl border-l-2 border-[#00C2FF] pl-4">
              "Son las 3:15 a.m. Tienes los ojos irritados, tres tazas de café vacías en el escritorio y las diapositivas repasadas tres veces. Sientes que lo sabes todo... hasta que llega el examen y la mente se te queda en blanco."
            </p>

            <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-8 max-w-2xl">
              Tener notas bajas a pesar de pasar la noche entera frente a los libros no es un problema de inteligencia: es una falla en el método de codificación neuronal. Detecta tus vacíos conceptuales y cambia el esfuerzo bruto por aprendizaje estratégico.
            </p>

            <!-- Acciones Principales: Botón de Realizar Test + Botón de Leer Ensayo -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-6">
              <!-- BOTÓN PRINCIPAL: REALIZAR TEST DIAGNÓSTICO -->
              <a
                href={heroCtaUrl}
                class="cta-shimmer animate-cta-pulse group relative inline-flex items-center justify-center gap-3 px-8 py-4 sm:px-9 sm:py-4 text-base sm:text-lg font-extrabold text-white rounded-2xl bg-gradient-to-r from-[#0077FE] to-[#00C2FF] hover:scale-[1.03] active:scale-[0.99] transition-all duration-300 shadow-[0_12px_32px_rgba(0,119,254,0.45)] focus:outline-none focus-visible:ring-4 focus-visible:ring-[#0077FE]/50"
              >
                <span>Realizar Test Diagnóstico Gratuito</span>
                <svg
                  class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>

              <!-- Botón Secundario: Leer Artículo Completo -->
              <a
                href="/blog/la-trampa-de-las-6-horas"
                class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-white/10 hover:bg-white/15 backdrop-blur-md border border-white/20 text-white font-bold text-base transition-all duration-200"
              >
                <span>Leer artículo completo</span>
                <span aria-hidden="true">→</span>
              </a>
            </div>

            <!-- Microtexto de Confianza del Test -->
            <p class="text-xs sm:text-sm font-semibold text-slate-300 flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="text-[#00C2FF] font-bold">✓ 100% gratuito</span>
              <span class="text-slate-500" aria-hidden="true">·</span>
              <span>Resultados en 3 minutos</span>
              <span class="text-slate-500" aria-hidden="true">·</span>
              <span>Diagnóstico IA de vacíos conceptuales</span>
            </p>
          </div>

        </div>

        <!-- Tira Inferior del Hero (100% ancho con artículos recomendados) -->
        <div class="relative z-10 w-full bg-black/40 backdrop-blur-xl border-t border-white/10 py-4 sm:py-5">
          <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between mb-3 text-xs font-bold uppercase tracking-wider text-slate-400">
              <span class="flex items-center gap-2 text-white">
                <span class="w-1.5 h-1.5 rounded-full bg-[#0077FE]"></span>
                Ensayos y lecturas recomendadas del blog
              </span>
              <a href="/blog" class="text-[#00C2FF] hover:underline normal-case font-semibold">
                Ver todos (4) →
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4">
              
              <a href="/blog/por-que-un-companero-te-explica-mejor-que-el-profesor-aprendizaje-p2p" class="flex items-center gap-3.5 p-2.5 sm:p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 transition-colors group">
                <div class="w-12 h-12 rounded-lg overflow-hidden shrink-0 bg-slate-800">
                  <img src="/images/blog/hero-aprendizaje-p2p.jpg" alt="Aprendizaje P2P" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
                </div>
                <div class="min-w-0">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-[#00C2FF]">Tutorías P2P</span>
                  <p class="text-xs font-bold text-white leading-snug truncate group-hover:text-[#00C2FF] transition-colors">
                    ¿Por qué un compañero te explica mejor?
                  </p>
                </div>
              </a>

              <a href="/blog/amanecidas-pre-parciales-estres-ansiedad-examenes" class="flex items-center gap-3.5 p-2.5 sm:p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 transition-colors group">
                <div class="w-12 h-12 rounded-lg overflow-hidden shrink-0 bg-slate-800">
                  <img src="/images/blog/hero-amanecidas-insomnio.jpg" alt="Amanecidas" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
                </div>
                <div class="min-w-0">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-[#00C2FF]">Neurociencia</span>
                  <p class="text-xs font-bold text-white leading-snug truncate group-hover:text-[#00C2FF] transition-colors">
                    Amanecidas pre-parciales: Por qué sabotea tu memoria
                  </p>
                </div>
              </a>

              <a href="/blog/saque-08-y-no-se-en-que-falle" class="flex items-center gap-3.5 p-2.5 sm:p-3 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 transition-colors group">
                <div class="w-12 h-12 rounded-lg overflow-hidden shrink-0 bg-slate-800">
                  <img src="/images/blog/hero-auditoria-examen.jpg" alt="Auditoría" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
                </div>
                <div class="min-w-0">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-[#00C2FF]">Auditoría Forense</span>
                  <p class="text-xs font-bold text-white leading-snug truncate group-hover:text-[#00C2FF] transition-colors">
                    ¿Saqué 08 y no sé en qué fallé?: Guía práctica
                  </p>
                </div>
              </a>

            </div>
          </div>
        </div>

      </section>

      <!-- ==================== SECCIÓN DE PROBLEMÁTICA (DOLORES DE VALERIA) ==================== -->
      <section id="problematica" class="bg-[#F8FAFC] py-20 sm:py-24 border-y border-slate-200/70">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl mx-auto text-center mb-14 sm:mb-16 reveal-up">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-extrabold uppercase tracking-wider bg-[#0B2545]/8 text-[#0B2545] mb-4">
              El verdadero obstáculo académico
            </span>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#0B2545] tracking-tight leading-tight mb-4">
              El problema no es tu capacidad, es estudiar sin una brújula conceptual
            </h2>
            <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
              Miles de universitarios autoexigentes invierten decenas de horas repasando temas que ya saben, mientras el verdadero vacío base sigue oculto hasta el día del parcial.
            </p>
          </div>

          <!-- Grid de 3 Tarjetas Interactivas con Efecto Spotlight y Movimiento -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Tarjeta 1 -->
            <article
              class="interactive-card reveal-up group bg-white rounded-3xl p-8 border border-slate-200/80 shadow-xs hover:shadow-2xl hover:border-[#0077FE]/50 hover:-translate-y-2 flex flex-col justify-between"
              style="transition-delay: 80ms;"
            >
              <div class="relative z-10">
                <div class="w-14 h-14 rounded-2xl bg-[#0B2545] text-[#00C2FF] flex items-center justify-center mb-6 shadow-md group-hover:bg-gradient-to-br group-hover:from-[#0077FE] group-hover:to-[#00C2FF] group-hover:text-white group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-extrabold text-[#0B2545] mb-3 group-hover:text-[#0077FE] transition-colors">
                  El examen no te dice en qué fallaste
                </h3>
                <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
                  Notas numéricas que no explican tus vacíos. Recibir un <span class="font-bold text-rose-600 bg-rose-50 px-1.5 py-0.5 rounded">08/20</span> no te revela si fallaste en el planteamiento físico, en una derivada previa o en el concepto base.
                </p>
              </div>
              <div class="relative z-10 mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-slate-400">
                <span>Feedback tradicional</span>
                <span class="text-rose-500 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span> 0% Diagnóstico
                </span>
              </div>
            </article>

            <!-- Tarjeta 2 -->
            <article
              class="interactive-card reveal-up group bg-white rounded-3xl p-8 border border-slate-200/80 shadow-xs hover:shadow-2xl hover:border-[#0077FE]/50 hover:-translate-y-2 flex flex-col justify-between"
              style="transition-delay: 180ms;"
            >
              <div class="relative z-10">
                <div class="w-14 h-14 rounded-2xl bg-[#0B2545] text-[#00C2FF] flex items-center justify-center mb-6 shadow-md group-hover:bg-gradient-to-br group-hover:from-[#0077FE] group-hover:to-[#00C2FF] group-hover:text-white group-hover:scale-110 group-hover:-rotate-3 transition-all duration-300">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-extrabold text-[#0B2545] mb-3 group-hover:text-[#0077FE] transition-colors">
                  Amanecidas que sabotean tu memoria
                </h3>
                <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
                  Horas de estudio que solo generan fatiga cognitiva. Estudiar de madrugada sin foco bloquea tu corteza prefrontal y provoca que te quedes en blanco frente al examen.
                </p>
              </div>
              <div class="relative z-10 mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-slate-400">
                <span>Retención sin dormir</span>
                <span class="text-amber-600 flex items-center gap-1">
                  <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span> Fatiga Crítica
                </span>
              </div>
            </article>

            <!-- Tarjeta 3 -->
            <article
              class="interactive-card reveal-up group bg-white rounded-3xl p-8 border border-slate-200/80 shadow-xs hover:shadow-2xl hover:border-[#0077FE]/50 hover:-translate-y-2 flex flex-col justify-between"
              style="transition-delay: 280ms;"
            >
