---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

const title = "Test Diagnóstico IA Gratuito | Descubre tus vacíos de aprendizaje — MindFix";
const description = "Realiza el test diagnóstico de 3 minutos de MindFix, descubre por qué tus notas no suben y recibe un plan personalizado al instante.";
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <style>
      @keyframes pulseGlow {
        0%, 100% { box-shadow: 0 0 25px rgba(0, 194, 255, 0.25); }
        50% { box-shadow: 0 0 50px rgba(0, 119, 254, 0.55); }
      }
      @keyframes popIn {
        0% { opacity: 0; transform: scale(0.92) translateY(16px); }
        100% { opacity: 1; transform: scale(1) translateY(0); }
      }
      @keyframes confettiFall {
        0% { transform: translateY(-20px) rotate(0deg); opacity: 1; }
        100% { transform: translateY(320px) rotate(540deg); opacity: 0; }
      }
      .animate-pop-in {
        animation: popIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
      .wow-glow {
        animation: pulseGlow 3s ease-in-out infinite;
      }
      .confetti-piece {
        position: absolute;
        width: 9px;
        height: 9px;
        border-radius: 2px;
        animation: confettiFall 2.4s ease-out forwards;
        pointer-events: none;
      }
    </style>
  </head>

  <body class="bg-[#070D18] text-white antialiased selection:bg-[#0077FE] selection:text-white min-h-screen flex flex-col font-sans overflow-x-hidden">
    <!-- Ambient background -->
    <div class="pointer-events-none fixed inset-0 overflow-hidden z-0">
      <div class="absolute -top-32 left-1/4 w-[520px] h-[520px] rounded-full bg-[#0077FE]/15 blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-[480px] h-[480px] rounded-full bg-[#6D4AFF]/15 blur-3xl"></div>
    </div>

    <Navbar active="test" />

    <main class="relative z-10 flex-1 flex items-center justify-center px-4 sm:px-6 py-10 sm:py-14">
      <div class="w-full max-w-3xl">

        <!-- ==================== PANTALLA 1: QUIZ INTERACTIVO ==================== -->
        <section id="quiz-screen" class="bg-[#0E1729]/90 backdrop-blur-xl rounded-3xl border border-white/10 shadow-2xl p-6 sm:p-10">
          <!-- Progress header -->
          <div class="mb-8">
            <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-[#00C2FF] mb-2.5">
              <span id="step-label">Pregunta 1 de 5</span>
              <span id="step-percent">20%</span>
            </div>
            <div class="w-full h-2.5 bg-white/10 rounded-full overflow-hidden">
              <div id="quiz-progress" class="h-full w-1/5 bg-gradient-to-r from-[#0077FE] to-[#00C2FF] rounded-full transition-all duration-400"></div>
            </div>
          </div>

          <!-- Question container -->
          <div id="question-container">
            <h1 id="question-title" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-snug mb-3"></h1>
            <p id="question-sub" class="text-sm text-slate-400 mb-7"></p>
            <div id="options-list" class="space-y-3.5"></div>
          </div>

          <div class="mt-8 pt-6 border-t border-white/10 flex items-center justify-between text-xs text-slate-400">
            <button id="prev-btn" onclick="prevQuestion()" class="hidden font-bold text-slate-300 hover:text-white cursor-pointer">
              ← Anterior
            </button>
            <span class="ml-auto">✓ 100% gratuito · Diagnóstico inmediato</span>
          </div>
        </section>

        <!-- ==================== PANTALLA 2: ESCANEO IA (TRANSICIÓN WOW) ==================== -->
        <section id="analyzing-screen" class="hidden bg-[#0E1729]/95 backdrop-blur-xl rounded-3xl border border-[#00C2FF]/30 shadow-2xl p-8 sm:p-14 text-center">
          <div class="relative w-24 h-24 mx-auto mb-6 flex items-center justify-center">
            <div class="absolute inset-0 rounded-full border-4 border-[#0077FE]/20"></div>
            <div class="absolute inset-0 rounded-full border-4 border-t-[#00C2FF] border-r-[#0077FE] animate-spin"></div>
            <span class="text-3xl">🧠</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-white mb-2">
            Analizando tus patrones de aprendizaje...
          </h2>
          <p id="scan-status" class="text-sm sm:text-base text-[#00C2FF] font-semibold mb-6">
            Evaluando retención y carga cognitiva...
          </p>
          <div class="max-w-md mx-auto w-full h-2 bg-white/10 rounded-full overflow-hidden">
            <div id="scan-bar" class="h-full w-0 bg-gradient-to-r from-[#0077FE] via-[#00C2FF] to-emerald-400 transition-all duration-500"></div>
          </div>
        </section>

        <!-- ==================== PANTALLA 3: WOW MOMENT + CAPTURA DE CORREO ==================== -->
        <section id="wow-screen" class="hidden relative bg-[#0E1729]/95 backdrop-blur-xl rounded-3xl border border-[#00C2FF]/40 wow-glow p-6 sm:p-10 overflow-hidden animate-pop-in">
          <!-- Confetti container -->
          <div id="confetti-layer" class="absolute inset-0 pointer-events-none overflow-hidden"></div>

          <!-- Top Badge -->
          <div class="text-center mb-8 relative z-10">
            <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 text-xs font-extrabold uppercase tracking-wider mb-3">
              ✨ Diagnóstico Completado · Mapa Revelado
            </span>
            <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
              Tu Perfil: <span id="archetype-name" class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] via-[#00C2FF] to-emerald-300"></span>
            </h2>
            <p id="archetype-desc" class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto mt-2"></p>
          </div>

          <!-- Score Comparison Cards (WOW Visual) -->
          <div class="grid grid-cols-1 md:grid-cols-12 gap-5 mb-8 relative z-10">
            <!-- Gauge Card -->
            <div class="md:col-span-5 bg-[#070D18]/80 rounded-2xl p-6 border border-white/10 flex flex-col items-center justify-center text-center">
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Índice de Eficiencia Cognitiva</p>
              <div class="relative w-36 h-36 flex items-center justify-center mb-3">
                <svg class="w-full h-full -rotate-90" viewBox="0 0 120 120">
                  <circle cx="60" cy="60" r="52" fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="10"></circle>
                  <circle id="score-ring" cx="60" cy="60" r="52" fill="none" stroke="url(#wowGrad)" stroke-width="10" stroke-linecap="round" stroke-dasharray="326.7" stroke-dashoffset="326.7" style="transition: stroke-dashoffset 1.2s ease-out;"></circle>
                  <defs>
                    <linearGradient id="wowGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" stop-color="#0077FE" />
                      <stop offset="100%" stop-color="#00C2FF" />
                    </linearGradient>
                  </defs>
                </svg>
                <div class="absolute text-center">
                  <span id="score-number" class="text-3xl font-black text-white">0%</span>
                  <span class="block text-[10px] font-bold text-[#00C2FF] uppercase">Actual</span>
                </div>
              </div>
              <div class="w-full bg-emerald-500/10 border border-emerald-400/25 rounded-xl px-3 py-2 text-xs">
                <span class="text-slate-300">Potencial en 14 días: </span>
                <strong class="text-emerald-300 font-black">92% (Tercio Superior)</strong>
              </div>
            </div>

            <!-- 4-Quadrant Breakdown -->
            <div class="md:col-span-7 bg-[#070D18]/80 rounded-2xl p-6 border border-white/10 flex flex-col justify-center space-y-4">
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Radiografía de tus 4 Pilares</p>

              <div>
                <div class="flex justify-between text-xs font-bold mb-1">
                  <span>Recuperación Activa (Active Recall)</span>
                  <span id="bar-recall-val" class="text-[#00C2FF]">0%</span>
                </div>
                <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden">
                  <div id="bar-recall" class="h-full w-0 bg-gradient-to-r from-[#0077FE] to-[#00C2FF] rounded-full transition-all duration-1000"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs font-bold mb-1">
                  <span>Auditoría de Vacíos Conceptuales</span>
                  <span id="bar-audit-val" class="text-amber-300">0%</span>
                </div>
                <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden">
                  <div id="bar-audit" class="h-full w-0 bg-gradient-to-r from-amber-500 to-amber-300 rounded-full transition-all duration-1000"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs font-bold mb-1">
                  <span>Consolidación de Memoria (Sueño REM)</span>
                  <span id="bar-sleep-val" class="text-purple-300">0%</span>
                </div>
                <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden">
                  <div id="bar-sleep" class="h-full w-0 bg-gradient-to-r from-[#6D4AFF] to-purple-300 rounded-full transition-all duration-1000"></div>
                </div>
              </div>

              <div>
                <div class="flex justify-between text-xs font-bold mb-1">
                  <span>Aprendizaje Entre Pares (P2P)</span>
                  <span id="bar-p2p-val" class="text-emerald-300">0%</span>
                </div>
                <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden">
                  <div id="bar-p2p" class="h-full w-0 bg-gradient-to-r from-emerald-500 to-emerald-300 rounded-full transition-all duration-1000"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- 3 Diagnosed Gaps / Actionable Fixes -->
          <div class="bg-white/5 rounded-2xl p-5 sm:p-6 border border-white/10 mb-8 relative z-10">
            <p class="text-xs font-extrabold uppercase tracking-wider text-[#00C2FF] mb-3">
              ⚡ Tus 3 Ajustes de Mayor Impacto para tu Próximo Parcial
            </p>
            <ul id="fixes-list" class="space-y-2.5 text-sm text-slate-200"></ul>
          </div>

          <!-- ==================== CAPTURA DE CORREO ELECTRÓNICO ==================== -->
          <div class="relative z-10 bg-gradient-to-br from-[#0077FE]/20 via-[#0B2545] to-[#6D4AFF]/20 rounded-2xl p-6 sm:p-8 border border-[#00C2FF]/40">
            <div id="email-capture-box">
              <div class="text-center max-w-xl mx-auto mb-5">
                <span class="inline-block px-3 py-1 rounded-full bg-[#00C2FF]/20 text-[#00C2FF] text-[11px] font-extrabold uppercase tracking-wider mb-2">
                  📩 Desbloquea tu Plan Completo
                </span>
                <h3 class="text-xl sm:text-2xl font-black text-white">
                  ¿A qué correo te enviamos tu Hoja de Ruta y tu Tutor Par ideal?
                </h3>
                <p class="text-xs sm:text-sm text-slate-300 mt-1.5">
                  Recibe gratis tu reporte detallado en PDF, la guía de auditoría de exámenes y acceso prioritario a la comunidad MindFix.
                </p>
              </div>

              <form id="wow-email-form" class="max-w-lg mx-auto space-y-3" onsubmit="event.preventDefault(); submitWowEmail();">
                <div class="flex flex-col sm:flex-row gap-3">
                  <input
                    id="wow-email-input"
                    type="email"
                    required
                    placeholder="tucorreo@universidad.edu.pe"
                    class="flex-1 px-4 py-3.5 rounded-xl bg-white text-[#0B2545] font-medium text-sm placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-[#00C2FF]"
                  />
                  <button
                    type="submit"
                    class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-[#0077FE] to-[#00C2FF] text-white font-extrabold text-sm shadow-lg shadow-[#0077FE]/40 hover:scale-[1.02] active:scale-[0.98] transition-all cursor-pointer shrink-0"
                  >
                    Enviar mi Plan Gratis →
                  </button>
                </div>
                <p class="text-[11px] text-slate-400 text-center">
                  🔒 100% libre de spam. Solo tu diagnóstico personalizado y recursos de estudio.
                </p>
              </form>
            </div>

            <!-- Estado Post-Correo -->
            <div id="email-success-box" class="hidden text-center py-3 animate-pop-in">
              <div class="w-14 h-14 rounded-full bg-emerald-500 text-white flex items-center justify-center mx-auto mb-3 text-2xl font-black shadow-lg shadow-emerald-500/30">
                ✓
              </div>
              <h3 class="text-xl font-black text-white mb-1.5">
                ¡Plan enviado a <span id="confirmed-user-email" class="text-[#00C2FF]"></span>!
              </h3>
              <p class="text-sm text-slate-300 max-w-md mx-auto mb-5">
                Ya puedes revisar tu bandeja de entrada. Mientras tanto, aprovecha estos dos recursos gratuitos:
              </p>
              <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
                <a href="/guia-gratuita" class="w-full sm:w-auto px-5 py-3 rounded-xl bg-white text-[#0B2545] font-extrabold text-xs hover:bg-slate-100 transition-colors">
                  📥 Descargar Guía PDF Gratis
                </a>
                <a href="/webinar" class="w-full sm:w-auto px-5 py-3 rounded-xl bg-[#6D4AFF] text-white font-extrabold text-xs hover:bg-[#5633E0] transition-colors">
                  🎥 Reservar lugar en el Webinar
                </a>
              </div>
            </div>
          </div>
        </section>

      </div>
    </main>

    <script is:inline>
      const questions = [
        {
          title: "¿Qué pasa cuando estudias 4 a 6 horas seguidas antes de un parcial?",
          sub: "Sé honesto/a: elige lo que ocurre con más frecuencia en tu semana de exámenes.",
          options: [
            { text: "Siento que avanzo leyendo, pero en el examen me quedo en blanco", score: 10, recall: 25, audit: 30 },
            { text: "Me canso rápido y termino revisando el celular cada 15 minutos", score: 14, recall: 40, audit: 35 },
            { text: "Hago resúmenes bonitos pero igual me faltan ejercicios tipo examen", score: 16, recall: 50, audit: 45 },
            { text: "Uso bloques cortos y resuelvo exámenes pasados cronometrados", score: 24, recall: 85, audit: 75 }
          ]
        },
        {
          title: "Cuando sacas una nota baja (ej. 08 o 10), ¿qué haces primero?",
          sub: "Tu reacción post-examen define qué tan rápido recuperas tu promedio.",
          options: [
            { text: "Guardo el examen por frustración y estudio el doble para el siguiente", score: 8, recall: 30, audit: 20 },
            { text: "Solo reviso dónde me bajaron puntos para reclamarle al profe", score: 12, recall: 40, audit: 30 },
            { text: "Busco el solucionario pero no anoto exactamente qué concepto fallé", score: 16, recall: 55, audit: 50 },
            { text: "Clasifico cada error (teoría vs. procedimiento) y busco ayuda puntual", score: 24, recall: 80, audit: 90 }
          ]
        },
        {
          title: "¿Cómo repasas los temas más difíciles de tu carrera?",
          sub: "La estrategia frente a la dificultad separa el esfuerzo bruto del rendimiento.",
          options: [
            { text: "Releo las diapositivas y subrayo todo con resaltadores", score: 8, recall: 20, p2p: 25 },
            { text: "Veo videos largos en YouTube la noche anterior", score: 12, recall: 35, p2p: 40 },
            { text: "Intento entender solo hasta que me bloqueo y paso a otro tema", score: 15, recall: 45, p2p: 35 },
            { text: "Le pregunto a un compañero de ciclos superiores o practico activo", score: 24, recall: 80, p2p: 90 }
          ]
        },
        {
          title: "¿Cuántas horas duermes la noche previa a un examen importante?",
          sub: "El hipocampo consolida la memoria exclusivamente durante el sueño profundo y REM.",
          options: [
            { text: "Me amanezco (0 a 3 horas) tomando café o energizantes", score: 6, sleep: 15 },
            { text: "Duermo poco (4 a 5 horas) con ansiedad de que no me alcance el tiempo", score: 12, sleep: 40 },
            { text: "Intento dormir 6 horas pero me despierto repasando fórmulas", score: 17, sleep: 65 },
            { text: "Duermo 7 a 8 horas porque termino de estudiar el día anterior", score: 25, sleep: 92 }
          ]
        },
        {
          title: "¿Cuál es tu meta principal para este ciclo universitario?",
          sub: "Con esto calibraremos las recomendaciones de tu hoja de ruta.",
          options: [
            { text: "Subir al Tercio o Quinto Superior sin quemarme en el intento", goal: "tercio", score: 18 },
            { text: "Aprobar mis cursos filtro en primera matrícula y sin amanecidas", goal: "aprobar", score: 15 },
            { text: "Dejar de olvidar lo que estudio por los nervios del examen", goal: "ansiedad", score: 14 },
            { text: "Encontrar un método ordenado y compañeros que expliquen claro", goal: "metodo", score: 16 }
          ]
        }
      ];

      let currentIdx = 0;
      const answers = [];

      function renderQuestion() {
        const q = questions[currentIdx];
        document.getElementById('step-label').textContent = `Pregunta ${currentIdx + 1} de ${questions.length}`;
        const pct = ((currentIdx + 1) / questions.length) * 100;
        document.getElementById('step-percent').textContent = `${pct}%`;
        document.getElementById('quiz-progress').style.width = `${pct}%`;

        document.getElementById('question-title').textContent = q.title;
        document.getElementById('question-sub').textContent = q.sub;

        const list = document.getElementById('options-list');
        list.innerHTML = '';

        q.options.forEach((opt, i) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          const isSelected = answers[currentIdx] === i;
          btn.className = `w-full text-left p-4 sm:p-5 rounded-2xl border transition-all duration-200 flex items-center justify-between gap-4 cursor-pointer ${
            isSelected
              ? 'bg-[#0077FE]/20 border-[#00C2FF] text-white shadow-lg shadow-[#0077FE]/20'
              : 'bg-white/5 hover:bg-white/10 border-white/10 hover:border-[#00C2FF]/50 text-slate-200'
          }`;
          btn.innerHTML = `
            <span class="text-sm sm:text-base font-semibold leading-snug">${opt.text}</span>
            <span class="w-6 h-6 rounded-full border border-white/25 flex items-center justify-center text-xs shrink-0 ${
              isSelected ? 'bg-[#00C2FF] text-[#070D18] border-transparent font-black' : 'text-slate-400'
            }">${isSelected ? '✓' : '›'}</span>
          `;
          btn.onclick = () => selectOption(i);
          list.appendChild(btn);
        });

        const prevBtn = document.getElementById('prev-btn');
        if (currentIdx > 0) {
          prevBtn.classList.remove('hidden');
        } else {
          prevBtn.classList.add('hidden');
        }
      }

      function selectOption(optionIdx) {
        answers[currentIdx] = optionIdx;
        if (currentIdx < questions.length - 1) {
          currentIdx++;
          renderQuestion();
        } else {
          startAnalysis();
        }
      }

      function prevQuestion() {
        if (currentIdx > 0) {
          currentIdx--;
          renderQuestion();
        }
      }

      function startAnalysis() {
        document.getElementById('quiz-screen').classList.add('hidden');
        document.getElementById('analyzing-screen').classList.remove('hidden');

        const bar = document.getElementById('scan-bar');
        const status = document.getElementById('scan-status');

        setTimeout(() => { bar.style.width = '35%'; status.textContent = 'Detectando ilusiones de competencia y brechas...'; }, 200);
        setTimeout(() => { bar.style.width = '75%'; status.textContent = 'Calibrando tu Índice de Eficiencia Cognitiva...'; }, 1000);
        setTimeout(() => { bar.style.width = '100%'; status.textContent = '¡Listo! Generando tu Mapa de Estudio...'; }, 1700);
        setTimeout(() => { showWowMoment(); }, 2300);
      }

      function showWowMoment() {
        document.getElementById('analyzing-screen').classList.add('hidden');
        document.getElementById('wow-screen').classList.remove('hidden');

        // Calculate dynamic metrics from answers
        const q0 = questions[0].options[answers[0] || 0];
        const q1 = questions[1].options[answers[1] || 0];
        const q2 = questions[2].options[answers[2] || 0];
        const q3 = questions[3].options[answers[3] || 0];
        const q4 = questions[4].options[answers[4] || 0];

        const totalScore = Math.min(94, Math.max(32, Math.round(((q0.score + q1.score + q2.score + q3.score + q4.score) / 115) * 100)));
        const recallScore = Math.round(((q0.recall || 40) + (q2.recall || 40)) / 2);
        const auditScore = q1.audit || 35;
        const sleepScore = q3.sleep || 40;
        const p2pScore = q2.p2p || 40;

        let archetype = 'Esfuerzo Alto, Retención Frágil';
        let desc = 'Le dedicas muchas horas al estudio, pero la falta de recuperación activa y auditoría de errores hace que tu cerebro pierda información clave bajo la presión del examen.';
        if (totalScore >= 72) {
          archetype = 'Estratega en Potencia (Rumbo al Tercio)';
          desc = 'Tienes buenas bases de organización, pero aún puedes recortar hasta un 40% tus horas de repaso enfocándote en vacíos puntuales con mentores pares.';
        } else if (sleepScore < 45) {
          archetype = 'Sobrecarga Nocturna Pre-Parcial';
          desc = 'Las amanecidas y la ansiedad están bloqueando la consolidación en tu hipocampo. Con bloques de 50 min y sueño protegido, tus notas subirán sin estudiar más horas.';
        }

        document.getElementById('archetype-name').textContent = archetype;
        document.getElementById('archetype-desc').textContent = desc;

        // Animate radial gauge
        const ring = document.getElementById('score-ring');
        const circumference = 326.7;
        const offset = circumference - (totalScore / 100) * circumference;
        setTimeout(() => {
          ring.style.strokeDashoffset = offset;
        }, 120);

        // Animate counter
        let cur = 0;
        const numEl = document.getElementById('score-number');
        const timer = setInterval(() => {
          cur += 2;
          if (cur >= totalScore) {
            cur = totalScore;
            clearInterval(timer);
          }
          numEl.textContent = `${cur}%`;
        }, 25);

        // Animate 4 bars
        setTimeout(() => {
          document.getElementById('bar-recall').style.width = `${recallScore}%`;
          document.getElementById('bar-recall-val').textContent = `${recallScore}%`;
          document.getElementById('bar-audit').style.width = `${auditScore}%`;
          document.getElementById('bar-audit-val').textContent = `${auditScore}%`;
          document.getElementById('bar-sleep').style.width = `${sleepScore}%`;
          document.getElementById('bar-sleep-val').textContent = `${sleepScore}%`;
          document.getElementById('bar-p2p').style.width = `${p2pScore}%`;
          document.getElementById('bar-p2p-val').textContent = `${p2pScore}%`;
        }, 200);

        // Tailored 3 fixes
        const fixes = [
          recallScore < 60
            ? 'Sustituye la relectura pasiva por bloques de 50 min resolviendo exámenes pasados sin mirar tus apuntes.'
            : 'Potencia tu Active Recall aplicando la Técnica Feynman en voz alta para los temas de mayor peso.',
          auditScore < 60
            ? 'Aplica la Matriz de 4 Cuadrantes en tu último examen: separa errores de concepto vs. descuidos operativos.'
            : 'Mantén un registro semanal de tus micro-vacíos antes de cada práctica calificada.',
          sleepScore < 70
            ? 'Corta el estudio 7 horas antes de dormir en semana de parciales para proteger tu memoria REM.'
            : 'Conecta con un tutor par de ciclos superiores para validar la lógica de preguntas tipo examen en 20 min.'
        ];

        const fixesList = document.getElementById('fixes-list');
        fixesList.innerHTML = fixes.map((f) => `
          <li class="flex items-start gap-2.5">
            <span class="text-[#00C2FF] font-black mt-0.5">✓</span>
            <span>${f}</span>
          </li>
        `).join('');

        // Launch confetti celebration!
        launchConfetti();
      }

      function launchConfetti() {
        const layer = document.getElementById('confetti-layer');
        const colors = ['#0077FE', '#00C2FF', '#6D4AFF', '#10B981', '#F59E0B'];
        for (let i = 0; i < 36; i++) {
          const piece = document.createElement('div');
          piece.className = 'confetti-piece';
          piece.style.left = `${Math.random() * 100}%`;
          piece.style.top = `${Math.random() * 15}%`;
          piece.style.backgroundColor = colors[i % colors.length];
          piece.style.animationDelay = `${Math.random() * 0.6}s`;
          layer.appendChild(piece);
        }
      }

      function submitWowEmail() {
        const email = document.getElementById('wow-email-input').value;
        document.getElementById('confirmed-user-email').textContent = email;
        document.getElementById('email-capture-box').classList.add('hidden');
        document.getElementById('email-success-box').classList.remove('hidden');
      }

      // Init quiz
      renderQuestion();
    </script>
  </body>
</html>
