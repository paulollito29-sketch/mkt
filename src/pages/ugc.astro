---
import Navbar from '../components/Navbar.astro';
import '../styles/global.css';

const title = "Comunidad UGC & Experiencias Reales | MindFix";
const description = "Descubre cómo miles de estudiantes universitarios usan MindFix en su día a día: videos reales, tips de estudio entre pares y resultados rumbo al Tercio Superior.";

const ugcStories = [
  {
    name: "Valeria Rojas",
    career: "Ing. Industrial · 4.º Ciclo",
    metric: "11.4 → 16.2",
    quote: "Dejé de amanecerme subrayando 100 diapositivas. El diagnóstico IA me dijo exactamente qué tema de Cálculo II me estaba jalando.",
    tag: "#MiParcialSinJale",
    duration: "0:42",
    bg: "from-[#0B2545] to-[#1E3A8A]",
    img: "/images/hero-valeria-mindfix.webp"
  },
  {
    name: "Mateo Salazar",
    career: "Medicina Humana · 5.º Ciclo",
    metric: "Tercio Superior",
    quote: "Un compañero de 7.º ciclo me explicó en 15 minutos por Zoom lo que no entendí en 3 semanas de cátedra.",
    tag: "#AprendizajeP2P",
    duration: "0:58",
    bg: "from-[#24145E] to-[#4C28C9]",
    img: "/images/blog/hero-aprendizaje-p2p.jpg"
  },
  {
    name: "Camila Paredes",
    career: "Economía & Finanzas · 6.º Ciclo",
    metric: "-55% horas estudio",
    quote: "Con los bloques de 50 minutos y la auditoría de errores pasé a estudiar la mitad de tiempo y dormir 7 horas antes de cada parcial.",
    tag: "#EstudioInteligente",
    duration: "0:37",
    bg: "from-[#064E3B] to-[#047857]",
    img: "/images/blog/hero-auditoria-examen.jpg"
  }
];
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>

  <body class="bg-[#FAFBFD] text-[#0B2545] min-h-screen flex flex-col font-sans antialiased">
    <Navbar active="ugc" />

    <main class="flex-1">
      <!-- Hero UGC -->
      <section class="relative overflow-hidden bg-gradient-to-b from-[#0B2545] via-[#0E1B2E] to-[#111827] text-white py-16 sm:py-20">
        <div class="pointer-events-none absolute -top-24 right-10 w-96 h-96 rounded-full bg-[#00C2FF]/20 blur-3xl"></div>
        <div class="pointer-events-none absolute bottom-0 left-10 w-80 h-80 rounded-full bg-[#6D4AFF]/20 blur-3xl"></div>

        <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center relative z-10">
          <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-[#00C2FF]/30 text-[#00C2FF] text-xs font-extrabold uppercase tracking-wider mb-5">
            🎬 Contenido Creado por Estudiantes (UGC)
          </span>
          <h1 class="text-3xl sm:text-5xl font-black tracking-tight leading-tight max-w-4xl mx-auto mb-5">
            Historias reales de universitarios que cambiaron el <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#60A5FA] to-[#00C2FF]">estrés por resultados</span>
          </h1>
          <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-8">
            Sin guiones corporativos. Mira cómo alumnos de distintas facultades usan MindFix para diagnosticar sus vacíos, estudiar en comunidad P2P y subir al Tercio Superior.
          </p>

          <div class="flex flex-wrap items-center justify-center gap-4">
            <a href="/test-diagnostico" class="px-7 py-3.5 rounded-2xl bg-gradient-to-r from-[#0077FE] to-[#00C2FF] text-white font-extrabold text-sm shadow-lg shadow-[#0077FE]/30 hover:scale-[1.03] transition-all">
              Hacer mi Test Diagnóstico →
            </a>
            <a href="/planes" class="px-7 py-3.5 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/20 text-white font-bold text-sm transition-all">
              Ver Planes y Promociones
            </a>
          </div>
        </div>
      </section>

      <!-- Grid de Videos / Reels UGC -->
      <section class="max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-18">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
          <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-[#0077FE]">Reels & Testimonios en Campus</span>
            <h2 class="text-2xl sm:text-3xl font-black text-[#0B2545] mt-1">
              Lo que nuestra comunidad comparte en TikTok e Instagram
            </h2>
          </div>
          <span class="text-xs font-bold text-slate-500 bg-white px-4 py-2 rounded-full border border-slate-200">
            +2,400 universitarios activos
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-7">
          {ugcStories.map((story) => (
            <article class="bg-white rounded-3xl border border-slate-200/90 shadow-sm hover:shadow-xl transition-all overflow-hidden flex flex-col group">
              <!-- Video Reel Card -->
              <div class={`relative h-72 bg-gradient-to-br ${story.bg} overflow-hidden`}>
                <img src={story.img} alt={story.name} class="w-full h-full object-cover opacity-85 group-hover:scale-105 transition-transform duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

                <!-- Top pills -->
                <div class="absolute top-3.5 left-3.5 right-3.5 flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-[11px] font-bold">
                    {story.tag}
                  </span>
                  <span class="px-2.5 py-1 rounded-full bg-emerald-500 text-white text-[11px] font-black">
                    {story.metric}
                  </span>
                </div>

                <!-- Play Button Overlay -->
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-14 h-14 rounded-full bg-white/95 text-[#0B2545] flex items-center justify-center shadow-2xl group-hover:scale-110 transition-transform">
                    <svg class="w-6 h-6 ml-0.5 fill-current" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>

                <!-- Bottom Info -->
                <div class="absolute bottom-3.5 left-4 right-4 flex items-end justify-between text-white">
                  <div>
                    <p class="font-extrabold text-sm">{story.name}</p>
                    <p class="text-[11px] text-slate-300">{story.career}</p>
                  </div>
                  <span class="text-[11px] font-bold bg-black/50 px-2 py-0.5 rounded">{story.duration}</span>
                </div>
              </div>

              <!-- Quote -->
              <div class="p-6 flex-1 flex flex-col justify-between">
                <p class="text-sm text-slate-600 leading-relaxed italic">
                  "{story.quote}"
                </p>
                <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold">
                  <span class="text-emerald-600">✓ Estudiante verificado</span>
                  <a href="/prueba-gratuita" class="text-[#0077FE] hover:underline">Probar 14 días gratis →</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Banner UGC -> Planes -->
      <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-16">
        <div class="bg-gradient-to-r from-[#0B2545] to-[#24145E] rounded-3xl p-8 sm:p-12 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-2xl">
          <div class="max-w-xl">
            <span class="text-xs font-extrabold uppercase tracking-wider text-[#00C2FF]">Únete a la comunidad</span>
            <h2 class="text-2xl sm:text-3xl font-black mt-1 mb-2">
              ¿Listo para ser el siguiente caso de éxito?
            </h2>
            <p class="text-sm text-slate-300">
              Comienza con tu prueba gratuita de 14 días o aprovecha el Plan Anual con descuento por tiempo limitado.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-3 shrink-0">
            <a href="/prueba-gratuita" class="px-6 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-white font-extrabold text-sm text-center transition-colors">
              Iniciar Prueba Gratis
            </a>
            <a href="/planes" class="px-6 py-3.5 rounded-2xl bg-white text-[#0B2545] hover:bg-slate-100 font-extrabold text-sm text-center transition-colors">
              Ver Planes y Ofertas →
            </a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
