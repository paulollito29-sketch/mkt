      let activePlanKey = 'pro';

      function setAppPlan(plan) {
        if (!appPlans[plan]) plan = 'pro';
        activePlanKey = plan;
        localStorage.setItem('mindfix_active_plan', plan);

        const data = appPlans[plan];

        // Update Pill and Title in Header
        const pill = document.getElementById('active-plan-pill');
        pill.textContent = data.pill;
        pill.className = data.pillClass;

        const nameEl = document.getElementById('active-plan-name');
        nameEl.textContent = data.name;
        nameEl.className = data.nameClass;

        document.getElementById('active-plan-desc').textContent = data.desc;
        document.getElementById('plan-action-banner').innerHTML = data.bannerHtml;
        document.getElementById('plan-features-callout').innerHTML = data.calloutHtml;

        // Update selector buttons styling
        ['freemium', 'smart', 'pro', 'elite'].forEach((p) => {
          const btn = document.getElementById(`btn-plan-${p}`);
          if (p === plan) {
            btn.className = 'px-3.5 py-2 rounded-xl text-xs font-black transition-all cursor-pointer bg-white text-slate-900 shadow-sm';
          } else {
            btn.className = 'px-3.5 py-2 rounded-xl text-xs font-black transition-all cursor-pointer text-slate-300 hover:text-white';
          }
        });

        // Update Lock Overlays on the physical section modules
        const lockSmart = document.getElementById('lock-overlay-smart');
        const lockPro = document.getElementById('lock-overlay-pro');
        const lockElite = document.getElementById('lock-overlay-elite');

        if (lockSmart && lockPro && lockElite) {
          if (plan === 'freemium') {
            lockSmart.classList.remove('hidden');
            lockPro.classList.remove('hidden');
            lockElite.classList.remove('hidden');
          } else if (plan === 'smart') {
            lockSmart.classList.add('hidden'); // SMART Desbloqueado
            lockPro.classList.remove('hidden');
            lockElite.classList.remove('hidden');
          } else if (plan === 'pro') {
            lockSmart.classList.add('hidden'); // SMART Desbloqueado
            lockPro.classList.add('hidden'); // PRO Desbloqueado
            lockElite.classList.remove('hidden');
          } else if (plan === 'elite') {
            lockSmart.classList.add('hidden'); // SMART Desbloqueado
            lockPro.classList.add('hidden'); // PRO Desbloqueado
            lockElite.classList.add('hidden'); // ELITE Desbloqueado
          }
        }
      }

      // Check URL query e.g. /app?plan=elite or localStorage
      const urlParams = new URLSearchParams(window.location.search);
      const paramPlan = urlParams.get('plan');
      const savedPlan = paramPlan || localStorage.getItem('mindfix_active_plan') || 'pro';
      setAppPlan(savedPlan);

      try {
        const stored = JSON.parse(localStorage.getItem('mindfix_user') || '{}');
        if (stored.name) {
          document.getElementById('app-user-name').textContent = stored.name;
        }
      } catch (e) {}

      function goProfileStep(step) {
        document.getElementById('profile-done').classList.add('hidden');
        [1, 2, 3].forEach((n) => {
          document.getElementById(`profile-step-${n}`).classList.toggle('hidden', n !== step);
          const bar = document.getElementById(`stepper-${n}`);
          bar.className = n <= step
            ? 'h-2 rounded-full bg-[#0077FE] transition-all cursor-pointer'
            : 'h-2 rounded-full bg-slate-200 transition-all cursor-pointer';
        });
        document.getElementById('profile-step-badge').textContent = `Paso ${step} de 3`;
      }

      function completeProfile() {
        [1, 2, 3].forEach((n) => {
          document.getElementById(`profile-step-${n}`).classList.add('hidden');
          document.getElementById(`stepper-${n}`).className = 'h-2 rounded-full bg-emerald-500 transition-all cursor-pointer';
        });
        document.getElementById('profile-step-badge').textContent = 'Perfil Completo ✓';
        document.getElementById('profile-done').classList.remove('hidden');
      }
    </script>
