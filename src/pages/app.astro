    <!-- ========================================================================= -->
    <!-- SCRIPT CLIENTE: NAVEGACIÓN, PLANES DINÁMICOS & BÚSQUEDA                    -->
    <!-- ========================================================================= -->
    <script is:inline>
      const appViews = ['dashboard', 'planner', 'marketplace', 'elite', 'download', 'social', 'profile'];
      let currentActivePlan = 'pro';

      // 1. Configuración de permisos por plan
      const planPermissions = {
        freemium: {
          allowed: ['dashboard', 'download', 'social', 'profile'],
          locked: ['planner', 'marketplace', 'elite']
        },
        smart: {
          allowed: ['dashboard', 'marketplace', 'download', 'social', 'profile'],
          locked: ['planner', 'elite']
        },
        pro: {
          allowed: ['dashboard', 'planner', 'marketplace', 'download', 'social', 'profile'],
          locked: ['elite']
        },
        elite: {
          allowed: ['dashboard', 'planner', 'marketplace', 'elite', 'download', 'social', 'profile'],
          locked: []
        }
      };

      const planMeta = {
        freemium: {
          title: 'Plan Freemium Gratuito',
          desc: 'Diagnósticos iniciales y foros comunitarios.',
          badge: '⚪ Freemium',
          pillClass: 'bg-slate-100 text-slate-700 border-slate-300'
        },
        smart: {
          title: 'Plan SMART Activo',
          desc: 'Buscador de apuntes y solucionarios ilimitados.',
          badge: '⭐ Plan SMART',
          pillClass: 'bg-rose-100 text-rose-700 border-rose-300'
        },
        pro: {
          title: 'Plan PRO Universitario (Incluye SMART)',
          desc: 'Todo lo de SMART (Apuntes) + Hábitos con IA y detección de vacíos.',
          badge: '👑 Plan PRO',
          pillClass: 'bg-emerald-100 text-emerald-700 border-emerald-300'
        },
        elite: {
          title: 'Plan ELITE VIP (Tercio Superior)',
          desc: 'IA predictiva, tutor 1-on-1 y ranking VIP.',
          badge: '💎 Plan ELITE',
          pillClass: 'bg-purple-100 text-purple-700 border-purple-300'
        }
      };

      // 2. Cambiar Vista (SPA Navigation)
      function switchAppView(viewId) {
        appViews.forEach((v) => {
          const viewEl = document.getElementById(`view-${v}`);
          const navBtn = document.getElementById(`nav-btn-${v}`);
          const bottomBtn = document.getElementById(`bottom-nav-${v}`);

          if (viewEl) {
            viewEl.classList.toggle('hidden', v !== viewId);
          }

          if (navBtn) {
            if (v === viewId) {
              navBtn.className = 'w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-black text-xs transition-all cursor-pointer bg-[#0077FE] text-white shadow-xs';
            } else {
              navBtn.className = 'w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100';
            }
          }

          if (bottomBtn) {
            if (v === viewId) {
              bottomBtn.className = 'flex flex-col items-center justify-center gap-0.5 text-[#0077FE] cursor-pointer';
            } else {
              bottomBtn.className = 'flex flex-col items-center justify-center gap-0.5 text-slate-500 hover:text-slate-800 cursor-pointer';
            }
          }
        });

        // Actualizar visualización según bloqueo del plan
        applyPlanLockToView(viewId);

        // Cerrar sidebar en móvil si está abierto
        const sidebar = document.getElementById('app-sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (sidebar && window.innerWidth < 1024) {
          sidebar.classList.add('-translate-x-full');
          if (backdrop) backdrop.classList.add('hidden');
        }
      }

      // 3. Aplicar Pantallas de Upgrade según el plan activo
      function applyPlanLockToView(viewId) {
        const perms = planPermissions[currentActivePlan] || planPermissions.pro;
        const isLocked = perms.locked.includes(viewId);

        // Planner
        if (viewId === 'planner') {
          const upScreen = document.getElementById('upgrade-screen-planner');
          const content = document.getElementById('content-planner');
          if (upScreen && content) {
            upScreen.classList.toggle('hidden', !isLocked);
            content.classList.toggle('hidden', isLocked);
          }
        }

        // Marketplace
        if (viewId === 'marketplace') {
          const upScreen = document.getElementById('upgrade-screen-marketplace');
          const content = document.getElementById('content-marketplace');
          if (upScreen && content) {
            upScreen.classList.toggle('hidden', !isLocked);
            content.classList.toggle('hidden', isLocked);
          }
        }

        // Elite
        if (viewId === 'elite') {
          const upScreen = document.getElementById('upgrade-screen-elite');
          const content = document.getElementById('content-elite');
          if (upScreen && content) {
            upScreen.classList.toggle('hidden', !isLocked);
            content.classList.toggle('hidden', isLocked);
          }
        }
      }

      // 4. Cambiar Plan Activo (Freemium, SMART, PRO, ELITE)
      function setAppPlan(planId) {
        if (!planPermissions[planId]) planId = 'pro';
        currentActivePlan = planId;
        localStorage.setItem('mindfix_active_plan', planId);

        const meta = planMeta[planId];

        // Alternar la interfaz del Dashboard según el plan seleccionado
        ['freemium', 'smart', 'pro', 'elite'].forEach(p => {
          const ifaceEl = document.getElementById(`dash-interface-${p}`);
          const selectorBtn = document.getElementById(`dash-selector-${p}`);
          if (ifaceEl) {
            ifaceEl.classList.toggle('hidden', p !== planId);
          }
          if (selectorBtn) {
            if (p === planId) {
              const bg = p === 'freemium' ? 'bg-slate-700 text-white font-black shadow-xs' : p === 'smart' ? 'bg-rose-600 text-white font-black shadow-xs' : p === 'pro' ? 'bg-emerald-600 text-white font-black shadow-xs' : 'bg-purple-600 text-white font-black shadow-xs';
              selectorBtn.className = `flex-1 sm:flex-none py-1.5 px-3 rounded-xl text-xs transition-all text-center cursor-pointer whitespace-nowrap ${bg}`;
            } else {
              selectorBtn.className = 'flex-1 sm:flex-none py-1.5 px-3 rounded-xl text-xs font-bold text-slate-600 hover:bg-white transition-all text-center cursor-pointer whitespace-nowrap';
            }
          }
        });

        // Actualizar Badges
        const headerBadge = document.getElementById('header-plan-badge');
        const dashBadge = document.getElementById('dash-active-plan-badge');
        const sidePill = document.getElementById('sidebar-plan-pill');
        const mobPill = document.getElementById('mobile-current-plan-pill');
        const sideTitle = document.getElementById('sidebar-plan-title');
        const sideDesc = document.getElementById('sidebar-plan-desc');

        if (headerBadge) headerBadge.textContent = meta.badge;
        if (dashBadge) dashBadge.textContent = meta.badge;
        if (sidePill) sidePill.textContent = meta.badge;
        if (mobPill) mobPill.textContent = meta.badge;
        if (sideTitle) sideTitle.textContent = meta.title;
        if (sideDesc) sideDesc.textContent = meta.desc;

        // Estilos de botones de plan en Desktop
        ['freemium', 'smart', 'pro', 'elite'].forEach((p) => {
          const topBtn = document.getElementById(`top-plan-${p}`);
          const mobBtn = document.getElementById(`mob-plan-${p}`);
          const isActive = p === planId;

          if (topBtn) {
            if (isActive) {
              const bg = p === 'freemium' ? 'bg-slate-700 text-white' : p === 'smart' ? 'bg-rose-600 text-white' : p === 'pro' ? 'bg-emerald-600 text-white' : 'bg-purple-600 text-white';
              topBtn.className = `px-2.5 py-1.5 rounded-xl text-xs font-black transition-all cursor-pointer shadow-xs ${bg}`;
            } else {
              topBtn.className = 'px-2.5 py-1.5 rounded-xl text-xs font-black transition-all cursor-pointer text-slate-600 hover:text-slate-900';
            }
          }

          if (mobBtn) {
            if (isActive) {
              const bg = p === 'freemium' ? 'bg-slate-700 text-white' : p === 'smart' ? 'bg-rose-600 text-white' : p === 'pro' ? 'bg-emerald-600 text-white' : 'bg-purple-600 text-white';
              mobBtn.className = `px-2 py-1 rounded-lg text-[10px] font-black shadow-xs cursor-pointer ${bg}`;
            } else {
              mobBtn.className = 'px-2 py-1 rounded-lg text-[10px] font-bold text-slate-600 bg-slate-100 cursor-pointer';
            }
          }
        });

        // Actualizar badges de bloqueo en el sidebar y bottom bar
        const perms = planPermissions[planId];
        
        // Planner badge
        const badgePlanner = document.getElementById('badge-nav-planner');
        const bottomLockPlanner = document.getElementById('bottom-lock-planner');
        if (perms.locked.includes('planner')) {
          if (badgePlanner) {
            badgePlanner.textContent = '🔒 Upgrade';
            badgePlanner.className = 'text-[9px] text-amber-700 font-extrabold bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200';
          }
          if (bottomLockPlanner) bottomLockPlanner.classList.remove('hidden');
        } else {
          if (badgePlanner) {
            badgePlanner.textContent = 'PRO';
            badgePlanner.className = 'text-[9px] text-emerald-600 font-extrabold bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200';
          }
          if (bottomLockPlanner) bottomLockPlanner.classList.add('hidden');
        }

        // Marketplace badge
        const badgeMarket = document.getElementById('badge-nav-marketplace');
        const bottomLockMarket = document.getElementById('bottom-lock-marketplace');
        if (perms.locked.includes('marketplace')) {
          if (badgeMarket) {
            badgeMarket.textContent = '🔒 Upgrade';
            badgeMarket.className = 'text-[9px] text-amber-700 font-extrabold bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200';
          }
          if (bottomLockMarket) bottomLockMarket.classList.remove('hidden');
        } else {
          if (badgeMarket) {
            badgeMarket.textContent = planId === 'pro' ? 'Incluido en PRO ✔' : 'SMART';
            badgeMarket.className = planId === 'pro' ? 'text-[9px] text-emerald-700 font-extrabold bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200' : 'text-[9px] text-rose-600 font-extrabold bg-rose-50 px-1.5 py-0.5 rounded border border-rose-200';
          }
          if (bottomLockMarket) bottomLockMarket.classList.add('hidden');
        }

        // Elite badge
        const badgeElite = document.getElementById('badge-nav-elite');
        if (perms.locked.includes('elite')) {
          if (badgeElite) {
            badgeElite.textContent = '🔒 Upgrade';
            badgeElite.className = 'text-[9px] text-amber-700 font-extrabold bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200';
          }
        } else {
          if (badgeElite) {
            badgeElite.textContent = 'ELITE';
            badgeElite.className = 'text-[9px] text-purple-600 font-extrabold bg-purple-50 px-1.5 py-0.5 rounded border border-purple-200';
          }
        }

        // Re-evaluar la vista actualmente abierta
        const currentOpenView = appViews.find(v => {
          const el = document.getElementById(`view-${v}`);
          return el && !el.classList.contains('hidden');
        }) || 'dashboard';

        applyPlanLockToView(currentOpenView);
      }

      // 5. Drawer lateral móvil
      function toggleSidebar() {
        const sidebar = document.getElementById('app-sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (!sidebar) return;
        const isOpen = !sidebar.classList.contains('-translate-x-full');
        if (isOpen) {
          sidebar.classList.add('-translate-x-full');
          if (backdrop) backdrop.classList.add('hidden');
        } else {
          sidebar.classList.remove('-translate-x-full');
          if (backdrop) backdrop.classList.remove('hidden');
        }
      }

      // 6. Cerrar Sesión (Limpia sesión y redirige a la Landing /)
      function handleLogout() {
        if (confirm('¿Deseas cerrar tu sesión y volver a la página principal de MindFix?')) {
          localStorage.removeItem('mindfix_session_token');
          window.location.href = '/';
        }
      }

      // 7. Buscador de Apuntes y Filtros en tiempo real
      let currentUniFilter = 'all';

      function handleMarketplaceSearch() {
        const query = (document.getElementById('marketplace-search-input')?.value || '').toLowerCase().trim();
        const items = document.querySelectorAll('.market-item');
        let visibleCount = 0;

        items.forEach((item) => {
          const itemText = item.getAttribute('data-title') || '';
          const itemUni = item.getAttribute('data-uni') || '';

          const matchQuery = !query || itemText.includes(query);
          const matchUni = currentUniFilter === 'all' || itemUni === currentUniFilter;

          if (matchQuery && matchUni) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        const countEl = document.getElementById('marketplace-results-count');
        if (countEl) {
          countEl.textContent = `Mostrando ${visibleCount} recurso${visibleCount === 1 ? '' : 's'} encontrado${visibleCount === 1 ? '' : 's'}`;
        }
      }

      function setMarketplaceFilter(uni) {
        currentUniFilter = uni;
        ['all', 'pucp', 'unmsm', 'upc', 'ulima', 'uni'].forEach(u => {
          const btn = document.getElementById(`filter-uni-${u}`);
          if (btn) {
            if (u === uni) {
              btn.className = 'px-3 py-1 rounded-xl font-black bg-white text-[#0B2545] shadow-xs cursor-pointer transition-all';
            } else {
              btn.className = 'px-3 py-1 rounded-xl font-bold bg-white/10 hover:bg-white/20 text-white cursor-pointer transition-all';
            }
          }
        });
        handleMarketplaceSearch();
      }

      function clearMarketplaceSearch() {
        const input = document.getElementById('marketplace-search-input');
        if (input) input.value = '';
        setMarketplaceFilter('all');
      }

      // 8. Modales y Descarga de Documentos
      let currentDocTitle = '';

      function previewDoc(title, uni, grade) {
        currentDocTitle = title;
        document.getElementById('modal-title').textContent = title;
        document.getElementById('modal-uni').textContent = uni;
        document.getElementById('modal-grade').textContent = grade;
        document.getElementById('preview-modal').classList.remove('hidden');
      }

      function closePreviewModal() {
        document.getElementById('preview-modal').classList.add('hidden');
      }

      function downloadCurrentDoc() {
        closePreviewModal();
        downloadDoc(currentDocTitle);
      }

      function downloadDoc(title) {
        alert(`📥 Descargando: "${title}"\n¡Material verificado descargado con éxito!`);
      }

      function triggerFixiModal() {
        alert('🤖 Fixi IA está analizando tu racha y tus materias de hoy. ¡Todo en orden para tu bloque de estudio!');
      }


      // 8.1 Planificador de Hábitos: Temporizador Pomodoro 50/10
      let pomodoroInterval = null;
      let pomodoroSecondsLeft = 50 * 60; // 50 min
      let isPomodoroRunning = false;

      function updateTimerDisplay() {
        const display = document.getElementById("pomodoro-timer-display");
        if (!display) return;
        const mins = Math.floor(pomodoroSecondsLeft / 60);
        const secs = pomodoroSecondsLeft % 60;
        display.textContent = `${String(mins).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
      }

      function startPomodoroTimer() {
        if (isPomodoroRunning) return;
        isPomodoroRunning = true;
        const badge = document.getElementById("timer-status-badge");
        const startBtn = document.getElementById("timer-start-btn");
        if (badge) {
          badge.textContent = "Enfoque Activo 🔥";
          badge.className = "text-[9px] bg-rose-500/20 text-rose-300 border border-rose-500/30 px-2 py-0.5 rounded-full font-black animate-pulse";
        }
        if (startBtn) startBtn.textContent = "En Foco ⏱️";

        pomodoroInterval = setInterval(() => {
          if (pomodoroSecondsLeft > 0) {
            pomodoroSecondsLeft--;
            updateTimerDisplay();
          } else {
            clearInterval(pomodoroInterval);
            isPomodoroRunning = false;
            alert("🎉 ¡Bloque de 50 minutos completado con éxito! Toca tu pausa activa de 10 min.");
            resetPomodoroTimer();
          }
        }, 1000);
      }

      function pausePomodoroTimer() {
        if (!isPomodoroRunning) return;
        clearInterval(pomodoroInterval);
        isPomodoroRunning = false;
        const badge = document.getElementById("timer-status-badge");
        const startBtn = document.getElementById("timer-start-btn");
        if (badge) {
          badge.textContent = "En Pausa";
          badge.className = "text-[9px] bg-amber-500/20 text-amber-300 border border-amber-500/30 px-2 py-0.5 rounded-full font-black";
        }
        if (startBtn) startBtn.textContent = "▶ Reanudar";
      }

      function resetPomodoroTimer() {
        clearInterval(pomodoroInterval);
        isPomodoroRunning = false;
        pomodoroSecondsLeft = 50 * 60;
        updateTimerDisplay();
        const badge = document.getElementById("timer-status-badge");
        const startBtn = document.getElementById("timer-start-btn");
        if (badge) {
          badge.textContent = "Listo";
          badge.className = "text-[9px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full font-black";
        }
        if (startBtn) startBtn.textContent = "▶ Iniciar Foco";
      }

      // 8.2 Contador de Hidratación
      let waterDrunkMl = 1250;
      const waterGoalMl = 2000;

      function addWaterCup() {
        waterDrunkMl = Math.min(waterGoalMl, waterDrunkMl + 250);
        const percent = Math.min(100, Math.round((waterDrunkMl / waterGoalMl) * 100));
        const bar = document.getElementById("water-progress-bar");
        const text = document.getElementById("water-progress-text");
        if (bar) bar.style.width = percent + "%";
        if (text) text.textContent = `${waterDrunkMl.toLocaleString()} / ${waterGoalMl.toLocaleString()} ml (${percent}%)`;
      }

      // 8.3 Selector de Estado de Energía
      function setEnergyState(state) {
        ["high", "normal", "low"].forEach(s => {
          const btn = document.getElementById("energy-btn-" + s);
          if (btn) {
            if (s === state) {
              btn.className = "px-3 py-1.5 rounded-xl font-black bg-emerald-600 text-white text-xs cursor-pointer shadow-xs transition-all";
            } else {
              btn.className = "px-3 py-1.5 rounded-xl font-bold bg-white text-slate-600 text-xs cursor-pointer hover:bg-slate-100 transition-all";
            }
          }
        });
      }

      function triggerReplanAI() {
        alert("🤖 Fixi IA está recalculando tus bloques de la semana... ¡Listo! Se equilibraron tus horas de Active Recall y pausas.");
      }

      function updateHabitCount() {
        const checkboxes = document.querySelectorAll(".habit-checkbox");
        let checked = 0;
        checkboxes.forEach(cb => { if (cb.checked) checked++; });
        const percent = Math.round((checked / checkboxes.length) * 100);
        const text = document.getElementById("habits-counter-text");
        if (text) {
          text.textContent = `${checked} de ${checkboxes.length} hábitos cumplidos (${percent}%)`;
        }
      }

      // 8.4 Suite Elite: Chat en Vivo con Fixi Predictor IA
      function sendQuickPrompt(promptText) {
        appendUserMessage(promptText);
        setTimeout(() => {
          generateFixiResponse(promptText);
        }, 600);
      }

      function handleEliteChatSubmit(e) {
        e.preventDefault();
        const input = document.getElementById("elite-chat-input");
        if (!input || !input.value.trim()) return;
        const msg = input.value.trim();
        input.value = "";
        appendUserMessage(msg);
        setTimeout(() => {
          generateFixiResponse(msg);
        }, 700);
      }

      function appendUserMessage(text) {
        const stream = document.getElementById("elite-chat-stream");
        if (!stream) return;
        const msgHtml = `
          <div class="flex items-start justify-end gap-2">
            <div class="bg-purple-600 text-white rounded-2xl rounded-tr-xs p-3 max-w-[85%] space-y-1">
              <div class="font-bold text-[11px] text-purple-200 text-right">Tú:</div>
              <p class="leading-relaxed">${text}</p>
            </div>
          </div>
        `;
        stream.insertAdjacentHTML("beforeend", msgHtml);
        stream.scrollTop = stream.scrollHeight;
      }

      function generateFixiResponse(query) {
        const stream = document.getElementById("elite-chat-stream");
        if (!stream) return;

        let reply = "";
        const lower = query.toLowerCase();

        if (lower.includes("fija") || lower.includes("viene") || lower.includes("parcial")) {
          reply = `<strong>🔮 Predicción Oficial Finanzas II (Semana 9):</strong><br/>
          El profesor Mendoza evaluará al 100% de probabilidad:
          <ul class="mt-1 space-y-1 list-disc list-inside text-slate-700">
            <li><strong>Pregunta 1:</strong> Estructura de capital MM con escudo fiscal (6 pts).</li>
            <li><strong>Pregunta 2:</strong> CAPM y beta desapalancado con ecuación de Hamada (5 pts).</li>
            <li><strong>Pregunta 3:</strong> Valoración de proyecto con WACC vs APV (5 pts).</li>
          </ul>
          <em>💡 Consejo de oro:</em> El profesor suele descontar puntos si no explicitas la tasa impositiva corporativa de Perú (29.5%).`;
        } else if (lower.includes("prueba") || lower.includes("simulacro") || lower.includes("pregunta")) {
          reply = `<strong>📝 Ejercicio tipo Examen Detectado:</strong><br/>
          <em>"Si el costo de deuda Kd es 9% y la empresa emite deuda por S/ 20 millones manteniendo D/E = 0.5, ¿cuál es el nuevo Ke apalancado?"</em><br/>
          <span class="text-purple-700 font-bold">Respuesta clave:</span> Usa la fórmula de Hamada: Ke = Ku + (1 - T)(Ku - Kd)(D/E). ¡Resuélvelo en tu cuaderno y avísame cuando tengas el número!`;
        } else if (lower.includes("débil") || lower.includes("puntos débiles") || lower.includes("falla")) {
          reply = `<strong>⚠️ Análisis Forense de Rendimiento:</strong><br/>
          En tu última práctica calificada observamos:
          <ul class="mt-1 space-y-1 list-disc list-inside text-slate-700">
            <li><strong>Velocidad en WACC:</strong> Demoras 22 min (el tiempo óptimo es 15 min).</li>
            <li><strong>Confusión de tasas:</strong> Confundes tasa efectiva semestral con anual en el cálculo del escudo fiscal.</li>
          </ul>
          Carlos Mendoza (tu tutor) ya preparó una hoja de atajos para corregir esto en tu sesión del jueves.`;
        } else {
          reply = `Entendido, Valeria. Para el examen de Finanzas y Base de Datos, mi recomendación algorítmica es enfocar tu siguiente bloque Pomodoro de 50 minutos en resolver los 3 ejercicios fijados en el Radar de la izquierda. ¿Quieres que te desglose el cálculo paso a paso?`;
        }

        const msgHtml = `
          <div class="flex items-start gap-2.5">
            <div class="w-7 h-7 rounded-full bg-purple-100 text-purple-700 flex items-center justify-center text-xs shrink-0 font-black">
              🤖
            </div>
            <div class="bg-slate-100 rounded-2xl rounded-tl-xs p-3 text-slate-800 space-y-1.5 max-w-[85%]">
              <div class="font-bold text-purple-700 text-[11px]">Fixi Predictor IA:</div>
              <div class="leading-relaxed text-slate-700 text-xs">${reply}</div>
            </div>
          </div>
        `;
        stream.insertAdjacentHTML("beforeend", msgHtml);
        stream.scrollTop = stream.scrollHeight;
      }

      function toggleRubricDetails() {
        const rubric = document.getElementById("rubric-details");
        const btn = document.getElementById("rubric-toggle-btn");
        if (rubric) {
          const isHidden = rubric.classList.contains("hidden");
          rubric.classList.toggle("hidden", !isHidden);
          if (btn) btn.textContent = isHidden ? "▲ Ocultar Rúbrica de Calificación" : "👁️ Revelar Rúbrica de Calificación del Profesor →";
        }
      }

      function askFixiToSolveQuestion() {
        sendQuickPrompt("Explícame paso a paso cómo resolver el ejercicio de la empresa peruana con deuda de S/ 40 millones y WACC.");
      }


      // 9. Inicialización al cargar la página
      window.addEventListener('DOMContentLoaded', () => {
        // Leer parámetro ?plan= de la URL si existe
        const urlParams = new URLSearchParams(window.location.search);
        const planParam = urlParams.get('plan');
        const viewParam = urlParams.get('view');

        const initialPlan = planParam || localStorage.getItem('mindfix_active_plan') || 'pro';
        setAppPlan(initialPlan);

        if (viewParam && appViews.includes(viewParam)) {
          switchAppView(viewParam);
        } else {
          switchAppView('dashboard');
        }
      });
    </script>
  </body>
</html>
