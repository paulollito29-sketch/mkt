    <!-- ========================================================================= -->
    <!-- 4. LÓGICA JAVASCRIPT DE NAVEGACIÓN Y PLANES                               -->
    <!-- ========================================================================= -->
    <script is:inline>
      // 1. Navegación entre vistas dentro de la app (SPA navigation)
      const appViews = ['dashboard', 'planner', 'marketplace', 'elite', 'download', 'social', 'profile'];

      function switchAppView(viewId) {
        appViews.forEach((v) => {
          const viewEl = document.getElementById(`view-${v}`);
          const navBtn = document.getElementById(`nav-btn-${v}`);
          if (viewEl) {
            viewEl.classList.toggle('hidden', v !== viewId);
          }
          if (navBtn) {
            if (v === viewId) {
              navBtn.className = 'w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-black text-xs transition-all cursor-pointer bg-[#0077FE] text-white shadow-xs';
            } else {
              navBtn.className = 'w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100';
            }
          }
        });

        // Cerrar sidebar en móvil si estaba abierto
        const sidebar = document.getElementById('app-sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (sidebar && window.innerWidth < 1024) {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('hidden');
        }
      }

      function toggleSidebar() {
        const sidebar = document.getElementById('app-sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        const isOpen = !sidebar.classList.contains('-translate-x-full');
        if (isOpen) {
          sidebar.classList.add('-translate-x-full');
          backdrop.classList.add('hidden');
        } else {
          sidebar.classList.remove('-translate-x-full');
          backdrop.classList.remove('hidden');
        }
      }

      // 2. Control de Planes (Freemium, SMART, PRO, ELITE)
      const planConfigs = {
        freemium: {
          badgeText: '⚪ Freemium',
          badgeClass: 'px-3 py-0.5 rounded-full text-xs font-black bg-slate-100 text-slate-700 border border-slate-300',
          title: 'Plan Freemium Gratuito',
          desc: 'Acceso básico a diagnósticos iniciales y foros.',
          pillClass: 'text-[8px] bg-slate-200 text-slate-700 px-2 py-0.5 rounded-full font-black'
        },
        smart: {
          badgeText: '⭐ Plan SMART',
          badgeClass: 'px-3 py-0.5 rounded-full text-xs font-black bg-rose-50 text-rose-700 border border-rose-200',
          title: 'Plan SMART Activo',
          desc: 'Marketplace de apuntes y solucionarios ilimitados.',
          pillClass: 'text-[8px] bg-rose-500/20 text-rose-700 border border-rose-300 px-2 py-0.5 rounded-full font-black'
        },
        pro: {
          badgeText: '👑 Plan PRO (Prueba Activa)',
          badgeClass: 'px-3 py-0.5 rounded-full text-xs font-black bg-emerald-50 text-emerald-700 border border-emerald-200',
          title: 'Plan PRO Universitario',
          desc: 'Hábitos con IA y detección de vacíos activa.',
          pillClass: 'text-[8px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full font-black'
        },
        elite: {
          badgeText: '💎 Plan ELITE VIP',
          badgeClass: 'px-3 py-0.5 rounded-full text-xs font-black bg-purple-50 text-purple-700 border border-purple-200',
          title: 'Plan ELITE Tercio Superior',
          desc: 'IA predictiva, tutor 1-on-1 y ranking VIP.',
          pillClass: 'text-[8px] bg-purple-500/20 text-purple-300 border border-purple-500/30 px-2 py-0.5 rounded-full font-black'
        }
      };

      function setAppPlan(plan) {
        if (!planConfigs[plan]) plan = 'pro';
        localStorage.setItem('mindfix_active_plan', plan);

        const config = planConfigs[plan];

        // Actualizar badges
        const headerBadge = document.getElementById('header-plan-badge');
        const dashBadge = document.getElementById('dash-active-plan-badge');
        const sidebarTitle = document.getElementById('sidebar-plan-title');
        const sidebarDesc = document.getElementById('sidebar-plan-desc');
        const sidebarPill = document.getElementById('sidebar-plan-pill');

        if (headerBadge) headerBadge.textContent = config.badgeText;
        if (dashBadge) {
          dashBadge.textContent = config.badgeText;
          dashBadge.className = config.badgeClass;
        }
        if (sidebarTitle) sidebarTitle.textContent = config.title;
        if (sidebarDesc) sidebarDesc.textContent = config.desc;
        if (sidebarPill) {
          sidebarPill.textContent = plan.toUpperCase();
          sidebarPill.className = config.pillClass;
        }

        // Resaltar botón en topbar
        ['freemium', 'smart', 'pro', 'elite'].forEach((p) => {
          const btn = document.getElementById(`top-plan-${p}`);
          if (btn) {
            if (p === plan) {
              const colors = {
                freemium: 'bg-slate-700 text-white shadow-xs',
                smart: 'bg-rose-500 text-white shadow-xs',
                pro: 'bg-emerald-600 text-white shadow-xs',
                elite: 'bg-purple-700 text-white shadow-xs'
              };
              btn.className = `px-3 py-1.5 rounded-xl text-xs font-black transition-all cursor-pointer ${colors[p]}`;
            } else {
              btn.className = 'px-3 py-1.5 rounded-xl text-xs font-black transition-all cursor-pointer text-slate-600 hover:text-slate-900';
            }
          }
        });
      }

      // 3. Función CERRAR SESIÓN (Regresa a la Landing Page)
      function handleLogout() {
        if (confirm('¿Deseas cerrar tu sesión en MindFix y volver a la página principal?')) {
          localStorage.removeItem('mindfix_session');
          // Redirección inmediata a la landing principal
          window.location.href = '/';
        }
      }

      // Inicialización de la sesión
      try {
        const stored = JSON.parse(localStorage.getItem('mindfix_user') || '{}');
        if (stored.name) {
          const names = document.querySelectorAll('#header-user-name, #dash-user-name');
          names.forEach(el => el.textContent = stored.name);
          const profInput = document.getElementById('profile-input-name');
          if (profInput) profInput.value = stored.name;
        }
      } catch (e) {}

      // Leer parámetro URL o localStorage para plan inicial
      const urlParams = new URLSearchParams(window.location.search);
      const urlPlan = urlParams.get('plan') || localStorage.getItem('mindfix_active_plan') || 'pro';
      setAppPlan(urlPlan);

      // Si viene con parámetro view ej. ?view=download
      const urlView = urlParams.get('view');
      if (urlView && appViews.includes(urlView)) {
        switchAppView(urlView);
      }
    </script>
  </body>
</html>
