---
import '../styles/global.css';

const title = "MindFix Platform | Tu Espacio de Estudio Universitario";
const description = "Plataforma de estudio universitario de MindFix. Planificador de hábitos con neurociencia, diagnóstico forense de vacíos, tutorías entre pares e IA predictiva.";

const courses = [
  { id: "calc2", name: "Cálculo II", topic: "Integrales impropias y series", pct: 82, gap: "2 vacíos detectados", color: "from-[#0077FE] to-[#00C2FF]", professor: "Prof. Ramírez" },
  { id: "estad", name: "Estadística Aplicada", topic: "Pruebas de hipótesis y p-valor", pct: 64, gap: "3 vacíos detectados", color: "from-[#6D4AFF] to-[#A78BFA]", professor: "Dra. Morales" },
  { id: "micro", name: "Microeconomía I", topic: "Equilibrio del consumidor", pct: 91, gap: "Listo para el parcial", color: "from-emerald-500 to-teal-400", professor: "Lic. Vega" },
  { id: "fisica", name: "Física General", topic: "Dinámica rotacional", pct: 55, gap: "4 vacíos detectados", color: "from-amber-500 to-orange-400", professor: "Ing. Herrera" },
];
---

<!doctype html>
<html lang="es" class="h-full bg-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>

  <body class="h-full bg-[#F8FAFC] text-[#0B2545] font-sans antialiased flex flex-col overflow-hidden selection:bg-[#0077FE] selection:text-white">
    
    <!-- ========================================================================= -->
    <!-- 1. APP TOPBAR (100% PLATAFORMA - NADA DE LA LANDING)                       -->
    <!-- ========================================================================= -->
    <header class="h-16 bg-white border-b border-slate-200/90 px-4 sm:px-6 flex items-center justify-between gap-3 shrink-0 z-30 shadow-xs">
      <!-- Izquierda: Brand & Botón Menú Móvil -->
      <div class="flex items-center gap-3">
        <button
          type="button"
          onclick="toggleSidebar()"
          class="lg:hidden p-2 rounded-xl text-slate-600 hover:bg-slate-100 cursor-pointer"
          aria-label="Abrir menú"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <a href="/app" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-[#0077FE] to-[#6D4AFF] text-white flex items-center justify-center font-black text-xs shadow-sm">
            MF
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-base font-black tracking-tight text-[#0B2545]">MINDFIX</span>
              <span class="px-1.5 py-0.2 rounded-md bg-blue-50 text-[#0077FE] text-[9px] font-black uppercase tracking-wider">APP</span>
            </div>
            <span class="text-[10px] text-slate-400 font-semibold block -mt-0.5">Plataforma Universitaria</span>
          </div>
        </a>
      </div>

      <!-- Centro: Selector Dinámico de Planes (Freemium, SMART, PRO, ELITE) -->
      <div class="hidden md:flex items-center gap-2 bg-slate-100 p-1 rounded-2xl border border-slate-200/80">
        <span class="text-[10px] font-extrabold uppercase text-slate-400 px-2">Modo Plan:</span>
        <button
          type="button"
          id="top-plan-freemium"
          onclick="setAppPlan('freemium')"
          class="px-3 py-1.5 rounded-xl text-xs font-black transition-all cursor-pointer text-slate-600 hover:text-slate-900"
        >
          ⚪ Freemium
        </button>
        <button
          type="button"
          id="top-plan-smart"
          onclick="setAppPlan('smart')"
          class="px-3 py-1.5 rounded-xl text-xs font-black transition-all cursor-pointer text-slate-600 hover:text-rose-600"
        >
          ⭐ SMART
        </button>
        <button
          type="button"
          id="top-plan-pro"
          onclick="setAppPlan('pro')"
          class="px-3 py-1.5 rounded-xl text-xs font-black transition-all cursor-pointer bg-emerald-600 text-white shadow-xs"
        >
          👑 PRO
        </button>
        <button
          type="button"
          id="top-plan-elite"
          onclick="setAppPlan('elite')"
          class="px-3 py-1.5 rounded-xl text-xs font-black transition-all cursor-pointer text-slate-600 hover:text-purple-600"
        >
          💎 ELITE
        </button>
      </div>

      <!-- Derecha: Descargar App, Notificaciones, Usuario & CERRAR SESIÓN -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <!-- Botón Descargar App Móvil -->
        <button
          type="button"
          onclick="switchAppView('download')"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-pink-50 hover:bg-pink-100 text-rose-600 border border-pink-200 text-xs font-black transition-all cursor-pointer shadow-xs"
        >
          <span>📲</span>
          <span>App Móvil</span>
        </button>

        <!-- Redes Sociales Conectadas -->
        <button
          type="button"
          onclick="switchAppView('social')"
          class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200/80 text-slate-700 text-xs font-bold transition-all cursor-pointer"
          title="Redes Sociales e Integraciones"
        >
          <span>🌐</span>
          <span class="text-[11px] font-extrabold">Redes</span>
        </button>

        <!-- Perfil Usuario -->
        <div class="flex items-center gap-2 pl-2 border-l border-slate-200">
          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#0077FE] to-teal-400 text-white flex items-center justify-center font-black text-xs shadow-xs shrink-0">
            VR
          </div>
          <div class="hidden xl:block text-left text-xs leading-tight">
            <span class="font-black text-[#0B2545] block" id="header-user-name">Valeria Rojas</span>
            <span class="text-[10px] text-emerald-600 font-extrabold" id="header-plan-badge">👑 Plan PRO</span>
          </div>
        </div>

        <!-- BOTÓN CERRAR SESIÓN (REGRESA A LA LANDING) -->
        <button
          type="button"
          onclick="handleLogout()"
          class="inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-extrabold transition-all cursor-pointer shadow-xs"
          title="Cerrar sesión y volver a la página principal"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="hidden sm:inline">Cerrar Sesión</span>
        </button>
      </div>
    </header>

    <!-- ========================================================================= -->
    <!-- 2. BODY LAYOUT (SIDEBAR LATERAL + CONTENIDO PRINCIPAL)                    -->
    <!-- ========================================================================= -->
    <div class="flex-1 flex overflow-hidden relative">
      
      <!-- BACKDROP PARA MÓVIL CUANDO SIDEBAR ESTÁ ABIERTO -->
      <div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-30 hidden lg:hidden"></div>

      <!-- ==================== SIDEBAR DE NAVEGACIÓN DE LA APP ==================== -->
      <aside id="app-sidebar" class="w-64 bg-white border-r border-slate-200/90 flex flex-col justify-between shrink-0 fixed lg:static inset-y-0 left-0 z-40 transform -translate-x-full lg:translate-x-0 transition-transform duration-300">
        
        <!-- Lista de Vistas / Secciones de la App -->
        <div class="p-4 space-y-6 overflow-y-auto">
          
          <!-- Banner de Plan Actual en Sidebar -->
          <div class="p-3.5 rounded-2xl bg-gradient-to-br from-slate-900 to-[#0B2545] text-white shadow-xs">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[9px] uppercase font-black tracking-wider text-[#00C2FF]">Membresía</span>
              <span id="sidebar-plan-pill" class="text-[8px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full font-black">
                PRO Activo
              </span>
            </div>
            <div class="text-xs font-black" id="sidebar-plan-title">Plan PRO Universitario</div>
            <p class="text-[10px] text-slate-300 mt-0.5 leading-snug" id="sidebar-plan-desc">
              Hábitos con IA y detección de vacíos activa.
            </p>
          </div>

          <!-- Selector de Planes Móvil (Solo visible en pantallas pequeñas) -->
          <div class="md:hidden space-y-1.5">
            <span class="text-[10px] font-black uppercase text-slate-400 block px-2">Cambiar Plan:</span>
            <div class="grid grid-cols-2 gap-1.5">
              <button onclick="setAppPlan('freemium')" class="p-1.5 rounded-lg text-[11px] font-bold bg-slate-100 text-slate-700">⚪ Free</button>
              <button onclick="setAppPlan('smart')" class="p-1.5 rounded-lg text-[11px] font-bold bg-rose-50 text-rose-700">⭐ Smart</button>
              <button onclick="setAppPlan('pro')" class="p-1.5 rounded-lg text-[11px] font-bold bg-emerald-50 text-emerald-700 font-black">👑 Pro</button>
              <button onclick="setAppPlan('elite')" class="p-1.5 rounded-lg text-[11px] font-bold bg-purple-50 text-purple-700">💎 Elite</button>
            </div>
          </div>

          <!-- Navegación Principal -->
          <div class="space-y-1">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 block px-3 mb-2">
              Navegación de la App
            </span>

            <!-- Tab 1: Dashboard -->
            <button
              type="button"
              id="nav-btn-dashboard"
              onclick="switchAppView('dashboard')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-black text-xs transition-all cursor-pointer bg-[#0077FE] text-white shadow-xs"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">🏠</span>
                <span>Inicio / Dashboard</span>
              </div>
              <span class="text-[10px] bg-white/20 px-1.5 py-0.5 rounded">Hoy</span>
            </button>

            <!-- Tab 2: Planificador de Hábitos -->
            <button
              type="button"
              id="nav-btn-planner"
              onclick="switchAppView('planner')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">📅</span>
                <span>Planificador Hábitos</span>
              </div>
              <span class="text-[9px] text-emerald-600 font-extrabold bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">PRO</span>
            </button>

            <!-- Tab 3: Marketplace MindPartners -->
            <button
              type="button"
              id="nav-btn-marketplace"
              onclick="switchAppView('marketplace')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">🛒</span>
                <span>Marketplace Apuntes</span>
              </div>
              <span class="text-[9px] text-rose-600 font-extrabold bg-rose-50 px-1.5 py-0.5 rounded border border-rose-200">SMART</span>
            </button>

            <!-- Tab 4: IA Predictiva & Tutor 1-on-1 -->
            <button
              type="button"
              id="nav-btn-elite"
              onclick="switchAppView('elite')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">🔮</span>
                <span>IA Predictiva & Tutor VIP</span>
              </div>
              <span class="text-[9px] text-purple-600 font-extrabold bg-purple-50 px-1.5 py-0.5 rounded border border-purple-200">ELITE</span>
            </button>

            <!-- Tab 5: Descargar App Móvil -->
            <button
              type="button"
              id="nav-btn-download"
              onclick="switchAppView('download')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">📲</span>
                <span>Descargar App Móvil</span>
              </div>
              <span class="text-[9px] text-pink-600 font-black bg-pink-50 px-1.5 py-0.5 rounded">iOS/Android</span>
            </button>

            <!-- Tab 6: Redes Sociales & Integraciones -->
            <button
              type="button"
              id="nav-btn-social"
              onclick="switchAppView('social')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">🌐</span>
                <span>Redes & Conexiones</span>
              </div>
              <span class="text-[9px] text-blue-600 font-bold bg-blue-50 px-1.5 py-0.5 rounded">Sync</span>
            </button>

            <!-- Tab 7: Perfil Académico -->
            <button
              type="button"
              id="nav-btn-profile"
              onclick="switchAppView('profile')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">👤</span>
                <span>Mi Perfil de Carrera</span>
              </div>
              <span class="text-[9px] text-slate-400 font-bold">5to ciclo</span>
            </button>
          </div>
        </div>

        <!-- Footer Sidebar: Fixi IA Mini Helper + Botón Cerrar Sesión -->
        <div class="p-4 border-t border-slate-200/90 space-y-3">
          <div class="p-3 rounded-2xl bg-emerald-50/70 border border-emerald-200/80 flex items-center gap-2.5">
            <span class="text-xl">🤖</span>
            <div class="text-[11px] leading-tight">
              <div class="font-black text-[#0B2545]">Fixi IA Copiloto</div>
              <div class="text-emerald-700 font-semibold">Listo para resolver dudas</div>
            </div>
          </div>

          <button
            type="button"
            onclick="handleLogout()"
            class="w-full py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-rose-50 hover:text-rose-600 text-slate-600 text-xs font-bold transition-colors flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>🚪</span>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </aside>

      <!-- ========================================================================= -->
      <!-- 3. VIEWPORT DE CONTENIDO (PANTALLAS INTERACTIVAS DE LA APP)               -->
      <!-- ========================================================================= -->
      <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 space-y-6">
        
        <!-- ==================== VISTA 1: DASHBOARD / INICIO ==================== -->
        <div id="view-dashboard" class="space-y-6">
          
          <!-- Banner de Bienvenida y Estado del Plan -->
          <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-xs flex flex-col lg:flex-row lg:items-center justify-between gap-5">
            <div>
              <div class="flex items-center gap-2 mb-1.5">
                <span class="px-3 py-0.5 rounded-full text-xs font-black bg-blue-50 text-[#0077FE]">
                  Panel de Estudio Activo
                </span>
                <span id="dash-active-plan-badge" class="px-3 py-0.5 rounded-full text-xs font-black bg-emerald-50 text-emerald-700 border border-emerald-200">
                  👑 Plan PRO
                </span>
              </div>
              <h1 class="text-2xl sm:text-3xl font-black text-[#0B2545] tracking-tight">
                ¡Hola de nuevo, <span id="dash-user-name">Valeria</span>!
              </h1>
              <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-xl">
                Hoy tienes <strong>2 bloques de Active Recall (50 min)</strong> programados y 0 amanecidas registradas esta semana.
              </p>
            </div>

            <!-- Accesos rápidos -->
            <div class="flex flex-wrap items-center gap-2.5 shrink-0">
              <button
                type="button"
                onclick="switchAppView('planner')"
                class="px-4 py-2.5 rounded-xl bg-[#0077FE] hover:bg-blue-600 text-white font-extrabold text-xs shadow-xs transition-all"
              >
                📅 Ver Plan de Hoy
              </button>
              <button
                type="button"
                onclick="switchAppView('download')"
                class="px-4 py-2.5 rounded-xl bg-pink-50 hover:bg-pink-100 text-rose-600 border border-pink-200 font-extrabold text-xs transition-all"
              >
                📲 Abrir en Celular
              </button>
            </div>
          </div>

          <!-- KPIs de Rendimiento -->
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Eficiencia Cognitiva</span>
              <div class="flex items-baseline gap-2 mt-2">
                <span class="text-2xl sm:text-3xl font-black text-[#0B2545]">78%</span>
                <span class="text-xs font-extrabold text-emerald-600">+14% sem.</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1">Rumbo al Tercio Superior</p>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Cursos Activos</span>
              <div class="flex items-baseline gap-2 mt-2">
                <span class="text-2xl sm:text-3xl font-black text-[#0077FE]">4</span>
                <span class="text-xs font-bold text-slate-500">materias</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1">9 micro-vacíos por cerrar</p>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Sueño Protegido</span>
              <div class="flex items-baseline gap-2 mt-2">
                <span class="text-2xl sm:text-3xl font-black text-[#6D4AFF]">7.5h</span>
                <span class="text-xs font-bold text-emerald-600">0 trasnoches</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1">Consolidación REM óptima</p>
            </div>

            <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-xs">
              <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Racha Pomodoro</span>
              <div class="flex items-baseline gap-2 mt-2">
                <span class="text-2xl sm:text-3xl font-black text-amber-500">6 días</span>
                <span class="text-sm">🔥</span>
              </div>
              <p class="text-[11px] text-slate-500 mt-1">100 min focalizados / día</p>
            </div>
          </div>

          <!-- Dos Columnas: Cursos Activos + Checklist de Hoy -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <!-- Columna Izquierda: Cursos & Dominio -->
            <div class="lg:col-span-7 space-y-6">
              <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs">
                <div class="flex items-center justify-between mb-4">
                  <div>
                    <h3 class="text-base font-black text-[#0B2545]">Dominio de Cursos del Ciclo</h3>
                    <p class="text-xs text-slate-500">Monitoreo continuo de avance ponderado.</p>
                  </div>
                  <button type="button" onclick="switchAppView('marketplace')" class="text-xs font-extrabold text-[#0077FE] hover:underline">
                    Ver Solucionarios →
                  </button>
                </div>

                <div class="space-y-4">
                  {courses.map((c) => (
                    <div class="p-3.5 rounded-2xl bg-slate-50/70 border border-slate-100">
                      <div class="flex items-center justify-between text-xs mb-1.5">
                        <div>
                          <span class="font-extrabold text-[#0B2545]">{c.name}</span>
                          <span class="text-slate-400 ml-1.5 font-normal">({c.professor})</span>
                        </div>
                        <span class="font-black text-[#0B2545]">{c.pct}%</span>
                      </div>
                      <div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden mb-1.5">
                        <div class={`h-full bg-gradient-to-r ${c.color} rounded-full`} style={`width: ${c.pct}%`}></div>
                      </div>
                      <div class="flex items-center justify-between text-[11px] text-slate-500">
                        <span>{c.topic}</span>
                        <span class="font-bold text-amber-600">{c.gap}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            <!-- Columna Derecha: Checklist de Hoy + Acceso Rápido Móvil -->
            <div class="lg:col-span-5 space-y-6">
              <!-- Checklist de Hábitos -->
              <div class="bg-white rounded-3xl p-6 border border-slate-200/80 shadow-xs">
                <div class="flex items-center justify-between mb-3">
                  <h3 class="text-base font-black text-[#0B2545]">Plan de Hoy (Jueves 13)</h3>
                  <span class="text-[10px] bg-emerald-50 text-emerald-700 font-extrabold px-2 py-0.5 rounded-full">3 de 4</span>
                </div>
                <div class="space-y-2.5 text-xs text-slate-700">
                  <label class="flex items-start gap-2.5 p-2 rounded-xl bg-slate-50 cursor-pointer">
                    <input type="checkbox" checked class="accent-[#0077FE] mt-0.5 w-4 h-4 rounded" />
                    <span class="font-medium">Active Recall: 50m Cálculo (Series) <strong class="text-emerald-600 block text-[10px]">✔ Hecho</strong></span>
                  </label>
                  <label class="flex items-start gap-2.5 p-2 rounded-xl bg-slate-50 cursor-pointer">
                    <input type="checkbox" checked class="accent-[#0077FE] mt-0.5 w-4 h-4 rounded" />
                    <span class="font-medium">Pausa activa: 15m caminata e hidratación <strong class="text-emerald-600 block text-[10px]">✔ Hecho</strong></span>
                  </label>
