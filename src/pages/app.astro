---
import '../styles/global.css';

const title = "MindFix App | Plataforma Universitaria";
const description = "Plataforma de estudio para estudiantes universitarios con Fixi IA, hábitos de Active Recall, marketplace de apuntes y tutorías P2P.";
---

<!doctype html>
<html lang="es" class="h-full bg-slate-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  </head>

  <body class="h-full flex flex-col font-sans antialiased text-[#0B2545] bg-[#F8FAFC] selection:bg-[#0077FE] selection:text-white">
    
    <!-- ========================================================================= -->
    <!-- 1. APP TOPBAR (100% PLATAFORMA - CERO LANDING)                             -->
    <!-- ========================================================================= -->
    <header class="h-16 bg-white border-b border-slate-200/90 px-3 sm:px-6 flex items-center justify-between gap-3 shrink-0 z-30 shadow-xs">
      
      <!-- Izquierda: Brand & Botón Menú Móvil (Drawer) -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <button
          type="button"
          onclick="toggleSidebar()"
          class="lg:hidden p-2 rounded-xl text-slate-600 hover:bg-slate-100 cursor-pointer active:scale-95 transition-transform"
          aria-label="Abrir menú de navegación"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <a href="/app" class="flex items-center gap-2 group">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-[#0077FE] to-[#6D4AFF] text-white flex items-center justify-center font-black text-xs shadow-sm">
            MF
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-base font-black tracking-tight text-[#0B2545]">MINDFIX</span>
              <span class="px-1.5 py-0.2 rounded-md bg-blue-50 text-[#0077FE] text-[9px] font-black uppercase tracking-wider">APP</span>
            </div>
            <span class="text-[10px] text-slate-400 font-semibold block -mt-0.5">Plataforma Universitaria</span>
          </div>
        </a>
      </div>

      <!-- Centro: Selector Dinámico de Planes Desktop (Freemium, SMART, PRO, ELITE) -->
      <div class="hidden md:flex items-center gap-1.5 bg-slate-100 p-1 rounded-2xl border border-slate-200/80">
        <span class="text-[10px] font-extrabold uppercase text-slate-400 px-2">Modo Plan:</span>
        <button
          type="button"
          id="top-plan-freemium"
          onclick="setAppPlan('freemium')"
          class="px-2.5 py-1.5 rounded-xl text-xs font-black transition-all cursor-pointer text-slate-600 hover:text-slate-900"
        >
          ⚪ Freemium
        </button>
        <button
          type="button"
          id="top-plan-smart"
          onclick="setAppPlan('smart')"
          class="px-2.5 py-1.5 rounded-xl text-xs font-black transition-all cursor-pointer text-slate-600 hover:text-rose-600"
        >
          ⭐ SMART
        </button>
        <button
          type="button"
          id="top-plan-pro"
          onclick="setAppPlan('pro')"
          class="px-2.5 py-1.5 rounded-xl text-xs font-black transition-all cursor-pointer bg-emerald-600 text-white shadow-xs"
        >
          👑 PRO
        </button>
        <button
          type="button"
          id="top-plan-elite"
          onclick="setAppPlan('elite')"
          class="px-2.5 py-1.5 rounded-xl text-xs font-black transition-all cursor-pointer text-slate-600 hover:text-purple-600"
        >
          💎 ELITE
        </button>
      </div>

      <!-- Derecha: App Móvil, Perfil Usuario & CERRAR SESIÓN -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Botón Ver Pantalla Descargar App Móvil -->
        <button
          type="button"
          onclick="switchAppView('download')"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-pink-50 hover:bg-pink-100 text-rose-600 border border-pink-200 text-xs font-black transition-all cursor-pointer shadow-xs"
        >
          <span>📲</span>
          <span>App Móvil</span>
        </button>

        <!-- Redes Sociales Conectadas -->
        <button
          type="button"
          onclick="switchAppView('social')"
          class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200/80 text-slate-700 text-xs font-bold transition-all cursor-pointer"
          title="Redes Sociales e Integraciones"
        >
          <span>🌐</span>
          <span class="text-[11px] font-extrabold">Redes</span>
        </button>

        <!-- Perfil Usuario -->
        <div class="flex items-center gap-2 pl-1 sm:pl-2 border-l border-slate-200">
          <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-[#0077FE] to-teal-400 text-white flex items-center justify-center font-black text-xs shadow-xs shrink-0">
            VR
          </div>
          <div class="hidden xl:block text-left text-xs leading-tight">
            <span class="font-black text-[#0B2545] block" id="header-user-name">Valeria Rojas</span>
            <span class="text-[10px] text-emerald-600 font-extrabold" id="header-plan-badge">👑 Plan PRO</span>
          </div>
        </div>

        <!-- BOTÓN CERRAR SESIÓN (LIMPIA SESIÓN Y REGRESA A LA LANDING) -->
        <button
          type="button"
          onclick="handleLogout()"
          class="inline-flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-extrabold transition-all cursor-pointer shadow-xs active:scale-95"
          title="Cerrar sesión y volver a la página principal"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
          <span class="hidden sm:inline">Cerrar Sesión</span>
        </button>
      </div>
    </header>

    <!-- ==================== SUB-BARRA MÓVIL: SELECTOR RÁPIDO DE PLANES ==================== -->
    <div class="md:hidden bg-white border-b border-slate-200/90 px-3 py-1.5 flex items-center justify-between gap-1.5 overflow-x-auto scrollbar-none z-20 shrink-0">
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="text-[9px] font-black uppercase text-slate-400">Plan:</span>
        <span id="mobile-current-plan-pill" class="text-[9px] font-black px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700">
          👑 Plan PRO
        </span>
      </div>
      <div class="flex items-center gap-1 shrink-0">
        <button
          type="button"
          onclick="setAppPlan('freemium')"
          id="mob-plan-freemium"
          class="px-2 py-1 rounded-lg text-[10px] font-bold text-slate-600 bg-slate-100 cursor-pointer"
        >
          ⚪ Free
        </button>
        <button
          type="button"
          onclick="setAppPlan('smart')"
          id="mob-plan-smart"
          class="px-2 py-1 rounded-lg text-[10px] font-bold text-slate-600 bg-slate-100 cursor-pointer"
        >
          ⭐ Smart
        </button>
        <button
          type="button"
          onclick="setAppPlan('pro')"
          id="mob-plan-pro"
          class="px-2 py-1 rounded-lg text-[10px] font-black text-white bg-emerald-600 shadow-xs cursor-pointer"
        >
          👑 Pro
        </button>
        <button
          type="button"
          onclick="setAppPlan('elite')"
          id="mob-plan-elite"
          class="px-2 py-1 rounded-lg text-[10px] font-bold text-slate-600 bg-slate-100 cursor-pointer"
        >
          💎 Elite
        </button>
      </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 2. BODY LAYOUT (SIDEBAR LATERAL + CONTENIDO PRINCIPAL)                    -->
    <!-- ========================================================================= -->
    <div class="flex-1 flex overflow-hidden relative">
      
      <!-- BACKDROP PARA MÓVIL CUANDO SIDEBAR ESTÁ ABIERTO -->
      <div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-30 hidden lg:hidden"></div>

      <!-- ==================== SIDEBAR DE NAVEGACIÓN DE LA APP ==================== -->
      <aside id="app-sidebar" class="w-64 bg-white border-r border-slate-200/90 flex flex-col justify-between shrink-0 fixed lg:static inset-y-0 left-0 z-40 transform -translate-x-full lg:translate-x-0 transition-transform duration-300">
        
        <!-- Lista de Vistas / Secciones de la App -->
        <div class="p-4 space-y-5 overflow-y-auto">
          
          <!-- Banner de Plan Actual en Sidebar -->
          <div class="p-3.5 rounded-2xl bg-gradient-to-br from-slate-900 to-[#0B2545] text-white shadow-xs">
            <div class="flex items-center justify-between mb-1">
              <span class="text-[9px] uppercase font-black tracking-wider text-[#00C2FF]">Membresía</span>
              <span id="sidebar-plan-pill" class="text-[8px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full font-black">
                PRO Activo
              </span>
            </div>
            <div class="text-xs font-black" id="sidebar-plan-title">Plan PRO Universitario</div>
            <p class="text-[10px] text-slate-300 mt-0.5 leading-snug" id="sidebar-plan-desc">
              Hábitos con IA y detección de vacíos activa.
            </p>
            <a href="/planes" class="mt-2.5 inline-flex items-center gap-1 text-[10px] text-[#00C2FF] font-black hover:underline">
              <span>Gestionar o Mejorar Plan</span>
              <span>→</span>
            </a>
          </div>

          <!-- Navegación Principal -->
          <div class="space-y-1">
            <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 block px-3 mb-2">
              Navegación de la App
            </span>

            <!-- Tab 1: Dashboard -->
            <button
              type="button"
              id="nav-btn-dashboard"
              onclick="switchAppView('dashboard')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-black text-xs transition-all cursor-pointer bg-[#0077FE] text-white shadow-xs"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">🏠</span>
                <span>Inicio / Dashboard</span>
              </div>
              <span class="text-[10px] bg-white/20 px-1.5 py-0.5 rounded">Hoy</span>
            </button>

            <!-- Tab 2: Planificador de Hábitos -->
            <button
              type="button"
              id="nav-btn-planner"
              onclick="switchAppView('planner')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">📅</span>
                <span>Planificador Hábitos</span>
              </div>
              <span id="badge-nav-planner" class="text-[9px] text-emerald-600 font-extrabold bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200">PRO</span>
            </button>

            <!-- Tab 3: Buscador de Apuntes (Marketplace) -->
            <button
              type="button"
              id="nav-btn-marketplace"
              onclick="switchAppView('marketplace')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">🔍</span>
                <span>Buscador Apuntes</span>
              </div>
              <span id="badge-nav-marketplace" class="text-[9px] text-rose-600 font-extrabold bg-rose-50 px-1.5 py-0.5 rounded border border-rose-200">SMART</span>
            </button>

            <!-- Tab 4: IA Predictiva & Tutor 1-on-1 -->
            <button
              type="button"
              id="nav-btn-elite"
              onclick="switchAppView('elite')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">🔮</span>
                <span>IA Predictiva & Tutor VIP</span>
              </div>
              <span id="badge-nav-elite" class="text-[9px] text-purple-600 font-extrabold bg-purple-50 px-1.5 py-0.5 rounded border border-purple-200">ELITE</span>
            </button>

            <!-- Tab 5: Descargar App Móvil -->
            <button
              type="button"
              id="nav-btn-download"
              onclick="switchAppView('download')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">📲</span>
                <span>Descargar App Móvil</span>
              </div>
              <span class="text-[9px] text-pink-600 font-black bg-pink-50 px-1.5 py-0.5 rounded">iOS/Android</span>
            </button>

            <!-- Tab 6: Redes Sociales & Integraciones -->
            <button
              type="button"
              id="nav-btn-social"
              onclick="switchAppView('social')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">🌐</span>
                <span>Redes & Conexiones</span>
              </div>
              <span class="text-[9px] text-blue-600 font-bold bg-blue-50 px-1.5 py-0.5 rounded">Sync</span>
            </button>

            <!-- Tab 7: Perfil Académico -->
            <button
              type="button"
              id="nav-btn-profile"
              onclick="switchAppView('profile')"
              class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl font-bold text-xs transition-all cursor-pointer text-slate-600 hover:text-[#0B2545] hover:bg-slate-100"
            >
              <div class="flex items-center gap-2.5">
                <span class="text-sm">👤</span>
                <span>Mi Perfil de Carrera</span>
              </div>
              <span class="text-[9px] text-slate-400 font-bold">5to ciclo</span>
            </button>
          </div>

        </div>

        <!-- Footer Sidebar: Fixi IA Mini Helper + Botón Cerrar Sesión -->
        <div class="p-4 border-t border-slate-200/90 space-y-3">
          <div class="p-3 rounded-2xl bg-emerald-50/70 border border-emerald-200/80 flex items-center gap-2.5">
            <span class="text-xl">🤖</span>
            <div class="text-[11px] leading-tight">
              <div class="font-black text-[#0B2545]">Fixi IA Copiloto</div>
              <div class="text-emerald-700 font-semibold">Listo para resolver dudas</div>
            </div>
          </div>

          <button
            type="button"
            onclick="handleLogout()"
            class="w-full py-2.5 px-3 rounded-xl bg-slate-100 hover:bg-rose-50 hover:text-rose-600 text-slate-600 text-xs font-bold transition-colors flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>🚪</span>
            <span>Cerrar Sesión</span>
          </button>
        </div>
      </aside>

      <!-- ========================================================================= -->
      <!-- 3. VIEWPORT DE CONTENIDO (PANTALLAS INTERACTIVAS DE LA APP)               -->
      <!-- ========================================================================= -->
      <main class="flex-1 overflow-y-auto p-3 sm:p-6 lg:p-8 space-y-6 pb-28 lg:pb-8">
        
        <!-- ==================== VISTA 1: DASHBOARD / INICIO ==================== -->
        <!-- ==================== VISTA 1: DASHBOARD / INICIO ==================== -->
        <div id="view-dashboard" class="space-y-6">
          
          <!-- SELECTOR INTERACTIVO DE INTERFAZ POR PLAN (PERMITE VISUALIZAR CÓMO CAMBIA LA APP) -->
          <div class="bg-white p-3 rounded-3xl border border-slate-200/90 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center gap-2">
              <span class="text-xl">🎛️</span>
              <div>
                <span class="text-xs font-black text-[#0B2545]">Interfaz Dinámica por Membresía:</span>
                <span class="text-[11px] text-slate-500 block">Explora cómo se enriquece y transforma la app en cada plan</span>
              </div>
            </div>

            <div class="bg-slate-100 p-1.5 rounded-2xl border border-slate-200 flex gap-1 overflow-x-auto scrollbar-none w-full sm:w-auto">
              <button
                type="button"
                onclick="setAppPlan('freemium')"
                id="dash-selector-freemium"
                class="flex-1 sm:flex-none py-1.5 px-3 rounded-xl text-xs font-bold text-slate-600 hover:bg-white transition-all text-center cursor-pointer whitespace-nowrap"
              >
                ⚪ Freemium (Básico)
              </button>
              <button
                type="button"
                onclick="setAppPlan('smart')"
                id="dash-selector-smart"
                class="flex-1 sm:flex-none py-1.5 px-3 rounded-xl text-xs font-bold text-slate-600 hover:bg-white transition-all text-center cursor-pointer whitespace-nowrap"
              >
                ⭐ Plan SMART
              </button>
              <button
                type="button"
                onclick="setAppPlan('pro')"
                id="dash-selector-pro"
                class="flex-1 sm:flex-none py-1.5 px-3 rounded-xl text-xs font-black bg-emerald-600 text-white shadow-xs transition-all text-center cursor-pointer whitespace-nowrap"
              >
                👑 Plan PRO (Más elegido)
              </button>
              <button
                type="button"
                onclick="setAppPlan('elite')"
                id="dash-selector-elite"
                class="flex-1 sm:flex-none py-1.5 px-3 rounded-xl text-xs font-bold text-slate-600 hover:bg-white transition-all text-center cursor-pointer whitespace-nowrap"
              >
                💎 Plan ELITE (Tercio Superior)
              </button>
            </div>
          </div>

          <!-- ========================================================================= -->
          <!-- 1. INTERFAZ FREEMIUM (BÁSICA, CON LÍMITES Y CANDADOS CLAROS)              -->
          <!-- ========================================================================= -->
          <div id="dash-interface-freemium" class="space-y-6 hidden">
            <!-- Banner Freemium -->
            <div class="bg-white rounded-3xl p-5 sm:p-7 border border-slate-200 shadow-xs flex flex-col lg:flex-row lg:items-center justify-between gap-5">
              <div>
                <div class="flex items-center gap-2 mb-1.5">
                  <span class="px-3 py-0.5 rounded-full text-xs font-black bg-slate-100 text-slate-700 border border-slate-300">
                    ⚪ Cuenta Freemium Gratuita
                  </span>
                  <a href="/planes" class="text-xs font-bold text-rose-600 hover:underline">
                    Ver Planes Disponibles →
                  </a>
                </div>
                <h1 class="text-xl sm:text-3xl font-black text-[#0B2545]">
                  ¡Hola, Valeria! <span class="text-sm font-semibold text-slate-400 font-sans">(Acceso Básico)</span>
                </h1>
                <p class="text-xs sm:text-sm text-slate-500 mt-1 max-w-xl">
                  Estás utilizando la versión de prueba gratuita con funciones limitadas. Puedes registrar tus materias y ver diagnósticos iniciales.
                </p>
              </div>

              <a
                href="/planes"
                class="px-5 py-3 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-black text-xs shadow-md transition-all self-start lg:self-auto hover:scale-105"
              >
                Desbloquear Plan PRO (S/ 9.90/mes) 🚀
              </a>
            </div>

            <!-- Métricas Limitadas Freemium -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
              <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
                <span class="text-[10px] font-bold text-slate-400 uppercase">Horas Registradas</span>
                <div class="text-xl font-black text-[#0B2545] mt-1">4.5 hrs</div>
                <div class="text-[10px] text-slate-400 mt-0.5">Seguimiento manual</div>
              </div>

              <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
                <span class="text-[10px] font-bold text-slate-400 uppercase">Diagnóstico IA</span>
                <div class="text-xl font-black text-amber-600 mt-1">1 de 1</div>
                <div class="text-[10px] text-amber-700 font-bold mt-0.5">Límite mensual alcanzado</div>
              </div>

              <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
                <span class="text-[10px] font-bold text-slate-400 uppercase">Cursos Activos</span>
                <div class="text-xl font-black text-[#0077FE] mt-1">2 de 5</div>
                <div class="text-[10px] text-slate-400 mt-0.5">Plan Free permite 2 cursos</div>
              </div>

              <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs">
                <span class="text-[10px] font-bold text-slate-400 uppercase">Tercio Superior</span>
                <div class="text-xl font-black text-slate-400 mt-1">Bloqueado 🔒</div>
                <div class="text-[10px] text-purple-700 font-bold mt-0.5">Requiere Plan ELITE</div>
              </div>
            </div>

            <!-- Cursos Básicos Freemium y Módulos Bloqueados -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
              <div class="lg:col-span-7 bg-white rounded-3xl p-5 sm:p-6 border border-slate-200 shadow-xs space-y-4">
                <div class="flex items-center justify-between">
                  <h3 class="text-base font-black text-[#0B2545]">Mis Cursos Registrados (2/5)</h3>
                  <span class="text-xs text-slate-400 font-bold">Modo Básico</span>
                </div>

                <div class="space-y-2.5 text-xs">
                  <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between">
                    <div>
                      <div class="font-black text-[#0B2545]">Finanzas Corporativas II</div>
                      <div class="text-[11px] text-slate-500">PUCP • 4 créditos</div>
                    </div>
                    <span class="text-[10px] text-emerald-600 font-bold">Activo</span>
                  </div>

                  <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between">
                    <div>
                      <div class="font-black text-[#0B2545]">Base de Datos Avanzada</div>
                      <div class="text-[11px] text-slate-500">PUCP • 4 créditos</div>
                    </div>
