    <!-- SCRIPT INTERACTIVO CLIENTE -->
    <script is:inline>
      // Alternar pantallas en el Mockup del Teléfono
      function switchPhoneScreen(screenId) {
        const screens = ['mock-screen-dashboard', 'mock-screen-fixi', 'mock-screen-offline', 'mock-screen-radar'];
        screens.forEach(s => {
          const el = document.getElementById(s);
          if (el) el.classList.add('hidden');
        });

        const activeScreen = document.getElementById(screenId);
        if (activeScreen) {
          activeScreen.classList.remove('hidden');
        }

        // Actualizar estilos de los botones
        const btns = [
          { id: 'btn-screen-dashboard', target: 'mock-screen-dashboard' },
          { id: 'btn-screen-fixi', target: 'mock-screen-fixi' },
          { id: 'btn-screen-offline', target: 'mock-screen-offline' },
          { id: 'btn-screen-radar', target: 'mock-screen-radar' },
        ];

        btns.forEach(b => {
          const btnEl = document.getElementById(b.id);
          if (btnEl) {
            if (b.target === screenId) {
              btnEl.className = 'px-2.5 py-1 rounded-xl text-[11px] font-black transition-all bg-white text-[#0077FE] shadow-xs cursor-pointer';
            } else {
              btnEl.className = 'px-2.5 py-1 rounded-xl text-[11px] font-bold text-slate-600 hover:text-[#0B2545] transition-all cursor-pointer';
            }
          }
        });
      }

      // Enviar enlace por celular
      function handleSendLink(e) {
        e.preventDefault();
        const input = document.getElementById('phone-link-input');
        const feedback = document.getElementById('send-link-feedback');
        if (input && feedback) {
          feedback.classList.remove('hidden');
          input.value = '';
          setTimeout(() => {
            feedback.classList.add('hidden');
          }, 4500);
        }
      }

      // Alerta amigable de descarga
      function triggerDownloadAlert(platform) {
        alert('🎉 ¡Descargando MindFix para ' + platform + '!\nVersión: 2.4.0 (28 MB)\n\nTambién puedes abrir la versión web en https://mkt-snowy.vercel.app/app');
      }

      // Selector de plataforma
      function setDownloadPlatform(plat) {
        const tabs = ['all', 'ios', 'android', 'apk'];
        tabs.forEach(t => {
          const tabEl = document.getElementById('tab-plat-' + t);
          if (tabEl) {
            if (t === plat) {
              tabEl.className = 'flex-1 min-w-[90px] py-2 px-3 rounded-xl text-xs font-black transition-all bg-[#0077FE] text-white shadow-xs cursor-pointer text-center';
            } else {
              tabEl.className = 'flex-1 min-w-[90px] py-2 px-3 rounded-xl text-xs font-bold text-slate-600 hover:text-[#0B2545] hover:bg-white transition-all cursor-pointer text-center';
            }
          }
        });
      }
    </script>
  </body>
</html>
